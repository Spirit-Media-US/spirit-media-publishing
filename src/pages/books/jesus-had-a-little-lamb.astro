---
// LAMB PILOT (Kevin L1971; plan 3fb option B): one SMP page per book. Status "pending": no Buy until the SMP store
// engine sells this book (Phase 4). Book page rule (Kevin 11-13): no "Buy on Amazon" button; Amazon is a record in
// JSON-LD sameAs only. Every fact comes from src/data/books/jesus-had-a-little-lamb.json (sourced, nothing invented).
import book from '../../data/books/jesus-had-a-little-lamb.json';
import Layout from '../../layouts/Layout.astro';

const SITE = 'https://spiritmediapublishing.com';
const url = `${SITE}/books/${book.slug}/`;
const img = (w: number) => `${book.cover.src}?w=${w}&fm=webp&q=80`;
const h600 = Math.round((600 * book.cover.height) / book.cover.width);
const title = `${book.title} by ${book.author}`;
const description = `${book.title}, a book by ${book.author}, published by ${book.publisher}.`;
const ld = {
	'@context': 'https://schema.org',
	'@type': 'Book',
	'@id': `${url}#book`,
	name: book.title,
	url,
	author: { '@type': 'Person', name: book.author },
	publisher: { '@type': 'Organization', '@id': `${SITE}/#organization`, name: book.publisher },
	inLanguage: book.language,
	image: img(600),
	bookFormat: book.formats.map((f) => f.schema_format),
	sameAs: book.same_as,
};
const crumbs = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
		{ '@type': 'ListItem', position: 2, name: 'Bookstore', item: `${SITE}/bookstore/` },
		{ '@type': 'ListItem', position: 3, name: book.title, item: url },
	],
};
---

<Layout title={title} description={description} ogImage={`${book.cover.src}?w=1200&h=630&fit=fill&bg=ffffff&fm=jpg&q=85`}>
	<Fragment slot="head">
		<link rel="preload" as="image" href={img(600)} imagesrcset={`${img(300)} 300w, ${img(600)} 600w`} imagesizes="(min-width: 768px) 300px, 80vw" fetchpriority="high" />
		<script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(crumbs)}></script>
	</Fragment>
	<main id="main-content">
		<section class="bg-stone-50 px-6 py-12 lg:py-16 lg:px-8">
			<div class="mx-auto max-w-5xl grid gap-10 md:grid-cols-[300px_1fr] items-start">
				<img
					src={img(600)}
					srcset={`${img(300)} 300w, ${img(600)} 600w`}
					sizes="(min-width: 768px) 300px, 80vw"
					width="600"
					height={h600}
					alt={book.cover.alt}
					fetchpriority="high"
					decoding="async"
					class="w-full max-w-[300px] mx-auto h-auto rounded shadow-lg"
				/>
				<div>
					<nav aria-label="Breadcrumb" class="text-sm text-stone-500 mb-4">
						<a href="/" class="hover:underline">Home</a> /
						<a href="/bookstore/" class="hover:underline">Bookstore</a> /
						<span aria-current="page">{book.title}</span>
					</nav>
					<h1 class="text-3xl lg:text-4xl font-bold text-stone-900">{book.title}</h1>
					<p class="mt-2 text-lg text-stone-700">by {book.author}</p>
					<dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-stone-700">
						<dt class="font-semibold">Publisher</dt><dd>{book.publisher}</dd>
						<dt class="font-semibold">Format</dt><dd>{book.formats.map((f) => f.format).join(', ')}</dd>
						<dt class="font-semibold">Language</dt><dd>English</dd>
					</dl>
					<p class="mt-8 rounded border border-stone-300 bg-white p-4 text-stone-800" data-status={book.status}>
						Available soon from our store.
					</p>
					<p class="mt-6"><a href="/bookstore/" class="text-red underline">Browse all our books</a></p>
				</div>
			</div>
		</section>
	</main>
</Layout>
