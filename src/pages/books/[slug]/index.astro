---
import BookMirror from '../../../components/BookMirror.astro';
// /books/<slug>/ — ONE page per SMP book, with its order form ON it (Kevin 2026-11-13 ~23:1xZ via pmseoaeo: "All I see
// is check out form? Where is the page?" -> the full book page with the ORDER FORM ON IT, like FHB grandparents and the
// new FHB Who Am I?; /books/<slug>/buy/ 301s to /books/<slug>/#order). Books M4 (Kevin approved SMP book pages 11-13).
//
// TWO SOURCES, ONE PAGE SHAPE:
//  · src/data/books/shipset-v2.json — pmseoaeo's ship set v2 (3fu, clean copy), ship_ready titles only, sales order,
//    verbatim apart from clean slugs ('-s-' -> 's-', pmseoaeo #5; old spellings 301 in public/_redirects). pmseoaeo
//    23:26Z #4 "B": US checkout at list price, free US shipping, on every page whose SKU has an ISBN + price (the rows
//    are in the store registry, FHB src/data/book-skus.json owner_site smp); non-US "Ships to more countries soon"
//    until costs are measured (plan D5); the sale records net_usd unmeasured.
//  · src/store-engine/data/books.json + book-skus.json — the books the store SELLS today (Who Am I?, Beloved Identity),
//    the same records the checkout prices. These carry the order form (#order). D1 open: their ranking page is
//    fathersheartbible.com/books/<slug>/, so canonical points there.
// Every word comes from that data. COPY GATE (pmseoaeo 23:19Z, Kevin: "Never render internal wording or TBD"): copy()
// strips only a bare ", per the Doc" tail; a FAQ entry that still talks about our sources is dropped; body copy that
// does FAILS THE BUILD by slug + field. The fix belongs in the data, never here.
// Also carried: no "Buy on Amazon" button (Amazon = sameAs only); no Offer while nothing sells; calm ink, no red
// (Kevin L1999); a 390px phone first. A hand-built page (src/pages/books/<slug>.astro) keeps its slug.
import dims from '../../../data/books/cover-dims.json';
import sized from '../../../data/books/cover-sized.json';
import lamb from '../../../data/books/jesus-had-a-little-lamb.json';
import set from '../../../data/books/shipset-v2.json';
import Layout from '../../../layouts/Layout.astro';
import bookSkus from '../../../store-engine/data/book-skus.json';
import engineBooks from '../../../store-engine/data/books.json';
import { BOOK_SKUS } from '../../../store-engine/lib/order-pricing.ts';
import { LIVE_COUNTRIES } from '../../../store-engine/lib/shipCountries.ts';

type Fmt = {
	sku: string;
	format: string;
	schema_format: string;
	isbn: string;
	isbn_display: string;
	list_cents: number | null;
	pages: number | null;
	trim: string | null;
};
type Page = {
	slug: string;
	title: string;
	h1: string;
	subtitle: string | null;
	author: string;
	credits: string | null;
	page_title: string;
	meta: string;
	short: string;
	about: string | null;
	aboutHtml: string | null;
	who_for: string[];
	faq: { q: string; a: string }[];
	faqDropped: number;
	bio: string | null;
	cover: { src: string; w: number; h: number; alt: string; w300?: string; og?: string };
	formats: Fmt[];
	lccn: string | null;
	sameAs: string[];
	publisher?: string | null;
	canonical: string | null;
	orderable: boolean;
	/** mirrored FHB-edition-page copy (Kevin 11-14 L2006), or null -> the compact layout */
	page: Record<string, any> | null;
};

export function getStaticPaths() {
	// ---- COPY GATE (inside getStaticPaths: Astro runs it in isolation) ----
	// Internal wording a reader must never see (pmseoaeo QA 3ft list + ours). Narrow on purpose: "through the pages",
	// "keywords for further research", "bring to the page", "first draft" are ordinary prose and pass.
	const INTERNAL =
		/\b(the Doc\b|Doc (says|lists|calls|describes|names|files|suggests|audience|has)|\(Doc\b|sheet\.json|the sheet\b|the page (makes|attributes|does|publishes|names|claims)|makes no claim|the interior (has|mentions|names|is)|\d+ mentions\b|mentions? [\w' ]{1,24} \d+ times|names? the [\w ]{1,30} \d+ times|TBD\b|OMIT\b|UNMEASURED|unconfirmed|pmpublish|pmprint|pmseoaeo|PROPOSED\b|lead term|search volume|unit \d[a-z]{2}\b)/i;
	const strip = (s: string) => s.replace(/,?\s+per the Doc\b/gi, '');
	const copy = (slug: string, field: string, s: unknown): string | null => {
		if (s == null || s === '') return null;
		const out = strip(String(s));
		const m = out.match(INTERNAL);
		if (m)
			throw new Error(
				`book copy leak: ${slug} ${field} contains internal wording "${m[0]}" — fix it in the ship set`,
			);
		return out;
	};
	// FAQ: an entry with internal wording, or naming Amazon (Amazon is a sameAs record only), is held back
	const faqGate = (items: { q: string; a: string }[] | undefined) => {
		const kept: { q: string; a: string }[] = [];
		let dropped = 0;
		for (const f of items ?? []) {
			const q = strip(f.q ?? '');
			const a = strip(f.a ?? '');
			if (!q || !a || INTERNAL.test(`${q} ${a}`) || /amazon/i.test(`${q} ${a}`)) dropped++;
			else kept.push({ q, a });
		}
		return { kept, dropped };
	};
	// the mirrored page copy: every string through the same gate, by path, so a leak names its field
	const deep = (slug: string, path: string, v: any): any =>
		typeof v === 'string'
			? copy(slug, path, v)
			: Array.isArray(v)
				? v.map((x, i) => deep(slug, `${path}[${i}]`, x))
				: v && typeof v === 'object'
					? Object.fromEntries(
							Object.entries(v).map(([k, x]) => [k, deep(slug, `${path}.${k}`, x)]),
						)
					: v;
	// a fact shows only when it is clean: LCCN = 10 digits, alone or "(Doc and sheet.json)" (both sources agree); trim
	// = a measurement, alone or "(Doc)". "sheet.json only", "unconfirmed", "none", a conflict note -> omitted.
	const lccnOf = (v: unknown) => {
		const m = String(v ?? '').match(/^(\d{10})(\s+\(Doc and sheet\.json\))?$/);
		return m ? m[1] : null;
	};
	const trimOf = (v: unknown) => {
		const m = String(v ?? '').match(/^([\d.]+ x [\d.]+ in)(\s+\(Doc\))?$/);
		return m ? m[1] : null;
	};
	const usable = (v: unknown) => v != null && v !== '' && !/^(TBD|OMIT)\b/i.test(String(v));
	const SKUS = bookSkus.skus as Record<string, any>;
	const pages: Page[] = [];

	// the books the store sells today
	for (const b of engineBooks.books as any[]) {
		const f = faqGate(b.faq);
		pages.push({
			slug: b.slug,
			title: b.title,
			h1: b.title,
			subtitle: copy(b.slug, 'subtitle', b.subtitle),
			author: b.author.name,
			credits: null,
			page_title: copy(b.slug, 'page_title', b.page_title) as string,
			meta: copy(b.slug, 'short', b.short) as string,
			short: copy(b.slug, 'short', b.short) as string,
			about: null,
			aboutHtml: copy(b.slug, 'long_html', b.long_html),
			who_for: (b.who_for ?? []).map(
				(w: string, i: number) => copy(b.slug, `who_for[${i}]`, w) as string,
			),
			faq: f.kept,
			faqDropped: f.dropped,
			bio: copy(b.slug, 'author_bio', b.author_bio),
			cover: {
				src: b.cover.w600 ?? b.cover.jpg,
				w: b.cover.width,
				h: b.cover.height,
				alt: b.cover.alt,
			},
			formats: (b.formats as string[]).map((sku) => ({ sku, ...SKUS[sku] })),
			lccn: null,
			sameAs: [],
			canonical: `https://fathersheartbible.com/books/${b.slug}/`,
			orderable: b.status === 'live',
			page: null,
		});
	}
	const sold = new Set(pages.map((p) => p.slug));

	// the ship set (sales order)
	for (const t of set.titles as any[]) {
		if (sold.has(t.slug)) continue;
		const b = t.book;
		const d = (dims as Record<string, { w: number; h: number }>)[t.slug];
		// the mirrored page's questions replace the draft FAQ (same gate)
		const f = faqGate(b.page?.faq ?? b.faq);
		const ld = b.jsonld?.book ?? {};
		pages.push({
			slug: t.slug,
			title: b.title,
			h1: copy(t.slug, 'h1', b.h1 || b.title) as string,
			subtitle: usable(b.subtitle) ? copy(t.slug, 'subtitle', b.subtitle) : null,
			author: b.author.name,
			credits: usable(b.credits) ? copy(t.slug, 'credits', b.credits) : null,
			page_title: copy(t.slug, 'page_title', b.page_title) as string,
			meta: copy(t.slug, 'meta', b.meta) as string,
			short: copy(t.slug, 'short', b.short) as string,
			about: copy(t.slug, 'about', b.about),
			aboutHtml: null,
			who_for: (Array.isArray(b.who_for) ? b.who_for : []).map(
				(w: string, i: number) => copy(t.slug, `who_for[${i}]`, w) as string,
			),
			faq: f.kept,
			faqDropped: f.dropped,
			bio: usable(b.bio) ? copy(t.slug, 'bio', b.bio) : null,
			// pre-sized R2 covers (pmprint 11-14) when the title has them: 600 webp src, 300 in srcset, 1200 jpg for OG
			cover: (sized as Record<string, any>).covers[t.slug]
				? {
						src: (sized as Record<string, any>).covers[t.slug].w600,
						w300: (sized as Record<string, any>).covers[t.slug].w300,
						og: (sized as Record<string, any>).covers[t.slug].jpg1200,
						w: (sized as Record<string, any>).covers[t.slug].width,
						h: (sized as Record<string, any>).covers[t.slug].height,
						alt: `Cover of ${b.title} by ${b.author.name}`,
					}
				: { src: b.cover.jpg, w: d.w, h: d.h, alt: `Cover of ${b.title} by ${b.author.name}` },
			formats: (b.formats as string[])
				.map((sku: string) => ({ sku, ...t.skus[sku] }))
				.filter((x: any) => usable(x.isbn))
				.map((x: any) => ({
					sku: x.sku,
					format: x.format,
					schema_format: x.schema_format,
					isbn: x.isbn,
					isbn_display: x.isbn_display,
					list_cents: Number.isInteger(x.list_cents) ? x.list_cents : null,
					pages: Number.isInteger(x.pages) ? x.pages : null,
					trim: trimOf(x.trim),
				})),
			lccn: lccnOf(b.lccn),
			sameAs: (Array.isArray(ld.sameAs) ? ld.sameAs : []).filter((u: unknown) =>
				/^https:\/\/\S+$/.test(String(u)),
			),
			// publisher of record when it is not SMP (Say Yes to God = Vector Reach, author-owned ISBNs; pmseoaeo 11-14 02:49Z)
			publisher: usable(b.publisher) ? (b.publisher as string) : null,
			canonical: null,
			orderable: (b.formats as string[]).some((sku) => BOOK_SKUS[sku]?.isbn),
			page: b.page ? deep(t.slug, 'page', b.page) : null,
		});
	}
	// Lamb (Kevin L1971 pilot; pmseoaeo QA 3ft #6: same template). Sourced facts only (src/data/books/<slug>.json): no
	// price, no ISBN-to-format, no description yet, so the page carries what is known and "Available soon".
	if (!pages.some((p) => p.slug === lamb.slug)) {
		const desc = `${lamb.title}, a book by ${lamb.author}, published by ${lamb.publisher}.`;
		pages.push({
			slug: lamb.slug,
			title: lamb.title,
			h1: lamb.title,
			subtitle: null,
			author: lamb.author,
			credits: null,
			page_title: `${lamb.title} by ${lamb.author}`,
			meta: desc,
			short: desc,
			about: null,
			aboutHtml: null,
			who_for: [],
			faq: [],
			faqDropped: 0,
			bio: null,
			cover: {
				src: `${lamb.cover.src}?w=600&fm=webp&q=80`,
				w: 600,
				h: Math.round((600 * lamb.cover.height) / lamb.cover.width),
				alt: lamb.cover.alt,
			},
			formats: lamb.formats.map((f: { format: string; schema_format: string }) => ({
				sku: '',
				format: f.format,
				schema_format: f.schema_format,
				isbn: '',
				isbn_display: '',
				list_cents: null,
				pages: null,
				trim: null,
			})),
			lccn: null,
			sameAs: (lamb.same_as ?? []).filter((u: string) => /^https:\/\/\S+$/.test(u)),
			canonical: null,
			orderable: false,
			page: null,
		});
	}
	return pages.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Page };
const SITE = 'https://spiritmediapublishing.com';
const url = `${SITE}/books/${p.slug}/`;
const money = (c: number) => `$${(c / 100).toFixed(2)}`;
// ship-to: the US, plus every live country with a measured landed cost for ALL this book's formats
// the formats the store sells (in its registry, with a price); the rest show in Book details only
const sellFormats = p.formats.filter((f) => f.list_cents != null && BOOK_SKUS[f.sku]);
const countries = p.orderable
	? LIVE_COUNTRIES.filter(
			(c) =>
				c.code === 'US' ||
				sellFormats.every((f) => (c.landed_cost_usd as any)?.[BOOK_SKUS[f.sku]?.costKey] != null),
		).map((c) => ({ code: c.code, name: c.name }))
	: [];

const ld = {
	'@context': 'https://schema.org',
	'@type': 'Book',
	'@id': `${url}#book`,
	name: p.title,
	...(p.subtitle ? { alternativeHeadline: p.subtitle } : {}),
	url,
	description: p.short,
	author: { '@type': 'Person', name: p.author },
	publisher:
		p.publisher && p.publisher !== 'Spirit Media Publishing'
			? { '@type': 'Organization', name: p.publisher }
			: {
					'@type': 'Organization',
					'@id': `${SITE}/#organization`,
					name: 'Spirit Media Publishing',
				},
	inLanguage: 'en',
	image: p.cover.og ?? p.cover.src,
	...(p.sameAs.length ? { sameAs: p.sameAs } : {}),
	workExample: p.formats
		.filter((f) => f.isbn)
		.map((f) => ({
			'@type': 'Book',
			bookFormat: f.schema_format,
			isbn: f.isbn,
			...(f.pages ? { numberOfPages: f.pages } : {}),
		})),
};
const faqLd = p.faq.length
	? {
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: p.faq.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
		}
	: null;
const crumbs = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
		{ '@type': 'ListItem', position: 2, name: 'Bookstore', item: `${SITE}/bookstore/` },
		{ '@type': 'ListItem', position: 3, name: p.title, item: url },
	],
};
---

<Layout title={p.page_title} description={p.meta} ogImage={p.cover.og ?? p.cover.src} canonical={p.canonical ?? undefined}>
	<Fragment slot="head">
		<link rel="preload" as="image" href={p.cover.src} imagesrcset={p.cover.w300 ? `${p.cover.w300} 300w, ${p.cover.src} 600w` : undefined} imagesizes={p.cover.w300 ? "(min-width: 768px) 280px, 240px" : undefined} fetchpriority="high" />
		{!p.canonical && <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>}
		{!p.canonical && faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>}
		<script type="application/ld+json" set:html={JSON.stringify(crumbs)}></script>
	</Fragment>
	<main id="main-content">
		<section class="bg-stone-50 px-4 py-8 sm:px-6 lg:px-8 lg:py-14">
			<div class="mx-auto max-w-5xl">
				<nav aria-label="Breadcrumb" class="mb-5 text-sm text-stone-600">
					<a href="/" class="text-stone-600 underline-offset-2 hover:underline">Home</a> /
					<a href="/bookstore/" class="text-stone-600 underline-offset-2 hover:underline">Bookstore</a> /
					<span aria-current="page">{p.title}</span>
				</nav>
				<div class="grid items-start gap-8 md:grid-cols-[280px_1fr] md:gap-10">
					<img
						src={p.cover.src}
						srcset={p.cover.w300 ? `${p.cover.w300} 300w, ${p.cover.src} 600w` : undefined}
						sizes={p.cover.w300 ? '(min-width: 768px) 280px, 240px' : undefined}
						width={p.cover.w}
						height={p.cover.h}
						alt={p.cover.alt}
						fetchpriority="high"
						decoding="async"
						class="mx-auto h-auto w-full max-w-[240px] rounded shadow-lg md:max-w-[280px]"
					/>
					<div>
						<h1 class="text-3xl font-bold leading-tight text-ink lg:text-4xl">{p.h1}</h1>
						{p.subtitle && <p class="mt-2 text-lg leading-snug text-ink-muted">{p.subtitle}</p>}
						<p class="mt-3 text-base text-stone-700">by {p.author}{p.credits && <span> · {p.credits}</span>}</p>

						{p.page?.hero?.eyebrow && <p class="mt-1 text-xs font-bold uppercase tracking-widest text-stone-500">{p.page.hero.eyebrow}</p>}
						{p.page?.hero?.audience_line && <p class="mt-4 text-base leading-relaxed text-stone-700">{p.page.hero.audience_line}</p>}
						{p.page?.hero?.chips?.length > 0 && (
							<div class="mt-4 flex flex-wrap gap-2">
								{(p.page?.hero?.chips ?? []).map((c: string) => <span class="rounded-md border-2 border-ink-soft bg-white px-3 py-1 text-sm font-bold uppercase tracking-wide text-ink-soft">{c}</span>)}
							</div>
						)}
						{p.page?.hero?.offer_line && <p class="mt-4 text-sm font-semibold text-stone-700">{p.page.hero.offer_line}</p>}
						<div class="mt-5 flex flex-wrap gap-3">
							<a href="#order" class="inline-flex min-h-12 items-center justify-center rounded-full bg-ink-soft px-7 font-semibold text-white hover:bg-ink">Order</a>
							{p.page?.look_inside?.length > 0 && <a href="#look-inside" class="inline-flex min-h-12 items-center justify-center rounded-full border-2 border-ink-soft bg-white px-6 font-semibold text-ink-soft">Look inside</a>}
						</div>
						{!p.page && <p class="mt-6 text-base leading-relaxed text-stone-800">{p.short}</p>}
					</div>
				</div>
				<div class="mx-auto mt-10 max-w-xl">
						{p.orderable ? (
							<form id="order" class="scroll-mt-28 rounded-lg border border-stone-300 bg-white p-4 sm:p-5" data-slug={p.slug} data-status="live">
								<p class="text-xs font-bold uppercase tracking-widest text-stone-500">Order direct · free US shipping</p>
								<h2 class="mt-1 text-xl font-bold text-ink">Order {p.title}</h2>
								<div class="mt-4 space-y-3">
									{sellFormats.map((f) => (
										<label class="flex items-center justify-between gap-4 rounded-lg border border-stone-300 p-3">
											<span class="flex flex-col"><span class="font-semibold text-ink">{f.format}</span>{f.list_cents != null && <span class="text-lg font-bold text-ink">{money(f.list_cents)}</span>}</span>
											<input type="number" inputmode="numeric" name={f.sku} min="0" max="999" value={sellFormats.length === 1 ? 1 : 0} class="h-11 w-20 rounded border border-stone-300 px-2 text-center text-base" aria-label={`${f.format} quantity`} />
										</label>
									))}
								</div>
								<label class="mt-4 block">
									<span class="text-sm font-semibold text-ink">Ship to</span>
									<select name="country" class="mt-1 h-11 w-full rounded border border-stone-300 bg-white px-2 text-base">
										{countries.map((c) => <option value={c.code} selected={c.code === 'US'}>{c.name}</option>)}
									</select>
								</label>
								{countries.length === 1 && <p class="mt-1 text-sm text-stone-600">Ships to more countries soon.</p>}
								<button type="submit" class="mt-4 min-h-12 w-full rounded-full bg-ink-soft px-4 py-3 font-semibold text-white hover:bg-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-soft">Checkout →</button>
								<p id="buy-msg" role="status" class="mt-2 text-sm text-stone-700"></p>
								<p class="mt-2 text-sm text-stone-600">Free shipping in the US. <a href="/returns/" class="text-ink-soft underline">30-day returns</a>.</p>
							</form>
						) : (
							<div id="order" class="scroll-mt-28 rounded-lg border border-stone-300 bg-white p-4 sm:p-5" data-status="pending">
								<ul class="space-y-1.5">
									{p.formats.map((f) => (
										<li class="flex items-baseline justify-between gap-4 text-lg">
											<span class="font-semibold text-ink">{f.format}</span>
											{f.list_cents != null && <span class="font-bold text-ink">{money(f.list_cents)}</span>}
										</li>
									))}
								</ul>
								<p class="mt-4 border-t border-stone-200 pt-3 text-stone-700">Available soon from our store.</p>
							</div>
						)}

				</div>
			</div>
		</section>

		{p.page ? <BookMirror page={p.page} title={p.title} faq={p.faq} /> : (
		<section class="px-4 py-10 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-3xl space-y-10 text-stone-800">
				{p.who_for.length > 0 && (
					<div>
						<h2 class="text-2xl font-bold text-ink">Who this book is for</h2>
						<ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed">{p.who_for.map((w) => <li>{w}</li>)}</ul>
					</div>
				)}
				{(p.aboutHtml || p.about) && (
					<div>
						<h2 class="text-2xl font-bold text-ink">About the book</h2>
						{p.aboutHtml ? <div class="book-about mt-4 space-y-3 leading-relaxed" set:html={p.aboutHtml} /> : <p class="mt-4 leading-relaxed">{p.about}</p>}
					</div>
				)}
				{p.bio && (
					<div>
						<h2 class="text-2xl font-bold text-ink">About the author</h2>
						<p class="mt-4 leading-relaxed">{p.bio}</p>
					</div>
				)}
				<div>
					<h2 class="text-2xl font-bold text-ink">Book details</h2>
					<dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-[0.95rem]">
						<dt class="font-semibold">Publisher</dt><dd>Spirit Media Publishing</dd>
						<dt class="font-semibold">Language</dt><dd>English</dd>
						{p.formats.filter((f) => f.isbn_display || f.pages || f.trim).map((f) => (
							<>
								<dt class="font-semibold">{f.format}</dt>
								<dd>{[f.isbn_display && `ISBN ${f.isbn_display}`, f.pages && `${f.pages} pages`, f.trim].filter(Boolean).join(' · ')}</dd>
							</>
						))}
						{p.lccn && (<><dt class="font-semibold">LCCN</dt><dd>{p.lccn}</dd></>)}
					</dl>
				</div>
				{p.faq.length > 0 && (
					<div>
						<h2 class="text-2xl font-bold text-ink">Questions</h2>
						<div class="mt-4 divide-y divide-stone-200 rounded-lg border border-stone-300 bg-white" data-faq-dropped={p.faqDropped}>
							{p.faq.map((f) => (
								<details class="group p-4">
									<summary class="cursor-pointer list-none font-semibold text-ink">{f.q}</summary>
									<p class="mt-2 leading-relaxed">{f.a}</p>
								</details>
							))}
						</div>
					</div>
				)}
				<p><a href="/bookstore/" class="font-semibold text-ink-soft underline underline-offset-2">Browse all Spirit Media books</a></p>
			</div>
		</section>
		)}
	</main>
</Layout>

<style>
	.book-about :global(p) { margin: 0 0 0.75rem; }
	.book-about :global(strong) { color: var(--color-ink); }
</style>

<script>
	const form = document.getElementById('order') as HTMLFormElement | null;
	if (form?.tagName === 'FORM') {
		form.addEventListener('submit', async (ev) => {
			ev.preventDefault();
			const msg = document.getElementById('buy-msg') as HTMLElement;
			const counts: Record<string, number> = {};
			for (const i of form.querySelectorAll<HTMLInputElement>('input[type=number]')) counts[i.name] = Math.max(0, Math.floor(Number(i.value) || 0));
			if (!Object.values(counts).some((n) => n > 0)) {
				msg.textContent = 'Choose at least one copy.';
				return;
			}
			const q = new URLSearchParams(location.search);
			const utm = Object.fromEntries(['source', 'medium', 'campaign', 'content'].map((k) => [k, q.get(`utm_${k}`) ?? '']).filter(([, v]) => v));
			const site = ({ 'fathersheartbible.com': 'fhb', 'vaneure.com': 'vaneure' } as Record<string, string>)[utm.source ?? ''] ?? 'smp';
			const country = (form.querySelector('select[name=country]') as HTMLSelectElement).value;
			(window as any).gtag?.('event', 'begin_checkout', { currency: 'USD', items: Object.entries(counts).filter(([, n]) => n > 0).map(([id, n]) => ({ item_id: id, quantity: n })) });
			msg.textContent = '';
			const btn = form.querySelector('button') as HTMLButtonElement;
			btn.disabled = true;
			try {
				const r = await fetch('/store-checkout', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ counts, country, returnPath: `/books/${form.dataset.slug}/`, site, utm }),
				});
				const j = await r.json();
				if (j.url) {
					location.href = j.url;
					return;
				}
				msg.textContent = j.message || (j.disabled ? 'Checkout is not open yet.' : 'Something went wrong. Please try again.');
			} catch {
				msg.textContent = 'Something went wrong. Please try again.';
			}
			btn.disabled = false;
		});
	}
</script>
