---
// /books/<slug>/buy/ — the SMP store checkout page for ONE book (plan 3fb Phase 3, contract 3fe; Kevin 11-13 "SMP
// is the engine"). That book's formats only, one quiet link to all SMP books, nothing else competing for focus.
// noindex,follow + canonical to the book's ranking page: a transaction page, never a second product page.
// Prices/SKUs come from the store engine data (src/store-engine/, a manifest-checked copy of FHB's); a book whose
// status is not "live" (Lamb today: no confirmed price or ISBN) shows no form.
import lamb from '../../../data/books/jesus-had-a-little-lamb.json';
import Layout from '../../../layouts/Layout.astro';
import bookSkus from '../../../store-engine/data/book-skus.json';
import catalog from '../../../store-engine/data/books.json';
import { BOOK_SKUS } from '../../../store-engine/lib/order-pricing.ts';
import { LIVE_COUNTRIES } from '../../../store-engine/lib/shipCountries.ts';

type Fmt = { sku: string; format: string; cents: number };
type Buy = {
	slug: string;
	title: string;
	author: string;
	cover: string;
	alt: string;
	canonical: string;
	live: boolean;
	formats: Fmt[];
};

export function getStaticPaths() {
	const skus = bookSkus.skus as Record<string, { format: string; list_cents: number }>;
	const fhb: Buy[] = (catalog.books as any[]).map((b) => ({
		slug: b.slug,
		title: b.title,
		author: b.author?.name ?? '',
		cover: b.cover?.w600 ?? b.cover?.jpg,
		alt: b.cover?.alt ?? `Cover of ${b.title}`,
		// D1 open: the Father Heart books' ranking page is fathersheartbible.com/books/<slug>/ until Kevin rules otherwise
		canonical: `https://fathersheartbible.com/books/${b.slug}/`,
		live: b.status === 'live',
		formats: (b.formats as string[]).map((sku) => ({
			sku,
			format: skus[sku].format,
			cents: skus[sku].list_cents,
		})),
	}));
	const smp: Buy = {
		slug: lamb.slug,
		title: lamb.title,
		author: lamb.author,
		cover: `${lamb.cover.src}?w=600&fm=webp&q=80`,
		alt: lamb.cover.alt,
		canonical: `https://spiritmediapublishing.com/books/${lamb.slug}/`,
		live: lamb.status === 'live',
		formats: [],
	};
	return [smp, ...fhb].map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

const { book } = Astro.props as { book: Buy };
// countries this book can ship to: the US, plus every live country with a measured landed cost for ALL its formats
const countries = LIVE_COUNTRIES.filter(
	(c) =>
		c.code === 'US' ||
		book.formats.every((f) => c.landed_cost_usd?.[BOOK_SKUS[f.sku]?.costKey] != null),
).map((c) => ({ code: c.code, name: c.name }));
const usd = (c: number) => `$${(c / 100).toFixed(2)}`;
---

<Layout title={`Buy ${book.title}`} description={`Order ${book.title} by ${book.author} from Spirit Media Publishing.`} robots="noindex, follow" canonical={book.canonical}>
	<main id="main-content">
		<section class="bg-stone-50 px-6 py-12 lg:py-16 lg:px-8">
			<div class="mx-auto max-w-4xl grid gap-10 md:grid-cols-[260px_1fr] items-start">
				<img src={book.cover} width="600" height="600" alt={book.alt} fetchpriority="high" class="w-full max-w-[260px] mx-auto h-auto rounded shadow-lg" />
				<div>
					<h1 class="text-3xl font-bold text-stone-900">{book.title}</h1>
					<p class="mt-1 text-stone-700">by {book.author}</p>
					{book.live ? (
						<form id="buy" class="mt-6 space-y-4" data-slug={book.slug}>
							{book.formats.map((f) => (
								<label class="flex items-center justify-between gap-4 rounded border border-stone-300 bg-white p-3">
									<span class="font-semibold">{f.format} <span class="font-normal text-stone-600">{usd(f.cents)}</span></span>
									<input type="number" name={f.sku} min="0" max="999" value={book.formats.length === 1 ? 1 : 0} class="w-20 rounded border border-stone-300 p-1 text-right" aria-label={`${f.format} quantity`} />
								</label>
							))}
							<label class="block">
								<span class="text-sm font-semibold">Ship to</span>
								<select name="country" class="mt-1 w-full rounded border border-stone-300 p-2">
									{countries.map((c) => <option value={c.code} selected={c.code === 'US'}>{c.name}</option>)}
								</select>
							</label>
							<button type="submit" class="w-full rounded bg-red-700 px-4 py-3 font-semibold text-white hover:bg-red-800">Checkout</button>
							<p id="buy-msg" role="alert" class="text-sm text-red-700"></p>
							<p class="text-sm text-stone-600">Free shipping in the US. <a href="https://fathersheartbible.com/returns/" class="underline">30-day returns</a>.</p>
						</form>
					) : (
						<p class="mt-6 rounded border border-stone-300 bg-white p-4" data-status="pending">Available soon from our store.</p>
					)}
					<p class="mt-8 text-sm"><a href="/bookstore/" class="text-red-700 underline">Browse all Spirit Media books</a></p>
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	const form = document.getElementById('buy') as HTMLFormElement | null;
	form?.addEventListener('submit', async (ev) => {
		ev.preventDefault();
		const msg = document.getElementById('buy-msg') as HTMLElement;
		const counts: Record<string, number> = {};
		for (const i of form.querySelectorAll<HTMLInputElement>('input[type=number]')) counts[i.name] = Math.max(0, Math.floor(Number(i.value) || 0));
		if (!Object.values(counts).some((n) => n > 0)) { msg.textContent = 'Choose at least one copy.'; return; }
		const q = new URLSearchParams(location.search);
		const utm = Object.fromEntries(['source', 'medium', 'campaign', 'content'].map((k) => [k, q.get(`utm_${k}`) ?? '']).filter(([, v]) => v));
		const site = ({ 'fathersheartbible.com': 'fhb', 'vaneure.com': 'vaneure' } as Record<string, string>)[utm.source ?? ''] ?? 'smp';
		const country = (form.querySelector('select[name=country]') as HTMLSelectElement).value;
		(window as any).gtag?.('event', 'begin_checkout', { currency: 'USD', items: Object.entries(counts).filter(([, n]) => n > 0).map(([id, n]) => ({ item_id: id, quantity: n })) });
		msg.textContent = '';
		const btn = form.querySelector('button') as HTMLButtonElement;
		btn.disabled = true;
		try {
			const r = await fetch('/store-checkout', { method: 'POST', headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ counts, country, returnPath: `/books/${form.dataset.slug}/buy/`, site, utm }) });
			const j = await r.json();
			if (j.url) { location.href = j.url; return; }
			msg.textContent = j.message || (j.disabled ? 'Checkout is not open yet.' : 'Something went wrong. Please try again.');
		} catch { msg.textContent = 'Something went wrong. Please try again.'; }
		btn.disabled = false;
	});
</script>
