---
import AnswerBlock from '../components/AnswerBlock.astro';
import FaqSection from '../components/FaqSection.astro';
import Layout from '../layouts/Layout.astro';

// Answer page for "book cover design". Every fact here comes from pages already
// published on this site: /publishing/ (services, formats, costs, timeline),
// /express-books/ (Design & Format step, formats) and /portfolio/ (300+ titles).
// There is no cover-only price on the site, so none is stated here. Do not add
// numbers or claims that are not on those pages.
const answerUpdated = '2026-11-10';
const answerText =
	'Spirit Media Publishing designs the covers for the books it publishes. Cover design is part of our publishing process, alongside editing, interior layout, ISBN, and global distribution through Amazon, IngramSpark, libraries, and eBook stores. Books are published in about 5 months, accelerated paperbacks in 14 days, and every publishing package includes a 50/50 royalty split.';

const steps = [
	{
		n: '1',
		t: 'Your manuscript',
		d: 'Cover design belongs to publishing, so it starts with your book. Email your manuscript to publisher@spiritmedia.us for a free 20-point review by our editors.',
	},
	{
		n: '2',
		t: 'Editing',
		d: 'Our editors polish your manuscript to the Chicago Manual of Style, so the cover and the pages inside tell the same finished story.',
	},
	{
		n: '3',
		t: 'Design and format',
		d: 'Professional cover design and interior layout, print-ready for paperback and formatted for eBook and PDF.',
	},
	{
		n: '4',
		t: 'Publish and distribute',
		d: 'Your book launches with global distribution through Amazon, IngramSpark, libraries, and eBook stores worldwide.',
	},
];

const formats = [
	{ t: 'Paperback', d: 'A print-ready cover and interior. An EXPRESS BOOK is roughly 80 pages.' },
	{
		t: 'Hardback',
		d: 'Hardback is one of the formats we publish, available as an add-on to any publishing package.',
	},
	{
		t: 'eBook and PDF',
		d: 'Every EXPRESS BOOK is formatted for eBook and downloadable PDF as well as paperback.',
	},
	{ t: 'Audiobook', d: 'Audiobook is available as an add-on to any publishing package.' },
];

const faqs = [
	{
		q: 'Does Spirit Media design book covers?',
		a: 'Yes, for the books we publish. Cover design is part of the Spirit Media publishing process, along with editing, interior layout, ISBN, and global distribution through Amazon, IngramSpark, libraries, and eBook stores.',
	},
	{
		q: 'What formats is the cover designed for?',
		a: 'Our design and format step makes the book print-ready for paperback and formatted for eBook and PDF. We also publish in hardback and audiobook, available as add-ons to any publishing package.',
	},
	{
		q: 'How much does book cover design cost at Spirit Media?',
		a: 'We do not publish a separate cover-only price. Cover design is part of publishing, and the published costs are for the whole book: an eBook starts at $300 to $600, and a print book is $3,000 or more. Hardback, audiobook, foreign translation, and foreign-language publishing are add-ons. Contact us for a free consultation about your book.',
	},
	{
		q: 'How long does it take to get a book cover and publish the book?',
		a: 'Books are published in 5 months, or 3 months if you start with an eBook. Accelerated paperbacks are available in 14 days. An EXPRESS BOOK can go from idea to published in 90 days.',
	},
	{
		q: 'Can you redesign the cover of a book I already published?',
		a: 'Yes. Our Republish Your Book service covers re-releasing, updating, or redesigning an existing title, and we handle the full process.',
	},
	{
		q: 'Can I see covers Spirit Media has designed?',
		a: 'Yes. Our portfolio shows our client work, and Spirit Media has published 300+ titles across paperback, hardback, digital, and audiobook formats.',
	},
];
---

<Layout
	title="Book Cover Design for Christian Authors | Spirit Media"
	description="Spirit Media designs the covers for the books it publishes: professional cover design and interior layout, print-ready for paperback and formatted for eBook and PDF."
>
	<Fragment slot="head">
		<meta name="keywords" content="book cover design, Christian book cover design, book cover design for authors, cover design and interior layout, Spirit Media Publishing" />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Service",
			"name": "Book Cover Design — Spirit Media Publishing",
			"provider": { "@type": "Organization", "@id": "https://spiritmediapublishing.com/#organization", "name": "Spirit Media Publishing", "url": "https://spiritmediapublishing.com" },
			"serviceType": "Cover Design",
			"description": "Professional cover design and interior layout for books published by Spirit Media, print-ready for paperback and formatted for eBook and PDF.",
			"url": "https://spiritmediapublishing.com/book-cover-design/",
			"areaServed": "Worldwide"
		})}></script>
	</Fragment>
	<main id="main-content">

		<section class="bg-stone-50 px-6 py-12 lg:py-24 lg:px-8 overflow-hidden">
			<div class="mx-auto max-w-3xl text-center">
				<p class="eyebrow eyebrow-red mb-4">Cover Design</p>
				<h1 class="type-hero text-ink-soft">
					Book cover design, <span class="text-red">part of publishing your book</span>
				</h1>
				<p class="mt-6 type-body-lg text-stone-700 max-w-2xl mx-auto">
					Professional cover design and interior layout for the books we publish, print-ready for paperback and formatted for eBook and PDF.
				</p>
				<div class="mt-8 flex flex-wrap gap-4 justify-center">
					<a href="/contact/" class="rounded-md bg-red px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-red-deep">Request a Free Consultation →</a>
					<a href="/publishing/" class="rounded-md border border-stone-400 px-6 py-3 text-sm font-semibold text-ink-soft transition-colors hover:bg-stone-100">All Publishing Services</a>
				</div>
			</div>
		</section>

		<AnswerBlock
			url="/book-cover-design/"
			name="Book Cover Design — Spirit Media Publishing"
			question="Who does book cover design for Christian authors?"
			answer={answerText}
			updated={answerUpdated}
		/>

		<section class="bg-stone-50 py-12 lg:py-20 px-6 lg:px-8">
			<div class="max-w-3xl mx-auto">
				<div class="text-center mb-8">
					<p class="eyebrow eyebrow-red mb-3">What You Get</p>
					<h2 class="type-section-heading text-ink-soft">A cover that belongs to the whole book</h2>
				</div>
				<p class="text-stone-700 leading-relaxed mb-4">A cover is not a separate errand at Spirit Media. It is one step in publishing your book. Our design and format step produces professional cover design and interior layout together, so the book is print-ready for paperback and formatted for eBook and PDF when it goes out.</p>
				<p class="text-stone-700 leading-relaxed">From there we publish with global distribution through Amazon, IngramSpark, libraries, and eBook stores worldwide. Spirit Media has published 300+ titles across paperback, hardback, digital, and audiobook formats, and you can see client work in our <a href="/portfolio/" class="text-red hover:underline">portfolio</a>.</p>
			</div>
		</section>

		<section class="bg-stone-100 py-12 lg:py-20 px-6 lg:px-8">
			<div class="max-w-4xl mx-auto">
				<div class="text-center mb-10">
					<p class="eyebrow eyebrow-red mb-3">The Process</p>
					<h2 class="type-section-heading text-ink-soft">From manuscript to finished cover</h2>
				</div>
				<div class="space-y-4">
					{steps.map(({ n, t, d }) => (
						<div class="flex items-start gap-4 bg-stone-50 rounded-xl p-5 border border-stone-200">
							<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red text-white font-bold text-sm">{n}</span>
							<div>
								<h3 class="font-semibold text-ink-soft">{t}</h3>
								<p class="type-body-sm text-stone-600 mt-0.5">{d}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="bg-stone-50 py-12 lg:py-20 px-6 lg:px-8">
			<div class="max-w-4xl mx-auto">
				<div class="text-center mb-10">
					<p class="eyebrow eyebrow-red mb-3">Formats</p>
					<h2 class="type-section-heading text-ink-soft">Print and digital</h2>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					{formats.map(({ t, d }) => (
						<div class="bg-stone-100 rounded-xl p-6 border border-stone-200">
							<h3 class="font-semibold text-ink-soft">{t}</h3>
							<p class="type-body-sm text-stone-600 mt-1">{d}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="bg-stone-100 py-12 lg:py-20 px-6 lg:px-8">
			<div class="max-w-3xl mx-auto">
				<div class="text-center mb-8">
					<p class="eyebrow eyebrow-red mb-3">Cost and Timeline</p>
					<h2 class="type-section-heading text-ink-soft">What the site states today</h2>
				</div>
				<p class="text-stone-700 leading-relaxed mb-4">We do not list a cover-only price. Cover design is part of publishing, and our published costs are for the whole book: an eBook starts at $300 to $600, and a print book is $3,000 or more. Hardback, audiobook, foreign translation, and foreign-language publishing are add-ons. All publishing includes a 50/50 royalty split.</p>
				<p class="text-stone-700 leading-relaxed mb-4">Books are published in 5 months, or 3 months if you start with an eBook. Accelerated paperbacks are available in 14 days.</p>
				<p class="text-stone-700 leading-relaxed">Already published and want a fresh look? Our Republish Your Book service covers re-releasing, updating, or redesigning an existing title. See <a href="/publishing/" class="text-red hover:underline">Christian book publishing services</a> for the packages, or <a href="/express-books/" class="text-red hover:underline">EXPRESS BOOKS</a> for a short book in as few as 90 days.</p>
			</div>
		</section>

		<FaqSection heading="Book cover design, answered" faqs={faqs} />

		<section class="bg-red px-6 py-12 lg:py-20 lg:px-8">
			<div class="mx-auto max-w-3xl text-center">
				<h2 class="font-serif text-3xl font-bold text-white sm:text-4xl mb-4">Ready to see your book covered?</h2>
				<p class="text-stone-200 type-body-lg mb-8">Tell us about your book and we will talk through the next step.</p>
				<a href="/contact/" class="inline-block bg-stone-50 text-red font-semibold px-8 py-3.5 rounded-md hover:bg-red-wash transition-colors">Request a Free Consultation</a>
			</div>
		</section>

	</main>
</Layout>
