---
import BookstoreBody from '../../components/BookstoreBody.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout
	title="Christian Bookstore — 300+ Spirit Media Published Titles"
	description="Shop the Spirit Media Christian bookstore — over 300 titles by Kingdom Messengers covering faith, leadership, healing, and discipleship. New books added weekly."
	ogImage="https://cdn.sanity.io/images/pmowd8uo/production/e1274263f40d901cf33297ab4c8110e8ad9d9ca7-1200x630.jpg?w=1200&h=630&fit=crop&fm=jpg&q=85"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://spiritmediapublishing.com/"},{"@type":"ListItem","position":2,"name":"Bookstore","item":"https://spiritmediapublishing.com/bookstore/"}]})}></script>
		<meta name="keywords" content="Christian bookstore, buy Christian books, Kingdom Messenger books, Spirit Media books, Christian authors, faith books, Christian leadership books, discipleship books, healing books, Christian publishing" />
	</Fragment>
	<main id="main-content">
		<BookstoreBody />
	</main>
</Layout>
