---
import BookstoreBody from '../../components/BookstoreBody.astro';
import Layout from '../../layouts/Layout.astro';

// Kevin 2026-11-16 (kevin-decisions.md): the bookstore collections are exactly All · SMP only · SMP worldwide · Express Books · FHB English
// · FHB Languages · FHB Books. One page per non-All collection; its key is its slug and must match COLLECTIONS in
// BookstoreBody.astro (scripts/store-checkout.test.mjs checks the chips against the built pages). The 3 retired FHB
// collection URLs 301 to these in public/_redirects; Express Books keeps its URL and its Sanity members.
export function getStaticPaths() {
	return [
		['smp', 'SMP only'],
		// temporary: retires itself to a 301 -> /bookstore/smp/ once it equals SMP only (BookstoreBody + astro.config.mjs)
		['smp-worldwide', 'SMP worldwide'],
		['express-books', 'Express Books'],
		['fhb-english', 'FHB English'],
		['fhb-languages', 'FHB Languages'],
		['fhb-books', 'FHB Books'],
	].map(([collection, collectionName]) => ({ params: { collection }, props: { collectionName } }));
}

const { collectionName } = Astro.props;
const { collection: collectionSlug } = Astro.params;

const canonicalUrl = `https://spiritmediapublishing.com/bookstore/${collectionSlug}/`;
// 3cu-2 (pmseoaeo 2026-11-13): titles stay <= 60 chars; a long collection name drops to the short brand suffix.
const fullTitle = `${collectionName} — Spirit Media Bookstore`;
const pageTitle = [...fullTitle].length <= 60 ? fullTitle : `${collectionName} | Spirit Media`;
const pageDescription = `Browse Spirit Media's ${collectionName} collection — short, transformative Christian reads published by Spirit Media Publishing.`;
const heroTitleHtml = `<span class="text-red">${collectionName}</span>`;
const heroSubtitle = `${collectionName} from the Spirit Media Christian bookstore. Browse the collection below.`;

// 2wg: a short unique intro per thin collection page. Every sentence is taken from an existing
// live page (sources in aeo-state/smp-collection-intros-2wg-20261112.json); counts come from
// the collection data via {n}, never typed.
const COLLECTION_INTROS: Record<string, string> = {
	'Express Books': `EXPRESS BOOKS&trade; are Spirit Media's signature publishing format: intentionally compact books designed to be read in a single sitting, at roughly 80 pages and affordably priced for easy sharing. Every EXPRESS BOOK&trade; is published in three formats (paperback, eBook and downloadable PDF) with global distribution through Amazon, IngramSpark and eBook stores worldwide. This collection lists {n} titles. See how the format works on our <a href="/express-books/" class="text-red underline">Express Books page</a>.`,
	'FHB English': `The Father's Heart Bible&trade; is an interpretive English translation edited by Kevin White, founder of Spirit Media Publishing. Where other Bibles use &ldquo;God&rdquo; to say what He is, it uses &ldquo;our Father&rdquo; to show who He has been all along. This collection lists {n} English editions, among them the audience editions, each made for a particular reader; the Graduate's Bible, for example, is for high school, college, graduate school, trade school and GED graduates. Each edition has its own page on fathersheartbible.com. Read more on our <a href="/fathers-heart-bible/" class="text-red underline">Father's Heart Bible page</a>.`,
	'FHB Languages': `The Father's Heart Bible&trade; is an interpretive English translation edited by Kevin White, founder of Spirit Media Publishing. This collection lists {n} language editions, each made for readers who speak that language; the French edition, Bible Fran&ccedil;aise, for example, is made for beloved sons and daughters worldwide who speak French. Each edition has its own page on fathersheartbible.com, and the site shows the full list of languages on its <a href="https://fathersheartbible.com/" class="text-red underline">home page<span class="xsite-dest"> <span aria-hidden="true">·</span> fathersheartbible.com</span></a>.`,
	// 3dv-5 (pmseoaeo 2026-11-24, gate met: fathersheartbible.com/books/ 200): sentence 1 = the live meta description of
	// fathersheartbible.com/books/; the rest follows the FHB Languages intro above. Links the FHB /books/ page.
	'FHB Books': `Books from the Father's Heart Bible family, for children and adults: each one about who our Heavenly Father is and who you are to Him. This collection lists {n} titles. Each book has its own page on fathersheartbible.com, and the site shows them all on its <a href="https://fathersheartbible.com/books/" class="text-red underline">Father Heart Books page<span class="xsite-dest"> <span aria-hidden="true">·</span> fathersheartbible.com</span></a>.`,
};
const introHtml = COLLECTION_INTROS[collectionName] ?? '';
---

<Layout
	title={pageTitle}
	description={pageDescription}
	ogImage="https://cdn.sanity.io/images/pmowd8uo/production/e1274263f40d901cf33297ab4c8110e8ad9d9ca7-1200x630.jpg?w=1200&h=630&fit=crop&fm=jpg&q=85"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			"name": pageTitle,
			"description": pageDescription,
			"url": canonicalUrl,
			"isPartOf": {
				"@type": "WebSite",
				"name": "Spirit Media Publishing",
				"url": "https://spiritmediapublishing.com"
			},
			"breadcrumb": {
				"@type": "BreadcrumbList",
				"itemListElement": [
					{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://spiritmediapublishing.com" },
					{ "@type": "ListItem", "position": 2, "name": "Bookstore", "item": "https://spiritmediapublishing.com/bookstore/" },
					{ "@type": "ListItem", "position": 3, "name": collectionName, "item": canonicalUrl }
				]
			}
		})}></script>
	</Fragment>
	<main id="main-content">
		<BookstoreBody
			initialCollection={collectionSlug}
			heroEyebrow="Collection"
			heroTitleHtml={heroTitleHtml}
			heroSubtitle={heroSubtitle}
			introHtml={introHtml}
		/>
	</main>
</Layout>
