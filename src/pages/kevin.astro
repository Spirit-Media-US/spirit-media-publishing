---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Schedule a Call with Kevin White — Spirit Media Publishing"
	description="Book a free consultation with Kevin White, CEO of Spirit Media Publishing. Let's talk about your book, your message, and your next step."
	ogImage="https://cdn.sanity.io/images/pmowd8uo/production/f67376ca3cbad336ac9ed54977f72d3f9917397b-1200x630.jpg?w=1200&h=630&fit=crop&fm=jpg&q=85"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://spiritmediapublishing.com/"},{"@type":"ListItem","position":2,"name":"Schedule a Call with Kevin White","item":"https://spiritmediapublishing.com/kevin/"}]})}></script>
		<meta name="keywords" content="Kevin White, schedule call, Spirit Media Publishing, book consultation, Christian publishing, free consultation" />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebPage",
			"name": "Schedule a Call with Kevin White",
			"description": "Book a free consultation with Kevin White, CEO of Spirit Media Publishing.",
			"url": "https://spiritmediapublishing.com/kevin/",
			"about": { "@id": "https://kevinwhite.us/#person" },
			"publisher": { "@type": "Organization", "@id": "https://spiritmediapublishing.com/#organization", "name": "Spirit Media Publishing", "url": "https://spiritmediapublishing.com" }
		})}></script>
		{/* 3by: the same Kevin White node as the homepage founder (one @id across both sites). */}
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"@id": "https://kevinwhite.us/#person",
			"name": "Kevin White",
			"url": "https://kevinwhite.us",
			"jobTitle": "Founder & CEO, Spirit Media Publishing",
			"worksFor": { "@id": "https://spiritmediapublishing.com/#organization" },
			"sameAs": [
				"https://kevinwhite.us",
				"https://kevinwhite.us/about/",
				"https://www.linkedin.com/in/kevinwhiteus/",
				"https://www.youtube.com/@KevinWhiteus",
				"https://www.amazon.com/stores/author/B08LZYTR2B"
			]
		})}></script>
	</Fragment>

	<main id="main-content">
		<!-- CALENDAR EMBED -->
		<section class="bg-white px-6 py-12 lg:py-16 lg:px-8">
			<div class="mx-auto max-w-4xl">
				<h1 class="mb-4 text-center text-3xl font-bold tracking-tight text-ink-soft sm:text-4xl">Schedule a Call with Kevin White</h1>
				<p class="mb-8 text-center text-lg text-gray-700">Book a free consultation with Kevin White, CEO of Spirit Media Publishing. Let's talk about your book, your message, and your next step.</p>
				<iframe
					src="https://mail.spiritmediaone.com/widget/booking/JBJZYruuU5JsL9bbL6xv"
					style="width:100%; height:800px; border:none; border-radius:3px;"
					id="msgsndr-booking-JBJZYruuU5JsL9bbL6xv"
					data-layout="{'id':'INLINE'}"
					data-trigger-type="alwaysShow"
					data-trigger-value=""
					data-activation-type="alwaysActivated"
					data-activation-value=""
					data-deactivation-type="neverDeactivate"
					data-deactivation-value=""
					data-form-name="Book a Call with Kevin"
					data-height="800"
					data-layout-iframe-id="msgsndr-booking-JBJZYruuU5JsL9bbL6xv"
					data-form-id="JBJZYruuU5JsL9bbL6xv"
					title="Schedule a call with Kevin White"
				></iframe>
				<script is:inline src="https://mail.spiritmediaone.com/js/form_embed.js"></script>
			</div>
		</section>
	</main>
</Layout>
