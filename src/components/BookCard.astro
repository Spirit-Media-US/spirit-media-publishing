---
// ONE bookstore card (Kevin 2026-11-16 "Make them show like cards on bookstore page"): the /bookstore/ grid and the
// homepage "New from Spirit Media Authors" section both render this, from the card objects BookstoreBody.astro builds
// (link = where the bookstore card goes, incl. card-page-aliases.json; cover frame from light-covers.json; badges).
// Markup only: every value is computed by BookstoreBody. Its client script redraws the same markup on filter
// (render() there): keep the two in sync.
import { destHtml, newTabHtml, sisterHost } from '../lib/xsite';

interface Props {
	b: any;
	dataKey: string;
	coverBoxClass: string;
	imgClass: string;
	dateLabel: string;
	formatsHtml: string;
}
const { b, dataKey, coverBoxClass, imgClass, dateLabel, formatsHtml } = Astro.props;
// Cross-site rule (src/lib/xsite.ts): an FHB card opens fathersheartbible.com in the SAME tab with the destination
// label; a third-party listing (Amazon ...) stays in a new tab and says so to a screen reader.
const host = sisterHost(b.amazon);
const ext = b.amazon && !b.ownPage && !host && !String(b.amazon).startsWith('/');
---
<div data-card={b.cardId} data-key={dataKey} data-colls={b.colls.join(' ')} data-live={b.live ? '1' : undefined} class="group flex flex-col bg-white overflow-hidden border border-stone-200 hover:shadow-lg hover:-translate-y-1 transition-all duration-200">
  <a href={b.amazon || undefined} target={ext ? '_blank' : undefined} rel={ext ? 'noopener noreferrer' : undefined} class="block">
    <div class={coverBoxClass}>
      {b.img && <img src={b.img} alt={b.display_title || b.title} loading="lazy" width={b.w} height={b.h} class={imgClass} />}
    </div>
    {host && <Fragment set:html={destHtml(host, true)} />}{ext && <Fragment set:html={newTabHtml} />}
  </a>
  <div class="p-3 flex flex-col gap-1">
    <a href={b.amazon || undefined} target={ext ? '_blank' : undefined} rel={ext ? 'noopener noreferrer' : undefined} class="text-xs font-semibold text-ink-soft leading-tight hover:text-red transition-colors"><span class="line-clamp-2">{b.display_title || b.title}</span>{host && <span class="xsite-line"><Fragment set:html={destHtml(host)} /></span>}{ext && <Fragment set:html={newTabHtml} />}</a>
    <p class="text-xs text-stone-500">{b.author}</p>
    {dateLabel && <p class="text-xs text-stone-400">{dateLabel}</p>}
    <Fragment set:html={formatsHtml} />
  </div>
</div>
