---
// The SMP book page body, MIRRORING fathersheartbible.com/bibles/grandparents-bible/ section for section (Kevin
// 2026-11-14 ~00:13Z via pmseoaeo: SMP book pages are "far from" the FHB edition pages; L2006). Rendered under the
// hero + order card by src/pages/books/[slug]/index.astro when a title carries `book.page` copy.
// Order of sections = the FHB edition page: audience hook -> what makes it for <audience> -> look inside -> what's
// inside + product details -> audience sections -> stories -> about the author + publisher -> why it exists -> questions.
// Every section renders ONLY from its field (copy by pmseoaeo, field list in jobs/seat-status/builder.md); nothing is
// written here. Sections alternate light/warm backgrounds as the FHB page does; one column, phone first.
interface Props {
	page: Record<string, any>;
	title: string;
	faq: { q: string; a: string }[];
	lang?: string;
}
const { page: g, title, faq, lang = 'en' } = Astro.props;
// Section labels: the page's own heading when its copy names one (a Spanish page, 3ge), else the house label in its
// language. Nothing is invented: es strings are the plain labels the Spanish copy itself uses.
const HOUSE: Record<string, Record<string, string>> = {
	en: {
		look_inside: 'Look inside',
		contents: 'Contents',
		whats_inside: "What's inside",
		details: 'Product details',
		author: 'About the author',
		faq: 'Questions',
		why: 'Why this book exists',
		browse: 'Browse all Spirit Media books',
	},
	es: {
		look_inside: 'Un vistazo por dentro',
		contents: 'Contenido',
		whats_inside: 'Qué trae el libro',
		details: 'Datos del libro',
		author: 'Sobre la autora',
		faq: 'Preguntas',
		why: 'Por qué existe este libro',
		browse: 'Ver todos los libros de Spirit Media',
	},
};
const L = { ...(HOUSE[lang] ?? HOUSE.en), ...(g.labels ?? {}) };
const bands = ['bg-white', 'bg-stone-50'];
let band = 0;
const next = () => bands[band++ % 2];
const has = (v: unknown) => (Array.isArray(v) ? v.length > 0 : v != null && v !== '');
const look = (g.look_inside ?? []).filter((x: any) => x?.src);
const details = Object.entries(g.details ?? {}).filter(([, v]) => has(v));
---

{g.audience && has(g.audience.headline) && (
	<section class={`${next()} px-4 py-12 sm:px-6 lg:px-8`}>
		<div class="mx-auto max-w-3xl">
			<h2 class="text-2xl font-bold leading-snug text-ink sm:text-3xl">{g.audience.headline}</h2>
			{g.audience.quote?.text && (
				<figure class="mt-5 rounded-2xl border border-stone-300 bg-white p-6">
					<p class="font-serif text-lg leading-relaxed text-ink">{g.audience.quote.text}</p>
					{g.audience.quote.cite && <figcaption class="mt-3 text-sm font-semibold text-stone-600">{g.audience.quote.cite}</figcaption>}
				</figure>
			)}
			{has(g.audience.body) && <p class="mt-5 leading-relaxed text-stone-700">{g.audience.body}</p>}
		</div>
	</section>
)}

{g.what_makes && has(g.what_makes.paras) && (
	<section class={`${next()} px-4 py-12 sm:px-6 lg:px-8`}>
		<div class="mx-auto max-w-3xl space-y-4 leading-relaxed text-stone-800">
			<h2 class="text-2xl font-bold text-ink sm:text-3xl">{g.what_makes.title || `What makes ${title} different`}</h2>
			{g.what_makes.paras.map((t: string) => <p>{t}</p>)}
			{has(g.what_makes.list) && (
				<ol class="list-decimal space-y-3 pl-6 marker:font-bold marker:text-ink">{g.what_makes.list.map((t: string) => <li>{t}</li>)}</ol>
			)}
		</div>
	</section>
)}

{g.look_inside_text && has(g.look_inside_text.blocks) && (
	<section class={`${next()} px-4 py-12 sm:px-6 lg:px-8`} id="look-inside">
		<div class="mx-auto max-w-3xl text-stone-800">
			<h2 class="text-2xl font-bold text-ink sm:text-3xl">{L.look_inside}</h2>
			{(g.look_inside_text.blocks ?? [{ type: 'p', text: '' }]).map((b: any) =>
				b.type === 'quote' ? (
					<figure class="mt-5 rounded-2xl border border-stone-300 bg-white p-6">
						{b.paras.map((t: string) => <p class="font-serif text-lg leading-relaxed text-ink [&+p]:mt-4">{t}</p>)}
					</figure>
				) : b.type === 'list' ? (
					<ol class="mt-4 list-decimal space-y-2 pl-6 leading-relaxed marker:font-bold marker:text-ink">{b.items.map((t: string) => <li>{t}</li>)}</ol>
				) : (
					b.text && <p class="mt-4 leading-relaxed">{b.text}</p>
				),
			)}
			{has(g.look_inside_text.contents) && (
				<div class="mt-6">
					<h3 class="text-lg font-bold text-ink">{L.contents}</h3>
					{g.look_inside_text.numbered === false ? (
						<ul class="mt-3 list-disc space-y-2 pl-6">{g.look_inside_text.contents.map((t: string) => <li>{t}</li>)}</ul>
					) : (
						<ol class="mt-3 list-decimal columns-1 gap-8 space-y-1 pl-6 sm:columns-2">{g.look_inside_text.contents.map((t: string) => <li class="break-inside-avoid">{t}</li>)}</ol>
					)}
					{has(g.look_inside_text.contents_after) && (
						<ul class="mt-2 space-y-1 pl-6 text-stone-700">{g.look_inside_text.contents_after.map((t: string) => <li>{t}</li>)}</ul>
					)}
				</div>
			)}
		</div>
	</section>
)}

{look.length > 0 && !g.look_inside_text && (
	<section class={`${next()} px-4 py-12 sm:px-6 lg:px-8`} id="look-inside">
		<div class="mx-auto max-w-5xl">
			<h2 class="text-2xl font-bold text-ink sm:text-3xl">{L.look_inside}</h2>
			<div class="mt-6 flex snap-x gap-4 overflow-x-auto pb-2">
				{look.map((p: any, i: number) => (
					<img src={p.src} alt={p.alt || `${title}, page ${i + 1}`} width={p.w || 600} height={p.h || 900} loading="lazy" decoding="async" class="h-auto w-[78%] max-w-[320px] shrink-0 snap-start rounded border border-stone-200 shadow sm:w-[300px]" />
				))}
			</div>
		</div>
	</section>
)}

{(has(g.whats_inside) || details.length > 0) && (
	<section class={`${next()} px-4 py-12 sm:px-6 lg:px-8`}>
		<div class="mx-auto max-w-3xl text-stone-800">
			{has(g.whats_inside) && (
				<>
					<h2 class="text-2xl font-bold text-ink sm:text-3xl">{L.whats_inside}</h2>
					<ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed">{g.whats_inside.map((t: string) => <li>{t}</li>)}</ul>
				</>
			)}
			{details.length > 0 && (
				<>
					<h3 class="mt-8 text-xl font-bold text-ink">{L.details}</h3>
					<dl class="mt-3 divide-y divide-stone-200 rounded-lg border border-stone-300 bg-white">
						{details.map(([k, v]) => (
							<div class="flex flex-col gap-0.5 px-4 py-2.5 sm:flex-row sm:gap-4">
								<dt class="font-semibold text-ink sm:w-44 sm:shrink-0">{k}</dt>
								<dd>{String(v)}</dd>
							</div>
						))}
					</dl>
				</>
			)}
			{g.content_note && has(g.content_note.paras) && (
				<div class="mt-8 rounded-lg border border-stone-300 bg-stone-50 p-4">
					<h3 class="text-lg font-bold text-ink">{g.content_note.title}</h3>
					{g.content_note.paras.map((x: string) => <p class="mt-2 leading-relaxed">{x}</p>)}
				</div>
			)}
		</div>
	</section>
)}

{(g.sections ?? []).filter((s: any) => has(s?.h2) && has(s?.paras)).map((s: any) => (
	<section class={`${next()} px-4 py-12 sm:px-6 lg:px-8`}>
		<div class="mx-auto max-w-3xl space-y-4 leading-relaxed text-stone-800">
			<h2 class="text-2xl font-bold text-ink sm:text-3xl">{s.h2}</h2>
			{s.paras.map((t: string) => <p>{t}</p>)}
		</div>
	</section>
))}

{has(g.stories) && (
	<section class={`${next()} px-4 py-12 sm:px-6 lg:px-8`}>
		<div class="mx-auto max-w-3xl text-stone-800">
			{g.stories_title && <h2 class="text-2xl font-bold text-ink sm:text-3xl">{g.stories_title}</h2>}
			<div class="mt-6 space-y-8">
				{g.stories.filter((s: any) => has(s?.h2) && has(s?.paras)).map((s: any) => (
					<div class="rounded-2xl border border-stone-300 bg-white p-6">
						<h3 class="text-xl font-bold text-ink">{s.h2}</h3>
						{s.paras.map((t: string) => <p class="mt-3 leading-relaxed">{t}</p>)}
					</div>
				))}
			</div>
		</div>
	</section>
)}

{(g.author?.bio || g.publisher?.about) && (
	<section class={`${next()} px-4 py-12 sm:px-6 lg:px-8`}>
		<div class="mx-auto max-w-3xl space-y-6 leading-relaxed text-stone-800">
			{g.author?.bio && (
				<div>
					<h2 class="text-2xl font-bold text-ink sm:text-3xl">{L.author}</h2>
					{g.author.name && <h3 class="mt-3 text-lg font-bold text-ink">{g.author.name}</h3>}
					<p class="mt-2">{g.author.bio}</p>
				</div>
			)}
			{g.publisher?.about && (
				<div>
					<h3 class="text-lg font-bold text-ink">{g.publisher.name || 'Spirit Media Publishing'}</h3>
					<p class="mt-2">{g.publisher.about}</p>
				</div>
			)}
		</div>
	</section>
)}

{g.why && has(g.why.paras) && (
	<section class={`${next()} px-4 py-12 sm:px-6 lg:px-8`}>
		<div class="mx-auto max-w-3xl space-y-4 leading-relaxed text-stone-800">
			<h2 class="text-2xl font-bold text-ink sm:text-3xl">{g.why.title || L.why}</h2>
			{g.why.paras.map((t: string) => <p>{t}</p>)}
		</div>
	</section>
)}

{faq.length > 0 && (
	<section class={`${next()} px-4 py-12 sm:px-6 lg:px-8`}>
		<div class="mx-auto max-w-3xl">
			<h2 class="text-2xl font-bold text-ink sm:text-3xl">{L.faq}</h2>
			<div class="mt-5 divide-y divide-stone-200 rounded-lg border border-stone-300 bg-white">
				{faq.map((f) => (
					<details class="p-4">
						<summary class="cursor-pointer list-none font-semibold text-ink">{f.q}</summary>
						<p class="mt-2 leading-relaxed text-stone-700">{f.a}</p>
					</details>
				))}
			</div>
			<p class="mt-6"><a href="/bookstore/" class="font-semibold text-ink-soft underline underline-offset-2">{L.browse}</a></p>
		</div>
	</section>
)}
