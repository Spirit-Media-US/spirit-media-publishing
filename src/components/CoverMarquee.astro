---
// FHB cover marquee — Kevin 2026-09-24.
//
// "Scrolling marquee of 3D image thumbnails of all FHB covers as shown on /print",
// with the title above and the FATHER | SON | SPIRIT chips under it. The tagline
// moved below the homepage's two buttons 2026-09-24 (Kevin), so it closes the section.
// Kevin ruled 2026-09-24 that the block sits DIRECTLY BELOW THE FOLD, not above it,
// "so it doesn't affect the psi" — the hero above is untouched and stays the LCP element.
//
// Engineering constraints (rules/performance-gate.md, and the job brief):
//   • CSS transform animation only — no JS loop, nothing driving it per frame.
//   • Explicit width/height on every thumbnail so nothing shifts as it loads.
//   • Every thumbnail lazy-loaded: legitimate now that the block is below the fold.
//   • prefers-reduced-motion: reduce → no motion at all; the strip becomes a
//     normal horizontally-scrollable row.
//   • No vh/svh anywhere.
//
// The images are the SAME R2 keys fathersheartbible.com/print serves. No new art is
// rendered and nothing is uploaded — the marquee is a second consumer of what /print
// already shows.
import fs from 'node:fs';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import fhbEditions from '../data/fhb-editions.json';
import VoiceChips from './VoiceChips.astro';

// This repo has no card-art.ts (that resolver lives in the FHB repo). The same R2
// keys are named directly here. These are the keys /print serves today; if FHB
// re-points a card to a new key, this list is the place that follows it.
const BASE = 'https://assets.spiritmediapublishing.com/FHB/print';
const cardUrl = (key: string) =>
	key.startsWith('lp-') ? `${BASE}/lp/v4/${key}-600.webp` : `${BASE}/${key}-600.webp`;
const FHB = 'https://fathersheartbible.com';

// MATCHES THE FHB HOMEPAGE MARQUEE (Kevin 2026-10-07: "SMP marquee showing like FHB marquee"):
// two rows — the audience editions, general colours and Large Print, then every LANGUAGE
// edition running the opposite way with its English name under it — each cover linking to its
// own product page on fathersheartbible.com. Same list, order and row titles as the FHB repo's
// src/components/CoverMarquee.astro.
const DVC = [
	['athletes', "Athlete's Bible"],
	['chosen', 'Chosen Bible'],
	['couples', "Couple's Bible"],
	['dads', "Dad's Bible"],
	['first-responders', "First Responder's Bible"],
	['graduates', "Graduate's Bible"],
	['grandparents', "Grandparent's Bible"],
	['intercessors', "Intercessor's Bible"],
	['mens', "Men's Bible"],
	['moms', "Mom's Bible"],
	['nurses', "Nurse's Bible"],
	['pastors', "Pastor's Bible"],
	['peace', 'Peace Bible'],
	['presidents', "President's Bible"],
	['recovery', 'Recovery Bible'],
	['seekers', "Seeker's Bible"],
	['seventeen', 'Seventeen Bible'],
	['soldiers', "Soldier's Bible"],
	['teachers', "Teacher's Bible"],
	['teen', 'Teen Bible'],
	['womens', "Women's Bible"],
	['worship-leaders', "Worship Leader's Bible"],
	['journaling', 'She Hears Her Father’s Voice Journaling Bible'],
];
const GENERAL = [
	['general-regular-charcoal', 'Charcoal edition'],
	['general-regular-plum', 'Plum edition'],
	['general-regular-white', 'White edition'],
];
const LARGE_PRINT = [
	['lp-vol1', 'Large Print Volume 1'],
	['lp-vol2', 'Large Print Volume 2'],
	['lp-vol3', 'Large Print Volume 3'],
	['lp-set', 'Large Print three-volume set'],
];

// Displayed box is 180 CSS px wide (1.5x the original 120 — Kevin 2026-09-24). The
// source cards are 600 wide, so even a 2x screen draws 360 of 600 available pixels.
// Every card is 600x764 except the 8x10 journaling card (600x725), so height is
// computed from each card's own ratio — a shared number would letterbox it and report
// the wrong aspect to the browser. width/height are the DISPLAY size (180x229 and
// 180x218), which is what protects CLS.
const W = 180;
const H = (key: string) => Math.round((W * (key === 'dvc-journaling' ? 725 : 764)) / 600);
const covers = [
	...DVC.map(([slug, name]) => ({
		key: `dvc-${slug}`,
		name,
		href: `${FHB}/bibles/${slug}-bible/`,
	})),
	...GENERAL.map(([key, name]) => ({ key, name, href: `${FHB}/bibles/fathers-heart-bible/` })),
	...LARGE_PRINT.map(([key, name]) => ({ key, name, href: `${FHB}/bibles/${key}-bible/` })),
].map((c) => ({ ...c, src: cardUrl(c.key), h: H(c.key) }));

// LANGUAGE ROW: the language editions from src/data/fhb-editions.json — the snapshot the
// bookstore build writes from the FHB repo's own edition data (BookstoreBody.astro), so the
// languages, their built-cover cards (360px, as on FHB) and their pages are never retyped here.
// Reverse order because the row travels left-to-right: covers then ARRIVE A→Z (as on FHB).

// Our bible.com partner page: lists every Father's Heart Bible version on YouVersion.
import yvStats from '../data/youversion-stats.json';

const yvFmt = (n: number) => n.toLocaleString('en-US');
// YouVersion counters (Kevin 2026-11-09 "I do want it to show on SMP"): the SAME single source as FHB
// (R2 stats.json); build-time copy via scripts/sync-youversion-stats.mjs, live numbers fetched by the script below.
const yvItems = [
	{ n: yvStats.users, label: 'users', key: 'users' },
	{ n: yvStats.languages, label: 'languages', key: 'languages' },
	{ n: yvStats.countries, label: 'countries', key: 'countries' },
	{ n: Math.round(yvStats.chapters / 100) * 100, label: 'chapters', key: 'chapters' },
];
const YOUVERSION_URL = 'https://www.bible.com/organizations/89162c01-3892-4c7b-a462-239df0931522';
// Kevin 2026-10-30: all 80 languages in every marquee ("Then we just make links go live as links go
// live"). Derived at build time from the FHB repo's own registry/roster (the same source
// BookstoreBody.astro uses), never retyped: every roster language with a BUILT case card gets a cover;
// it LINKS only once its /bibles/<slug>-bible/ page data exists, else the cover shows "Coming soon"
// and is not a link. English is the 80th (plum cover). Without the FHB repo (a Cloudflare build) the
// committed snapshot is used and the count is whatever it holds.
type LangRow = {
	key: string;
	name: string;
	caption: string;
	href: string | null;
	src: string;
	h: number;
};
async function deriveLangRows(): Promise<LangRow[]> {
	const FHB_DATA = '/srv/sites/FHB/src/data';
	const h = H('lang');
	if (fs.existsSync(path.join(FHB_DATA, 'language-editions.ts'))) {
		const load = (f: string) =>
			import(/* @vite-ignore */ pathToFileURL(path.join(FHB_DATA, f)).href);
		const { cardUrl: fhbCard } = await load('card-art.ts');
		const { rosterLanguages, langSlug } = await load('language-editions.ts');
		return (rosterLanguages as any[])
			.filter((l) => l.code !== 'en' && l.card)
			.map((l) => {
				const slug = langSlug(l);
				const built = fs.existsSync(path.join(FHB_DATA, 'editions', `${slug}.json`));
				const english = l.english.replace(/\s*\(.*\)/, '');
				return {
					key: slug,
					name: `${l.name} (${english})`,
					caption: english,
					href: built ? `${FHB}/bibles/${slug}-bible/` : null,
					src: fhbCard(`lang-${l.code}`, 360),
					h,
				};
			});
	}
	return fhbEditions.editions
		.filter((e) => e.group === 'language')
		.map((e) => {
			const [name, ed] = e.display_title.split(' — ');
			const english = ed.replace(/ Edition$/, '');
			return {
				key: e.href,
				name: `${name} (${english})`,
				caption: english,
				href: e.href,
				src: e.img,
				h,
			};
		});
}
const langRows: LangRow[] = [
	...(await deriveLangRows()),
	{
		key: `${FHB}/bibles/fathers-heart-bible/`,
		name: 'English edition',
		caption: 'English',
		href: `${FHB}/bibles/fathers-heart-bible/`,
		src: cardUrl('general-regular-plum'),
		h: H('general-regular-plum'),
	},
];
// Reverse A-Z because the row travels left-to-right: covers then ARRIVE A-Z (as on FHB).
const langCovers = langRows.sort((x, y) => y.caption.localeCompare(x.caption));
// The label is the COMMITMENT (the FHB roster, 80 — Kevin 2026-11-10 "We have committed to 80"),
// not the number of covers drawn: a roster language whose case card is not built yet has no cover.
async function rosterTotal(): Promise<number> {
	const f = path.join('/srv/sites/FHB/src/data', 'language-editions.ts');
	if (!fs.existsSync(f)) return langCovers.length;
	const { rosterLanguages } = await import(/* @vite-ignore */ pathToFileURL(f).href);
	return (rosterLanguages as unknown[]).length;
}
const LANGUAGE_TOTAL = await rosterTotal();

// SPEED IS PER PIXEL, NOT PER LOOP: 100/23 s per cover keeps the 2026-09-24 on-screen speed
// for any row length, both rows.
const SECONDS_PER_COVER = 100 / 23;
const rows = [
	{ covers, reverse: false, label: '25 Audience Editions' }, // Kevin 2026-11-06: "we have 25 editions not 22"
	{ covers: langCovers, reverse: true, label: `${LANGUAGE_TOTAL} Language Editions` },
].filter((r) => r.covers.length > 0);
---

<section class="fhbm" aria-labelledby="fhbm-title">
	<h2 id="fhbm-title" class="fhbm-title">Father&rsquo;s Heart Bible™ + Divine Voice™ Color is Here</h2>
	<p class="fhbm-line type-body-lg text-stone-700">Where other Bibles use &ldquo;God&rdquo; to say what He is, the Father&rsquo;s Heart Bible™ uses &ldquo;our Father&rdquo; to show who He has been all along.</p>

	<!-- YouVersion (Kevin 2026-11-06: "It needs to be with the FHB section. SMP is not on YouVersion
	     rather Father's Heart Bible is"). Thin black banner, as the old top bar (Kevin 2026-11-06). -->
	<div class="fhbm-yvw bg-ink text-sm" data-yv-counters>
		<a class="fhbm-yv text-stone-100 hover:text-white" href={YOUVERSION_URL} target="_blank" rel="noopener">
			<img src="https://assets.spiritmediapublishing.com/FHB/partners/youversion-icon-96.webp" alt="" width="20" height="20" decoding="async" loading="lazy" />
			<span>Now on YouVersion &mdash; read free in the Bible App <span aria-hidden="true">&rarr;</span></span>
			</a>
		<ul class="fhbm-yv-stats" aria-label="Father's Heart Bible on YouVersion, all time">
			{yvItems.map((i) => (
				<li><b data-to={i.n} data-key={i.key}>{yvFmt(i.n)}</b> {i.label}</li>
			))}
		</ul>
	</div>

	<!-- The strip. The track holds the covers TWICE and travels exactly -50%, so the
	     second copy is under the cursor at the moment the first wraps — that is what
	     makes the loop seamless without any JS. aria-hidden on the duplicate (which carries the same real alt — 2yo: Bing flags the minified empty `alt`) so a
	     screen reader hears each cover once. -->
	{rows.map((row) => (
		<>
		<p class="fhbm-label">{row.label}</p>
		<div class="fhbm-viewport">
			<div
				class={row.reverse ? 'fhbm-track fhbm-track--reverse' : 'fhbm-track'}
				style={`animation-duration: ${(row.covers.length * SECONDS_PER_COVER).toFixed(1)}s;`}
			>
				{[0, 1].map((copy) => (
					<ul class="fhbm-row" aria-hidden={copy === 1 ? 'true' : undefined}>
						{row.covers.map((c) => (
							<li>
								{c.href ? (
									<a href={c.href} tabindex={copy === 1 ? -1 : undefined}>
									<img
										src={c.src}
										alt={`Father's Heart Bible — ${c.name}`}
										width={W}
										height={c.h}
										loading="lazy"
										decoding="async"
										fetchpriority="low"
									/>
										{'caption' in c && <span class="fhbm-cap">{c.caption}</span>}
									</a>
								) : (
									<div class="fhbm-soon">
									<img
										src={c.src}
										alt={`Father's Heart Bible — ${c.name}`}
										width={W}
										height={c.h}
										loading="lazy"
										decoding="async"
										fetchpriority="low"
									/>
										<span class="fhbm-cap">{'caption' in c ? c.caption : ''}<em>Coming soon</em></span>
									</div>
								)}
							</li>
						))}
					</ul>
				))}
			</div>
		</div>
		</>
	))}

	<div class="fhbm-chips"><VoiceChips size="1.25rem" class="mb-0" /></div>
</section>

<style>
	.fhbm {
		background-color: #fbeaee;
		padding: 3rem 0 0;
		overflow: hidden;
	}
	@media (min-width: 1024px) {
		.fhbm { padding-top: 4rem; }
	}
	.fhbm-title {
		font-family: var(--font-display);
		color: #1c1917;
		text-align: center;
		margin: 0 1.5rem 2rem;
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.01em;
		font-size: clamp(1.35rem, 3.4vw, 2.5rem);
	}
	/* "On one line" is a desktop requirement. Below 768px a forced single line would
	   shrink the type past legibility, so it wraps there instead (brief, §on one line). */
	@media (min-width: 768px) {
		.fhbm-title { white-space: nowrap; }
	}
	/* Kevin 2026-10-31: the "our Father" line under the title, in the page's body-copy style (type-body-lg). */
	.fhbm-line { text-align: center; max-width: 48rem; margin: -1rem auto 2rem; padding: 0 1.5rem; }
	.fhbm-viewport { overflow: hidden; }
	.fhbm-track {
		display: flex;
		width: max-content;
		will-change: transform;
		/* 100s, not 70s: the 1.5x tiles make the track 200/140 as long, so the duration
		   scales with it to keep the same on-screen speed (~px per second). */
		animation: fhbm-scroll 100s linear infinite;
	}
	.fhbm-row {
		display: flex;
		align-items: flex-end;
		gap: 1.25rem;
		margin: 0;
		padding: 0 0.625rem;
		list-style: none;
	}
	.fhbm-row img {
		display: block;
		width: 180px;
		height: auto;
	}
	/* The language row runs the other way: same keyframes played backwards. */
	.fhbm-track--reverse { animation-direction: reverse; }
	/* Row title: FHB /print's eyebrow style, as on the FHB homepage marquee (one shade darker:
	   #71717a on this pink band is under 4.5:1). */
	.fhbm-label {
		font-family: var(--font-sans);
		color: #52525b;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		text-align: center;
		margin: 0 1.5rem 0.75rem;
	}
	.fhbm-viewport + .fhbm-label { margin-top: 1.75rem; }
	.fhbm-yvw { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; column-gap: 1.5rem; margin: 0 0 1.5rem; line-height: 1.25rem; }
	.fhbm-yv { display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; text-align: center; text-decoration: none; }
	.fhbm-yv img { width: 20px; height: 20px; border-radius: 0.25rem; }
	.fhbm-yv-stats { display: flex; flex-wrap: nowrap; gap: 1.25rem; margin: 0; padding: 0.5rem 1rem; list-style: none; white-space: nowrap; color: #d6d3d1; }
	.fhbm-yv-stats b { font-weight: 700; color: #e4006f; font-variant-numeric: tabular-nums; display: inline-block; text-align: right; }
	.fhbm-yv-stats li:nth-child(1) b { min-width: 6ch; }
	.fhbm-yv-stats li:nth-child(2) b { min-width: 2ch; }
	.fhbm-yv-stats li:nth-child(3) b { min-width: 3ch; }
	.fhbm-yv-stats li:nth-child(4) b { min-width: 7ch; }
	@media (max-width: 1100px) { .fhbm-yvw { flex-direction: column; } .fhbm-yv { padding-bottom: 0; } }
	@media (max-width: 640px) {
		.fhbm-yv-stats { display: grid; grid-template-columns: repeat(2, max-content); justify-content: center; gap: 0.125rem 1.25rem; padding: 0.375rem 0.5rem 0.5rem; }
	}
	@media (max-width: 480px) {
		.fhbm-yv { gap: 0.375rem; padding: 0.5rem 0.5rem 0; font-size: 0.71875rem; white-space: nowrap; overflow: hidden; max-width: 100%; }
		.fhbm-yv > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
		.fhbm-yv img { width: 18px; height: 18px; }
		.fhbm-yv-stats { font-size: 0.8125rem; }
	}
	/* English name under each language cover, centred under the FRONT board (x 24..466 of
	   every 600px language card), as on the FHB homepage. */
	.fhbm-cap {
		display: block;
		margin-top: 0.4rem;
		margin-left: 4%;
		width: 73.67%;
		text-align: center;
		font-family: var(--font-body);
		color: #57534e;
		font-size: 0.8rem;
		line-height: 1.3;
	}
	.fhbm-row a, .fhbm-soon { display: block; text-decoration: none; }
	/* two lines reserved so linked and coming-soon covers bottom-align and nothing shifts */
	.fhbm-cap { min-height: 2.1rem; }
	.fhbm-cap em { display: block; font-style: normal; font-size: 0.7rem; opacity: 0.8; }
	@keyframes fhbm-scroll {
		from { transform: translate3d(0, 0, 0); }
		to { transform: translate3d(-50%, 0, 0); }
	}
	/* No motion for anyone who asked for none: the strip stops and becomes a plain
	   scrollable row so every cover is still reachable. */
	@media (prefers-reduced-motion: reduce) {
		.fhbm-track { animation: none; }
		.fhbm-viewport { overflow-x: auto; }
	}
	.fhbm-chips { margin-top: 2rem; }
</style>

<script>
	// Count-up. Server-rendered text = build-time copy; once the banner is near view fetch the live R2 JSON
	// and count up to THAT. Any failure -> count to the build-time text (never 0, never blank).
	const STATS_URL = 'https://assets.spiritmediapublishing.com/FHB/youversion/stats.json';
	const fmt = (n: number) => n.toLocaleString('en-US');
	const KEYS = ['users', 'languages', 'countries', 'chapters'];
	const live = (j: any) => KEYS.every((k) => Number.isFinite(j?.[k]) && j[k] > 0);
	let pending: Promise<any> | null = null;
	const fetchLive = () => (pending ||= (async () => {
		try {
			const r = await fetch(STATS_URL, { signal: AbortSignal.timeout(3000) });
			const j = r.ok ? await r.json() : null;
			return live(j) ? { ...j, chapters: Math.round(j.chapters / 100) * 100 } : null;
		} catch { return null; }
	})());
	document.querySelectorAll<HTMLElement>('[data-yv-counters]').forEach((root) => {
		const els = [...root.querySelectorAll<HTMLElement>('b[data-to]')];
		if (!els.length || !('IntersectionObserver' in window)) return;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const run = async () => {
			const fresh = await fetchLive();
			const to = els.map((e) => (fresh && fresh[e.dataset.key!]) || Number(e.dataset.to));
			if (reduced) { els.forEach((el, i) => { el.textContent = fmt(to[i]); }); return; }
			const t0 = performance.now(), D = 1200;
			const tick = (now: number) => {
				const p = Math.min(1, (now - t0) / D), e = 1 - Math.pow(1 - p, 3);
				els.forEach((el, i) => { el.textContent = fmt(p >= 1 ? to[i] : Math.round(to[i] * e)); });
				if (p < 1) requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		};
		// Warm the fetch when the banner is within ~400px of view; animate once it is mostly visible.
		const warm = new IntersectionObserver((en) => { if (en.some((x) => x.isIntersecting)) { warm.disconnect(); fetchLive(); } }, { rootMargin: '400px' });
		warm.observe(root);
		const io = new IntersectionObserver((en) => { if (en.some((x) => x.isIntersecting)) { io.disconnect(); run(); } }, { threshold: 0.6 });
		io.observe(root);
	});
</script>
