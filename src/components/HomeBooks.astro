---
// Homepage "Books" section (pmprint, brief pmprint-smp-growth-20261116 #2): the bookstore + the newest LIVE book pages.
// Derived on every build: the 8 most recent pub dates among src/data/books/pages-live.json slugs (the BOOK PAGES
// SWITCH, so a link here is always a built page), covers from the pre-sized R2 set (src/data/books/cover-sized.json).
// Below the fold: lazy images with explicit dimensions, no animation, no new fonts (performance-gate traits).
import sized from '../data/books/cover-sized.json';
import pagesLive from '../data/books/pages-live.json';
import set from '../data/books/shipset-v2.json';

const COUNT = 8;
const live = new Set(pagesLive.slugs as string[]);
const covers = (sized as Record<string, any>).covers;
const books = (set.titles as any[])
	.filter(
		(t) =>
			live.has(t.slug) && covers[t.slug]?.w300 && /^\d{4}-\d{2}-\d{2}$/.test(t.book.pub_date ?? ''),
	)
	.sort((a, b) => b.book.pub_date.localeCompare(a.book.pub_date))
	.slice(0, COUNT)
	.map((t) => ({
		href: `/books/${t.slug}/`,
		title: t.book.title as string,
		author: t.book.author?.name as string,
		src: covers[t.slug].w300 as string,
		h: Math.round((300 * covers[t.slug].height) / covers[t.slug].width),
	}));
---

<section class="bg-stone-50 px-6 py-12 lg:py-20 lg:px-8" aria-labelledby="home-books-heading">
	<div class="mx-auto max-w-7xl">
		<div class="text-center mb-10">
			<span class="eyebrow eyebrow-red">Books</span>
			<h2 id="home-books-heading" class="type-section-heading text-ink-soft">New from Spirit Media Authors</h2>
			<p class="type-body mt-2 text-stone-700">Order direct from our <a href="/bookstore/" class="underline hover:text-red">bookstore</a>, with free shipping in the US.</p>
		</div>
		<ul class="grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-4">
			{
				books.map((b) => (
					<li>
						<a href={b.href} class="group block">
							<span class="mx-auto flex aspect-[2/3] w-full max-w-[180px] items-end justify-center">
							<img
								src={b.src}
								alt={`Cover of ${b.title} by ${b.author}`}
								width="300"
								height={b.h}
								loading="lazy"
								decoding="async"
								class="h-auto max-h-full w-auto max-w-full rounded shadow-sm transition-shadow group-hover:shadow-md"
							/>
							</span>
							<span class="mt-3 block text-center type-card-subheading text-ink-soft group-hover:text-red transition-colors">{b.title}</span>
							<span class="mt-1 block text-center type-caption text-stone-600">{b.author}</span>
						</a>
					</li>
				))
			}
		</ul>
		<div class="mt-10 text-center">
			<a href="/bookstore/" class="btn btn-primary">Visit the Bookstore →</a>
		</div>
	</div>
</section>
