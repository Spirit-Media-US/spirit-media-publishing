---
import { destHtml, SISTER_HOST } from '../lib/xsite';
// THE ORDER AREA ON AN SMP BOOK PAGE (/books/<slug>/#order), mirroring the approved FHB edition-page order area
// (FHB src/components/EditionOrder.astro + OrderSummary.astro, grandparents-bible, Kevin 2026-11-14/15):
//   offer line centered -> full-width black country marquee (~2s per country, A-Z, data-nosnippet moving copies,
//   reduced-motion stops it) -> four compact choices ABOVE the box (white items, gray frame, gray text) -> the box:
//   one row per format with its own quantity, the price everyone pays first, an itemized summary, Total, Ship to under
//   Total, Checkout in SMP's own primary button style, and a "Contact us" BUTTON (MailtoLink: an address is
//   never printed, Kevin 2026-11-15 "We do not post our emails ... mailto: show a button not the email").
// Nothing here is commerce: prices are the engine's registry rows, the countries are the ones the engine itself sells
// this book to (asked in the page's getStaticPaths), the per-copy handling fee is the engine's marginGuard figure, and
// the POST is the existing /store-checkout. The server stays authoritative.
// English only for now: es/fr book pages keep their reviewed-string form until their own strings exist.
import MailtoLink from './MailtoLink.astro';

interface Props {
	slug: string;
	title: string;
	/** the title's cover colour style (src/data/books/cover-colors.json), or undefined = ink */
	titleStyle?: string;
	formats: { sku: string; format: string; list_cents: number }[];
	/** the countries the engine sells ALL these formats to, engine order */
	countries: { code: string; name: string }[];
	/** { list: {sku: cents}, fee: {country: {sku: cents}} } */
	feeCfg: string;
	/** the engine lets these SKUs take the first-order 15% (books: false today, Kevin 2026-11-10) */
	firstOrder: boolean;
	firstOrderPct: number;
	returnDays: number;
	/** page language: es/fr pages get the same box in their language (Kevin 2026-11-15 "2A") */
	lang?: 'en' | 'es' | 'fr';
	/** the book's eBook on sale from our store today (engine ebookForBook), or undefined. With no print formats the box
	 *  is EBOOK-ONLY: email field + the 15% offer line, no shipping line, no marquee, no Ship to (Kevin 2026-11-16 "We point
	 *  to our own ebook sales"). Beside print it is one more row, chosen INSTEAD of print (an eBook checks out alone). */
	ebook?: { sku: string; list_cents: number };
	/** PRE-ORDER (book-skus.json ship_after, Kevin 2026-11-24 MMFI): the release date as text ("January 7, 2027") when a
	 *  format here sells as a pre-order; the box then says when it ships and the button reads "Preorder Now". English only. */
	preorder?: string;
}
const {
	slug,
	title,
	titleStyle,
	formats,
	countries,
	feeCfg,
	firstOrder,
	firstOrderPct,
	returnDays,
	lang = 'en',
	ebook,
	preorder,
} = Astro.props;
const ebookOnly = formats.length === 0 && Boolean(ebook);
// THE BOX'S WORDS per language (Kevin 2026-11-15 "2A": "from the wording those pages already use"). es/fr come from the
// SMP es/fr book pages' own strings (Enviar a, Pagar, Total, Envío y manejo) and FHB's order-strings/{es,fr}.json
// (offer, shipping, guarantee title, Correo electrónico, messages); the few lines neither had are marked DRAFT for a
// native reviewer. Country names come from the standard CLDR data (Intl.DisplayNames), never translated by hand.
const L = {
	en: {
		ship: 'Free standard shipping to {n} countries',
		ship1: 'Free standard shipping in the {c}',
		offer: '{pct}% off first order + {ship}',
		soon: 'Ships to more countries soon.',
		fee: 'Outside the United States any international handling fee for your country is shown on the order form before checkout.',
		guar: 'Your purchase is guaranteed',
		guarBody:
			'If anything isn’t right with your order, for any reason, let us know within {d} days of delivery and we will make it right.',
		guarLink: 'Read our guarantee →',
		multi: 'Ordering more than one book?',
		browse: 'Browse the Spirit Media bookstore →',
		order: 'Order {t}',
		first: '{p} on your first order',
		fewer: 'One fewer {f}',
		more: 'One more {f}',
		qty: '{f} quantity',
		handling: 'Shipping & handling',
		total: 'Total',
		shipTo: 'Ship to',
		email: 'Email',
		hint: 'For your receipt, and to check your first-order saving.',
		note: 'Free standard shipping · tax calculated at checkout',
		checkout: 'Checkout →',
		contact: 'Contact us',
		keep: 'Keep shopping',
		save: 'First order? -{a} ({pct}%) comes off at checkout',
		choose: 'Choose at least one copy.',
		ebook: 'eBook',
		ebookRow: 'Instant download · DRM-free EPUB',
		ebookNote: 'Instant download after checkout · tax calculated at checkout',
		ebookOffer: '{pct}% off first order',
		closed: 'Checkout is not open yet.',
		error: 'Something went wrong. Please try again.',
	},
	es: {
		ship: 'Envío estándar gratis a {n} países',
		ship1: 'Envío estándar gratis',
		offer: '{pct} % de descuento en tu primer pedido + {ship}',
		soon: 'Pronto enviaremos a más países.',
		fee: 'Fuera de Estados Unidos, la tarifa de gestión internacional de tu país se muestra en el formulario antes de pagar.',
		guar: 'Tu compra está garantizada',
		guarBody:
			'Si algo no está bien con tu pedido, por cualquier motivo, avísanos dentro de los {d} días posteriores a la entrega y lo solucionaremos.',
		guarLink: 'Lee nuestra garantía →',
		multi: '¿Pides más de un libro?',
		browse: 'Ver la librería de Spirit Media →',
		order: 'Pide {t}',
		first: '{p} en tu primer pedido',
		fewer: 'Un ejemplar menos de {f}',
		more: 'Un ejemplar más de {f}',
		qty: '{f}: cantidad',
		handling: 'Envío y manejo',
		total: 'Total',
		shipTo: 'Enviar a',
		email: 'Correo electrónico',
		hint: 'Para tu recibo y para comprobar tu descuento de primer pedido.',
		note: 'Envío estándar gratis · impuestos calculados al pagar',
		checkout: 'Pagar →',
		contact: 'Contáctanos',
		keep: 'Seguir comprando',
		save: '¿Primer pedido? -{a} ({pct} %) se descuenta al pagar',
		choose: 'Elige al menos un ejemplar para continuar.',
		ebook: 'eBook',
		ebookRow: 'Descarga inmediata · EPUB sin DRM',
		ebookNote: 'Descarga inmediata tras el pago · impuestos calculados al pagar',
		ebookOffer: '{pct} % de descuento en tu primer pedido',
		closed: 'El pedido directo se abrirá pronto; vuelve a visitarnos.',
		error: 'Lo sentimos, algo salió mal. Inténtalo de nuevo.',
	},
	fr: {
		ship: 'Livraison standard gratuite dans {n} pays',
		ship1: 'Livraison standard gratuite',
		offer: '{pct} % de réduction sur votre première commande + {ship}',
		soon: 'Livraison bientôt dans d’autres pays.',
		fee: 'Hors des États-Unis, les frais de traitement internationaux de votre pays sont indiqués sur le bon de commande avant le paiement.',
		guar: 'Votre achat est garanti',
		guarBody:
			'Si quelque chose ne va pas avec votre commande, pour quelque raison que ce soit, prévenez-nous dans les {d} jours suivant la livraison et nous arrangerons les choses.',
		guarLink: 'Lire notre garantie →',
		multi: 'Vous commandez plus d’un livre ?',
		browse: 'Voir la librairie Spirit Media →',
		order: 'Commander : {t}',
		first: '{p} sur votre première commande',
		fewer: 'Un exemplaire de moins : {f}',
		more: 'Un exemplaire de plus : {f}',
		qty: '{f} : quantité',
		handling: 'Livraison et manutention',
		total: 'Total',
		shipTo: 'Pays de livraison',
		email: 'E-mail',
		hint: 'Pour votre reçu et pour vérifier votre réduction de première commande.',
		note: 'Livraison standard gratuite · taxes calculées au paiement',
		checkout: 'Passer au paiement →',
		contact: 'Nous contacter',
		keep: 'Continuer vos achats',
		save: 'Première commande ? -{a} ({pct} %) déduits au paiement',
		choose: 'Choisissez au moins un exemplaire pour continuer.',
		ebook: 'Livre numérique',
		ebookRow: 'Téléchargement immédiat · EPUB sans DRM',
		ebookNote: 'Téléchargement immédiat après le paiement · taxes calculées au paiement',
		ebookOffer: '{pct} % de réduction sur votre première commande',
		closed: 'La commande directe ouvrira bientôt — merci de revenir plus tard.',
		error: 'Désolé, une erreur s’est produite. Veuillez réessayer.',
	},
}[lang];
const fill = (t: string, v: Record<string, string | number>) =>
	t.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
const DN = new Intl.DisplayNames([lang], { type: 'region' });
const cname = (c: { code: string; name: string }) =>
	lang === 'en' ? c.name : (DN.of(c.code) ?? c.name);
const FMT: Record<string, Record<string, string>> = {
	es: { Paperback: 'Tapa blanda', Hardback: 'Tapa dura', Hardcover: 'Tapa dura' },
	fr: { Paperback: 'Broché', Hardback: 'Relié', Hardcover: 'Relié' },
};
const fmtName = (f: string) => FMT[lang]?.[f] ?? f;
const money = (c: number) => `$${(c / 100).toFixed(2)}`;
const n = countries.length;
const names = countries.map(cname).sort((a, b) => a.localeCompare(b, lang));
const shipLine =
	n > 1
		? fill(L.ship, { n })
		: lang === 'en'
			? fill(L.ship1, { c: names[0] ?? 'United States' })
			: L.ship1;
// ONE-LINE SWITCH (15% wording): it follows the engine. When the engine lets books take the first-order discount,
// firstOrder is true and the offer line, the per-row first-order price and the summary line appear by themselves.
const offerLine = ebookOnly
	? fill(L.ebookOffer, { pct: firstOrderPct })
	: firstOrder
		? fill(L.offer, {
				pct: firstOrderPct,
				ship: shipLine.charAt(0).toLowerCase() + shipLine.slice(1),
			})
		: shipLine;
const feeTable = (JSON.parse(feeCfg).fee ?? {}) as Record<string, Record<string, number>>;
const anyFee = Object.values(feeTable).some((row) => Object.values(row).some((c) => c > 0));
const firstUnit = (c: number) => Math.round((c * (100 - firstOrderPct)) / 100);
---
<p class="bo-offer">{offerLine}</p>
{!ebookOnly && (
<div class="bo-marquee" role="region" aria-label={shipLine}>
	<p class="bo-sr">{names.join(', ')}</p>
	{n > 1 ? (
		<div class="bo-marquee__track" aria-hidden="true" data-nosnippet style={`--bo-marquee-dur: ${n * 2}s;`}>
			{[0, 1].map(() => (
				<ul class="bo-marquee__list">
					{names.map((x) => <li>{x}</li>)}
				</ul>
			))}
		</div>
	) : (
		<ul class="bo-marquee__list bo-marquee__list--still" aria-hidden="true" data-nosnippet>
			{names.map((x) => <li>{x}</li>)}
		</ul>
	)}
</div>
)}
<form id="order" class="bo-wrap" data-box data-slug={slug} data-status={ebookOnly ? 'ebook' : 'live'} data-ebook={ebook?.sku} data-fees={feeCfg} data-first={firstOrder ? firstOrderPct : 0} data-msgs={JSON.stringify({ save: L.save, choose: L.choose, closed: L.closed, error: L.error })}>
	<div class="bo-acc">
		{!ebookOnly && (
		<details class="bo-acc__item">
			<summary data-choice>{shipLine}</summary>
			<div class="bo-acc__body">
				<p>{shipLine}.</p>
				<ul class="bo-bubbles" aria-label={shipLine}>
					{names.map((x) => <li class="bo-bubble">{x}</li>)}
				</ul>
				{n === 1 && <p>{L.soon}</p>}
				{anyFee && <p>{L.fee}</p>}
			</div>
		</details>
		)}
		<details class="bo-acc__item">
			<summary data-choice>{L.guar}</summary>
			<div class="bo-acc__body">
				<p>{fill(L.guarBody, { d: returnDays })}</p>
				<p><a href="/returns/">{L.guarLink}</a></p>
			</div>
		</details>
		<details class="bo-acc__item">
			<summary data-choice>{L.multi}</summary>
			<div class="bo-acc__body">
				<p><a href="/bookstore/">{L.browse}</a></p>
			</div>
		</details>
		{/* "Buying 10 or more?" is omitted: the engine gives books no volume ladder (DISCOUNT_EXEMPT). */}
	</div>
	<div class="bo-box">
		<h2 class="bo-title" style={titleStyle}>{fill(L.order, { t: title })}</h2>
		<div class="bo-rows">
			{formats.map((f, i) => (
				<div class="bo-row" data-line-sku={f.sku}>
					<div class="bo-row__info">
						<span class="bo-row__binding">{fmtName(f.format)}</span>
						<b class="bo-row__list">{money(f.list_cents)}</b>
						{firstOrder && <span class="bo-row__first">{fill(L.first, { p: money(firstUnit(f.list_cents)) })}</span>}
					</div>
					<div class="bo-qty">
						<button type="button" class="bo-step" data-step="-1" data-sku={f.sku} aria-label={fill(L.fewer, { f: fmtName(f.format) })}>−</button>
						<input class="bo-qty__in" type="number" inputmode="numeric" name={f.sku} min="0" max="999" value={i === 0 ? '1' : '0'} aria-label={fill(L.qty, { f: fmtName(f.format) })} />
						<button type="button" class="bo-step" data-step="1" data-sku={f.sku} aria-label={fill(L.more, { f: fmtName(f.format) })}>+</button>
					</div>
				</div>
			))}
			{ebook && (
				<div class="bo-row bo-row--ebook" data-line-sku={ebook.sku}>
					<div class="bo-row__info">
						<span class="bo-row__binding">{L.ebook}</span>
						<b class="bo-row__list">{money(ebook.list_cents)}</b>
						{firstOrderPct > 0 && <span class="bo-row__first">{fill(L.first, { p: money(firstUnit(ebook.list_cents)) })}</span>}
						<span class="bo-row__note">{L.ebookRow}</span>
					</div>
					<div class="bo-qty">
						<button type="button" class="bo-step" data-step="-1" data-sku={ebook.sku} aria-label={fill(L.fewer, { f: L.ebook })}>−</button>
						<input class="bo-qty__in" type="number" inputmode="numeric" name={ebook.sku} min="0" max="1" value={ebookOnly ? '1' : '0'} data-ebook-in aria-label={fill(L.qty, { f: L.ebook })} />
						<button type="button" class="bo-step" data-step="1" data-sku={ebook.sku} aria-label={fill(L.more, { f: L.ebook })}>+</button>
					</div>
				</div>
			)}
		</div>
		<div class="bo-panel">
			<ul class="bo-items" data-items></ul>
			<dl class="bo-lines">
				<div data-fee-line hidden><dt>{L.handling}</dt><dd data-fee>$0.00</dd></div>
				<div class="bo-total"><dt>{L.total}</dt><dd data-total aria-live="polite">{money(formats[0]?.list_cents ?? ebook?.list_cents ?? 0)}</dd></div>
			</dl>
			{(firstOrder || ebook) && <p class="bo-first" data-first-save hidden></p>}
			{!ebookOnly && (
			<div data-ship>
			<label class="bo-label" for={`bo-${slug}-country`}>{L.shipTo}</label>
			<select id={`bo-${slug}-country`} name="country" class="bo-select" autocomplete="country">
				{[...countries].sort((a, b) => (a.code === 'US' ? -1 : b.code === 'US' ? 1 : 0)).map((c) => <option value={c.code} selected={c.code === 'US'}>{cname(c)}</option>)}
			</select>
			</div>
			)}
			{/* a first order can only be recognised by its email (the engine's isFirstOrder): the FHB edition box asks the same way */}
			<label class="bo-label" for={`bo-${slug}-email`}>{L.email}</label>
			{(firstOrder || ebook) && <p class="bo-hint" id={`bo-${slug}-email-hint`}>{L.hint}</p>}
			<input id={`bo-${slug}-email`} class="bo-select" type="email" name="email" autocomplete="email" inputmode="email" required aria-describedby={firstOrder || ebook ? `bo-${slug}-email-hint` : undefined} data-email />
		</div>
		<p class="bo-note" data-note data-print-note={ebookOnly ? undefined : L.note} data-ebook-note={L.ebookNote}>{ebookOnly ? L.ebookNote : L.note}</p>
		{preorder && <p class="bo-preorder" data-preorder>Pre-order: your payment is taken today and your book ships at release, target {preorder}.</p>}
		<button type="submit" class="bo-checkout">{preorder ? 'Preorder Now →' : L.checkout}</button>
		<p id="buy-msg" class="bo-msg" role="status"></p>
		<p class="bo-help"><MailtoLink email="hello@spiritmediapublishing.com" class="bo-help-btn">{L.contact}</MailtoLink></p>
	</div>
</form>
<nav class="bo-shop" aria-label={L.keep}>
	<span class="bo-shop__label">{L.keep}</span>
	<a href="https://fathersheartbible.com/print/">FH Bibles <Fragment set:html={destHtml(SISTER_HOST)} /></a>
	<a href="https://fathersheartbible.com/books/">FH Books <Fragment set:html={destHtml(SISTER_HOST)} /></a>
	<a href="/bookstore/smp-worldwide/">All SMP Books</a>
</nav>

<style>
	/* MOBILE FIRST, the FHB edition-page order area (EditionOrder.astro) in SMP's charcoal. */
	.bo-offer { margin: 1.6rem auto 0; padding: 0 1rem; text-align: center; color: var(--color-red-deep, #9b2d20); font-size: 1rem; font-weight: 700; }
	.bo-marquee { position: relative; margin: 0.8rem 0 0; background: #1a1714; color: #f5f5f4; overflow: hidden; font-size: 1rem; line-height: 1.4rem; font-weight: 600; }
	.bo-marquee__track { display: flex; width: max-content; animation: bo-marquee var(--bo-marquee-dur, 446s) linear infinite; }
	.bo-marquee__list { display: flex; margin: 0; padding: 0.5rem 0; list-style: none; white-space: nowrap; }
	.bo-marquee__list li { padding: 0 1.1rem; }
	.bo-marquee__list li::after { content: '•'; margin-left: 2.2rem; color: #e4006f; }
	.bo-marquee__list--still { justify-content: center; }
	.bo-marquee__list--still li::after { content: none; }
	.bo-marquee:hover .bo-marquee__track { animation-play-state: paused; }
	@keyframes bo-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
	@media (prefers-reduced-motion: reduce) { .bo-marquee__track { animation: none; flex-wrap: wrap; width: auto; } }
	.bo-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
	.bo-wrap { max-width: 34rem; margin: 2.2rem auto 0; padding: 0 1rem; scroll-margin-top: 110px; color: var(--color-ink); box-sizing: content-box; }
	.bo-acc { display: grid; gap: 0.4rem; }
	.bo-acc__item { background: #fff; border: 1px solid #c4c4cc; border-radius: 0.7rem; overflow: hidden; }
	.bo-acc__item > summary { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-height: 44px; padding: 0.35rem 0.85rem; color: #3f3f46; font-size: 0.85rem; font-weight: 600; cursor: pointer; list-style: none; }
	.bo-acc__item > summary::-webkit-details-marker { display: none; }
	.bo-acc__item > summary::after { content: '+'; flex: none; font-size: 1.2rem; font-weight: 400; color: #71717a; }
	.bo-acc__item[open] > summary::after { content: '−'; }
	.bo-acc__body { padding: 0.7rem 0.85rem 0.4rem; color: #3f3f46; font-size: 0.85rem; line-height: 1.5; }
	.bo-acc__body p { margin: 0 0 0.5rem; }
	.bo-acc__body a { color: #3f3f46; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
	.bo-bubbles { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0 0 0.6rem; padding: 0; }
	.bo-bubble { font-size: 0.8rem; color: #52525b; background: #fbe7f0; border: 1px solid #f0c4d8; border-radius: 999px; padding: 0.25rem 0.7rem; }
	.bo-box { margin: 1.1rem 0 0; padding: 1rem 0.9rem 0.95rem; background: #fff; border: 1px solid var(--color-border, #ddd7cf); border-radius: 1rem; }
	.bo-title { margin: 0 0 0.2rem; color: var(--color-ink); font-size: 1.35rem; font-weight: 700; line-height: 1.25; }
	.bo-rows { display: grid; gap: 0.6rem; margin-top: 0.9rem; }
	.bo-row { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; padding: 0.55rem 0.7rem; background: #fbf1f6; border: 1px solid #efd3e1; border-radius: 0.75rem; }
	.bo-row__info { display: flex; flex-direction: column; min-width: 0; line-height: 1.35; }
	.bo-row__binding { font-size: 0.95rem; font-weight: 600; }
	.bo-row__list { font-size: 1.05rem; font-weight: 800; color: var(--color-ink); }
	.bo-row__first { color: #9d174d; font-size: 0.8rem; font-weight: 600; }
	.bo-row__note { color: #57534e; font-size: 0.78rem; }
	[data-ship][hidden] { display: none; }
	.bo-qty { display: inline-flex; flex: none; align-items: center; gap: 0.35rem; }
	.bo-step { width: 44px; height: 44px; border: 1.5px solid #d9d0c4; border-radius: 999px; background: #fff; color: var(--color-ink); font-size: 1.2rem; line-height: 1; cursor: pointer; }
	.bo-qty__in { width: 2.75rem; min-height: 44px; background: #fff; border: 1.5px solid #d9d0c4; border-radius: 0.6rem; font: inherit; font-size: 1rem; text-align: center; -moz-appearance: textfield; }
	.bo-qty__in::-webkit-inner-spin-button, .bo-qty__in::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
	.bo-step:focus-visible, .bo-qty__in:focus-visible, .bo-select:focus-visible, .bo-checkout:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
	.bo-panel { margin-top: 0.9rem; padding: 0.2rem 0.8rem 0.8rem; background: #f6f6f8; border-radius: 0.75rem; }
	.bo-items { list-style: none; margin: 0.6rem 0 0; padding: 0; font-size: 0.9rem; }
	.bo-items :global(li) { display: flex; justify-content: space-between; gap: 1rem; line-height: 1.7; }
	.bo-lines { margin: 0.7rem 0 0; padding: 0.6rem 0 0; border-top: 1px solid #e4e4e7; }
	.bo-lines > div { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; line-height: 1.7; }
	.bo-lines > div[hidden] { display: none; }
	.bo-lines dt, .bo-lines dd { margin: 0; }
	.bo-total { font-weight: 700; }
	.bo-total dd { font-size: 1.5rem; line-height: 1.3; }
	.bo-first { margin: 0.1rem 0 0; color: #9d174d; font-size: 0.88rem; font-weight: 700; text-align: right; }
	.bo-first[hidden] { display: none; }
	.bo-preorder { margin: 0.6rem 0 0; color: var(--color-ink, #1c1917); font-size: 0.95rem; font-weight: 600; text-align: center; }
	.bo-hint { margin: 0 0 0.3rem; font-size: 0.8rem; color: #57534e; }
	.bo-label { display: block; margin: 0.6rem 0 0.3rem; font-size: 0.85rem; font-weight: 600; }
	.bo-select { box-sizing: border-box; width: 100%; min-height: 44px; padding: 0.55rem 0.8rem; border: 1.5px solid #d9d0c4; border-radius: 0.6rem; background: #fff; font: inherit; font-size: 1rem; }
	.bo-note { margin: 0.4rem 0 0; color: #57534e; font-size: 0.78rem; }
	/* SMP's own primary button (global .btn-primary: --color-red, hover --color-red-deep). Kevin 2026-11-14: "We don't
	   use black buttons. KNOW your site! Know and follow SMP style." */
	.bo-checkout { width: 100%; margin-top: 0.75rem; min-height: 48px; padding: 0.7rem 1.8rem; border: 2px solid var(--color-red, #c0392b); border-radius: 999px; background: var(--color-red, #c0392b); color: var(--color-surface, #fff); font: inherit; font-weight: 600; font-size: 1rem; cursor: pointer; }
	.bo-checkout:hover { background: var(--color-red-deep, #9b2d20); border-color: var(--color-red-deep, #9b2d20); }
	.bo-checkout:disabled { opacity: 0.6; cursor: wait; }
	.bo-msg { margin: 0.5rem 0 0; color: #57534e; font-size: 0.85rem; }
	.bo-msg:empty { display: none; }
	.bo-help { margin: 0.6rem 0 0; text-align: center; }
	.bo-help :global(.bo-help-btn) { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.2rem; border: 2px solid var(--color-red, #c0392b); border-radius: 999px; background: transparent; color: var(--color-red, #c0392b); font-size: 0.85rem; font-weight: 600; text-decoration: none; } /* SMP .btn-ghost */
	.bo-shop { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.5rem; max-width: 34rem; margin: 1rem auto 0; padding: 0 1rem; }
	.bo-shop__label { width: 100%; text-align: center; font-size: 0.85rem; font-weight: 600; color: #3f3f46; }
	.bo-shop a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border: 1px solid #f0c4d8; border-radius: 999px; background: #fbe7f0; color: #52525b; font-size: 0.88rem; font-weight: 600; text-decoration: none; }
	.bo-shop a:hover { border-color: var(--color-ink); }
	@media (min-width: 641px) { .bo-box { padding: 1.25rem 1.25rem 1.1rem; } }
</style>

<script>
	// The same arithmetic the server charges: list x qty + the country's per-copy handling fee x qty.
	for (const form of document.querySelectorAll<HTMLFormElement>('form[data-box]')) {
		const cfg = JSON.parse(form.dataset.fees || '{"list":{},"fee":{}}') as {
			list: Record<string, number>;
			fee: Record<string, Record<string, number>>;
		};
		// an eBook row counts the first-order 15% too (the engine applies it to eBooks)
		const pct = Number(form.dataset.first || 0) || (form.dataset.ebook ? 15 : 0);
		const ebookIn = form.querySelector<HTMLInputElement>('[data-ebook-in]');
		const msgs = JSON.parse(form.dataset.msgs || '{}') as Record<string, string>;
		const cents = (c: number) => `$${(c / 100).toFixed(2)}`;
		const sel = form.querySelector('select[name=country]') as HTMLSelectElement | null;
		const inputs = [...form.querySelectorAll<HTMLInputElement>('input[type=number]')];
		const qty = (i: HTMLInputElement) =>
			Math.max(0, Math.min(i === ebookIn ? 1 : 999, Math.floor(Number(i.value) || 0)));
		// An eBook checks out on its own (nothing ships): choosing it clears print, choosing print clears it.
		const exclusive = (changed: HTMLInputElement) => {
			if (!ebookIn || qty(changed) < 1) return;
			for (const i of inputs) if ((changed === ebookIn) !== (i === ebookIn)) i.value = '0';
		};
		const label = (i: HTMLInputElement) =>
			(i.closest('.bo-row')?.querySelector('.bo-row__binding')?.textContent ?? i.name).trim();
		const render = () => {
			let sub = 0;
			let fees = 0;
			const items = form.querySelector('[data-items]') as HTMLElement;
			items.replaceChildren();
			for (const i of inputs) {
				const q = qty(i);
				if (!q) continue;
				const line = q * (cfg.list[i.name] ?? 0);
				sub += line;
				fees += q * (sel ? (cfg.fee[sel.value]?.[i.name] ?? 0) : 0);
				const li = document.createElement('li');
				const a = document.createElement('span');
				a.textContent = `${q} × ${label(i)}`;
				const b = document.createElement('span');
				b.textContent = cents(line);
				li.append(a, b);
				items.append(li);
			}
			(form.querySelector('[data-fee]') as HTMLElement).textContent = cents(fees);
			(form.querySelector('[data-fee-line]') as HTMLElement).hidden = fees <= 0;
			(form.querySelector('[data-total]') as HTMLElement).textContent = cents(sub + fees);
			const eb = Boolean(ebookIn && qty(ebookIn) > 0);
			const ship = form.querySelector<HTMLElement>('[data-ship]');
			if (ship) ship.hidden = eb;
			const note = form.querySelector<HTMLElement>('[data-note]');
			if (note && ebookIn) note.textContent = (eb ? note.dataset.ebookNote : note.dataset.printNote) ?? '';
			const save = form.querySelector<HTMLElement>('[data-first-save]');
			if (save) {
				const off = sub - Math.round((sub * (100 - pct)) / 100);
				save.hidden = !(pct > 0 && off > 0);
				save.textContent = msgs.save.replace('{a}', cents(off)).replace('{pct}', String(pct));
			}
		};
		for (const b of form.querySelectorAll<HTMLButtonElement>('[data-step]')) {
			b.addEventListener('click', () => {
				const i = form.querySelector<HTMLInputElement>(`input[name="${b.dataset.sku}"]`);
				if (!i) return;
				i.value = String(Math.max(0, Math.min(i === ebookIn ? 1 : 999, qty(i) + Number(b.dataset.step))));
				exclusive(i);
				render();
			});
		}
		form.addEventListener('input', (ev) => {
			if (ev.target instanceof HTMLInputElement && inputs.includes(ev.target)) exclusive(ev.target);
			render();
		});
		sel?.addEventListener('change', render);
		render();
		form.addEventListener('submit', async (ev) => {
			ev.preventDefault();
			const msg = form.querySelector('#buy-msg') as HTMLElement;
			const counts: Record<string, number> = {};
			for (const i of inputs) counts[i.name] = qty(i);
			if (!Object.values(counts).some((x) => x > 0)) {
				msg.textContent = msgs.choose;
				return;
			}
			const q = new URLSearchParams(location.search);
			const utm = Object.fromEntries(
				['source', 'medium', 'campaign', 'content']
					.map((k) => [k, q.get(`utm_${k}`) ?? ''])
					.filter(([, v]) => v),
			);
			const site =
				({ 'fathersheartbible.com': 'fhb', 'vaneure.com': 'vaneure' } as Record<string, string>)[utm.source ?? ''] ??
				'smp';
			(window as any).gtag?.('event', 'begin_checkout', {
				currency: 'USD',
				items: Object.entries(counts)
					.filter(([, x]) => x > 0)
					.map(([id, x]) => ({ item_id: id, quantity: x })),
			});
			msg.textContent = '';
			const btn = form.querySelector('.bo-checkout') as HTMLButtonElement;
			btn.disabled = true;
			try {
				const r = await fetch('/store-checkout', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ counts, country: sel?.value ?? 'US', email: (form.querySelector('[data-email]') as HTMLInputElement | null)?.value.trim() ?? '', returnPath: `/books/${form.dataset.slug}/`, site, utm }),
				});
				const j = await r.json();
				if (j.url) {
					location.href = j.url;
					return;
				}
				msg.textContent =
					j.message || (j.disabled ? msgs.closed : msgs.error);
			} catch {
				msg.textContent = msgs.error;
			}
			btn.disabled = false;
		});
	}
</script>
