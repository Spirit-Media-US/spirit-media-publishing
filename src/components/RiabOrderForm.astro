---
// The RAISED IN A BARN order form: ONE copy, used by /checkout/raised-in-a-barn/ (full SMP page) and
// /checkout/raised-in-a-barn/embed/ (form only, iframed on raisedinabarn.org/buy, Kevin 2026-11-20 ~05:00Z "needs our SMP
// order form without the discount"). Prices and tiers come from src/lib/riabOrder.ts, the module /store-checkout charges
// with. NO FIRST-ORDER 15% on RIAB (Kevin 11-20): below 25 copies = list price; the bulk ladder starts at 25.
//   ?f=hb | ?f=pb [&signed=1] [&qty=N]  preselect;  ?order=canceled  shows "nothing was charged"
// embed: links open in the TOP window, Stripe Checkout opens in the TOP window, and the frame height is posted to the
// parent as {riabHeight: n} so raisedinabarn.org sizes the iframe with no inner scrollbar.
import {
	RIAB_DESIGNATIONS,
	RIAB_GIFT_COPY,
	RIAB_GIFT_UI_OPEN,
	RIAB_HB,
	RIAB_PB,
	RIAB_RETURN_PATH,
	RIAB_TIERS,
	riabList,
	STRIPE_CARD_BP,
} from '../lib/riabOrder.ts';

interface Props {
	embed?: boolean;
}
const { embed = false } = Astro.props;
const top = embed ? '_top' : undefined;
const money = (c: number) => `$${(c / 100).toFixed(2)}`;
const unit = (c: number, p: number) => Math.round((c * (100 - p)) / 100);
const list = { hb: riabList(RIAB_HB), pb: riabList(RIAB_PB) };
const tiersAsc = [...RIAB_TIERS].sort((a, b) => a.min - b.min);
const cfg = JSON.stringify({
	list: { [RIAB_HB]: list.hb, [RIAB_PB]: list.pb },
	tiers: RIAB_TIERS,
	feeBp: STRIPE_CARD_BP,
});
const picks = [25, 50, 100, 250];
const rows = [
	{ sku: RIAB_HB, label: 'Hardback', signed: false },
	{ sku: `${RIAB_HB}-signed`, label: 'Hardback, autographed by Van Eure', signed: true },
	{ sku: RIAB_PB, label: 'Paperback', signed: false },
	{ sku: `${RIAB_PB}-signed`, label: 'Paperback, autographed by Van Eure', signed: true },
];
---

<form id="riab-order" class="mt-6 rounded-lg border border-[#d8cbb8] bg-white p-4 sm:p-5" data-cfg={cfg} data-return={RIAB_RETURN_PATH} data-embed={embed ? '1' : '0'}>
	<div class="space-y-3">
		{rows.map((r) => (
			<label class="flex items-center justify-between gap-4 rounded-lg border border-[#d8cbb8] p-3">
				<span class="flex flex-col">
					<span class="font-semibold">{r.label}</span>
					<span class="text-lg font-bold">{money(r.sku.startsWith(RIAB_HB) ? list.hb : list.pb)}</span>
					{r.signed && <span class="text-sm text-[#5b4636]">Same price as unsigned</span>}
				</span>
				<input type="number" inputmode="numeric" name={r.sku} min="0" max="5000" value="0" class="h-11 w-24 rounded border border-[#bfae96] px-2 text-center text-base" aria-label={`${r.label} quantity`} />
			</label>
		))}
	</div>

	<!-- GIFT TO CHARITY (Kevin 2026-11-20, riabOrder.ts (c)): hidden until Spirit Media Charities is connected (RIAB_GIFT_UI_OPEN);
	     a preview host or ?gift=preview shows it (the server still refuses until SMC_CONNECTED_ACCOUNT is bound). -->
	<fieldset id="donate" class="mt-5 scroll-mt-28 rounded-lg border border-dashed border-[#bfae96] p-3" data-gift-open={RIAB_GIFT_UI_OPEN ? '1' : '0'} hidden={!RIAB_GIFT_UI_OPEN}>
		<legend class="sr-only">Gift to charity</legend>
		<label class="flex items-center gap-3 font-semibold">
			<input type="checkbox" name="gift_on" class="h-5 w-5" />
			Add a gift to charity (optional)
		</label>
		<div data-gift-body hidden class="mt-3 space-y-3">
			<div>
				<span class="text-sm font-semibold">Amount</span>
				<div class="mt-1 flex flex-wrap items-center gap-2">
					{picks.map((d) => (
						<button type="button" data-pick={d} class="min-h-11 rounded-full border border-[#bfae96] px-4 text-base">${d}</button>
					))}
					<label class="flex items-center gap-1">
						<span class="text-lg font-bold">$</span>
						<input type="number" inputmode="numeric" name="donation" min="1" max="10000" step="1" value="" placeholder="Other" class="h-11 w-28 rounded border border-[#bfae96] px-2 text-base" aria-label="Gift amount in whole dollars" />
					</label>
				</div>
			</div>
			<div role="radiogroup" aria-label="Where your gift goes">
				<span class="text-sm font-semibold">Where should your gift go?</span>
				{Object.entries(RIAB_DESIGNATIONS).map(([k, label]) => (
					<label class="mt-1 flex items-center gap-2"><input type="radio" name="designation" value={k} class="h-5 w-5" /> {k === 'split' ? 'Split 50/50 between both' : label}</label>
				))}
			</div>
			<label class="flex items-start gap-2 text-sm">
				<input type="checkbox" name="fee_cover" class="mt-0.5 h-5 w-5" />
				<span>Cover the card processing fee (<span data-fee>+$0.00</span>) so the charity receives your full gift.</span>
			</label>
			<p class="text-sm text-[#5b4636]">{RIAB_GIFT_COPY} Tax-deductible to the extent allowed by law; your receipt comes in a separate email.</p>
		</div>
	</fieldset>

	<dl class="mt-4 space-y-1 border-t border-[#e6dccd] pt-3 text-sm">
		<div class="flex justify-between"><dt>Copies</dt><dd data-copies>0</dd></div>
		<div class="flex justify-between" data-tier-line hidden><dt>Bulk discount</dt><dd data-tier></dd></div>
		<div class="flex justify-between"><dt>Shipping (US)</dt><dd>Free</dd></div>
		<div class="flex justify-between" data-gift-line hidden><dt>Gift to charity</dt><dd data-gift></dd></div>
		<div class="flex justify-between text-base font-bold"><dt>Total before tax</dt><dd data-total>$0.00</dd></div>
	</dl>
	<button type="submit" class="mt-4 min-h-12 w-full rounded-full bg-[#8a1c1c] px-4 py-3 text-lg font-semibold text-white hover:bg-[#6f1515] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2b1d14]">Continue to secure checkout</button>
	<p id="riab-msg" role="status" class="mt-2 text-sm"></p>
	<p class="mt-2 text-sm text-[#5b4636]">Ships within the US. Outside the US? <a class="underline" href="/books/raised-in-a-barn/#order" target={top}>Order on the book page</a>. <a class="underline" href="/returns/" target={top}>Returns</a>.</p>
</form>

<section id="bulk" class="mt-8 scroll-mt-28">
	<h2 class="text-xl font-bold">Bulk discounts</h2>
	<p class="mt-1 text-sm text-[#5b4636]">Hardback and paperback count together. US orders.</p>
	<table class="mt-3 w-full border-collapse text-left text-sm">
		<thead><tr class="border-b border-[#d8cbb8]"><th class="py-2">Copies</th><th class="py-2">Discount</th><th class="py-2">Hardback</th><th class="py-2">Paperback</th></tr></thead>
		<tbody>
			{tiersAsc.map((t, i) => (
				<tr class="border-b border-[#e6dccd]">
					<td class="py-2">{tiersAsc[i + 1] ? `${t.min}–${tiersAsc[i + 1].min - 1}` : `${t.min}+`}</td>
					<td class="py-2">{t.pct}%</td>
					<td class="py-2">{money(unit(list.hb, t.pct))}</td>
					<td class="py-2">{money(unit(list.pb, t.pct))}</td>
				</tr>
			))}
		</tbody>
	</table>
</section>

<script>
	import { goTop, postHeight } from '../lib/riabEmbed.ts';

	const form = document.getElementById('riab-order') as HTMLFormElement;
	const embed = form.dataset.embed === '1';
	const cfg = JSON.parse(form.dataset.cfg as string) as { list: Record<string, number>; tiers: { min: number; pct: number }[]; feeBp: number };
	const inputs = [...form.querySelectorAll<HTMLInputElement>('input[type=number]:not([name=donation])')];
	const giftBox = form.querySelector('#donate') as HTMLFieldSetElement;
	const giftOn = form.querySelector('input[name=gift_on]') as HTMLInputElement;
	const giftBody = form.querySelector('[data-gift-body]') as HTMLElement;
	const giftAmt = form.querySelector('input[name=donation]') as HTMLInputElement;
	const feeBox = form.querySelector('input[name=fee_cover]') as HTMLInputElement;
	// same arithmetic as riabOrder.ts riabFeeCover
	const feeCover = (c: number) => Math.ceil((c * cfg.feeBp) / (10000 - cfg.feeBp));
	const giftDollars = () => (giftOn.checked ? Math.floor(Number(giftAmt.value) || 0) : 0);
	const designation = () => (form.querySelector('input[name=designation]:checked') as HTMLInputElement | null)?.value ?? '';
	// preview hosts and ?gift=preview show the closed gift box so it can be reviewed; the server still refuses it
	if (/\.pages\.dev$|^localhost$|^127\./.test(location.hostname) || new URLSearchParams(location.search).get('gift') === 'preview') giftBox.hidden = false;
	giftOn.addEventListener('change', () => {
		giftBody.hidden = !giftOn.checked;
	});
	form.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) =>
		b.addEventListener('click', () => {
			giftAmt.value = b.dataset.pick as string;
			render();
		}),
	);
	const cents = (c: number) => '$' + (c / 100).toFixed(2);
	const qty = (i: HTMLInputElement) => Math.max(0, Math.floor(Number(i.value) || 0));
	const listOf = (name: string) => cfg.list[name.replace(/-signed$/, '')];
	// same arithmetic as src/lib/riabOrder.ts riabQuote (Math.round of list x (100 - pct) / 100); list below 25 copies
	const render = () => {
		const copies = inputs.reduce((s, i) => s + qty(i), 0);
		const pct = cfg.tiers.find((t) => copies >= t.min)?.pct ?? 0;
		const total = inputs.reduce((s, i) => s + qty(i) * Math.round((listOf(i.name) * (100 - pct)) / 100), 0);
		(form.querySelector('[data-copies]') as HTMLElement).textContent = String(copies);
		(form.querySelector('[data-tier]') as HTMLElement).textContent = `${pct}% off`;
		(form.querySelector('[data-tier-line]') as HTMLElement).hidden = pct === 0;
		const g = giftDollars() * 100;
		const cover = g > 0 && feeBox.checked ? feeCover(g) : 0;
		(form.querySelector('[data-fee]') as HTMLElement).textContent = '+' + cents(g > 0 ? feeCover(g) : 0);
		(form.querySelector('[data-gift-line]') as HTMLElement).hidden = g === 0;
		(form.querySelector('[data-gift]') as HTMLElement).textContent = cents(g + cover);
		(form.querySelector('[data-total]') as HTMLElement).textContent = cents(total + g + cover);
	};
	// preselect from the raisedinabarn.org button: ?f=hb|pb [&signed=1] [&qty=N]
	const q = new URLSearchParams(location.search);
	const f = q.get('f');
	if (f === 'hb' || f === 'pb') {
		const name = `raised-in-a-barn-${f}${q.get('signed') === '1' ? '-signed' : ''}`;
		const el = inputs.find((i) => i.name === name);
		if (el) el.value = String(Math.min(5000, Math.max(1, Math.floor(Number(q.get('qty')) || 1))));
	}
	const msg = document.getElementById('riab-msg') as HTMLElement;
	if (q.get('order') === 'canceled') msg.textContent = 'Checkout was canceled. Nothing was charged.';
	form.addEventListener('input', render);
	render();
	if (embed) postHeight(window, (form.closest('[data-riab-embed]') as HTMLElement) ?? document.body);
	form.addEventListener('submit', async (ev) => {
		ev.preventDefault();
		const counts: Record<string, number> = Object.fromEntries(inputs.map((i) => [i.name, qty(i)]));
		if (!Object.values(counts).some((n) => n > 0)) {
			msg.textContent = 'Choose at least one copy.';
			return;
		}
		const utm = Object.fromEntries(['source', 'medium', 'campaign', 'content'].map((k) => [k, q.get(`utm_${k}`) ?? '']).filter(([, v]) => v));
		if (embed && !utm.source) utm.source = 'raisedinabarn.org';
		const donation = giftDollars();
		if (giftOn.checked) {
			if (!(donation >= 1 && donation <= 10000)) {
				msg.textContent = 'Please enter a whole-dollar gift between $1 and $10,000, or untick the gift.';
				return;
			}
			if (!designation()) {
				msg.textContent = 'Please choose where your gift goes: Cheyenne Foundation, Foundation of Hope, or split 50/50.';
				return;
			}
		}
		const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
		btn.disabled = true;
		msg.textContent = '';
		try {
			const r = await fetch('/store-checkout', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({
					brand: 'riab',
					counts,
					country: 'US',
					returnPath: form.dataset.return,
					utm,
					...(donation > 0 ? { donation_cents: donation * 100, designation: designation(), fee_cover: feeBox.checked } : {}),
				}),
			});
			const j = await r.json();
			if (j.url) {
				// embed: Stripe Checkout opens in the TOP window, never inside the frame
				if (embed) goTop(window, j.url, msg);
				else location.href = j.url;
				return;
			}
			msg.textContent = j.message ?? 'Checkout could not start. Please try again.';
		} catch {
			msg.textContent = 'Checkout could not start. Please try again.';
		}
		btn.disabled = false;
	});
</script>
