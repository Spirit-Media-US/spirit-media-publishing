---
import fs from 'node:fs';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import fhbSnapshot from '../data/fhb-editions.json';
import { sanityClient } from '../lib/sanity.ts';

interface Props {
	initialCollection?: string;
	heroEyebrow?: string;
	heroTitleHtml?: string;
	heroSubtitle?: string;
	// 2wg: unique intro for a collection page. `{n}` is replaced with the number of books the
	// page lists (computed from the collection data at build, never typed). Index page: none.
	introHtml?: string;
}

const {
	initialCollection = '',
	heroEyebrow = 'Bookstore',
	heroTitleHtml = `Spirit Media's <span class="text-red">Bookstore</span>`,
	heroSubtitle = 'Over 300 titles by Kingdom Messengers. New books added every week.',
	introHtml = '',
} = Astro.props;

const rawBooks = await sanityClient.fetch(`
  *[_type == "book"] | order(publishDate desc) {
    _id,
    title,
    "display_title": coalesce(displayTitle, title),
    author,
    "img": coalesce(coverImageUrl, coverImage.asset->url + "?w=400&auto=format"),
    // The primary listing, DERIVED. Some documents carry only per-binding links because
    // only one binding is listed (the three FHB General colours since 2026-09-17), and a
    // bare amazon field there is null -- which rendered href="null" on those cards.
    // Hardback leads, matching FHB/scripts/sync-amazon-links.mjs so the two agree.
    "amazon": coalesce(amazon, formats.hardback, formats.paperback, formats.ebook, formats.audio),
    "date": publishDate,
    collections,
    formats {
      "paperback": paperback,
      "hardback": hardback,
      "ebook": ebook,
      "audio": audio
    }
  }
`);

// ── Every FHB AUDIENCE and LANGUAGE edition (Kevin 2026-10-07: "update SMP bookstore with all
// the audience editions and languages"). ONE MASTER PER FACT: titles, dates, cards and links
// are read from the FHB repo's own edition data, never typed here —
//   dvc-editions.ts (the audience editions sold) · language-editions.ts (the language editions
//   rendered, and their Amazon links) · editions/<slug>.json (the /bibles/<slug>-bible page)
//   · card-art.ts (where each card lives on R2).
// Not Sanity documents: publishing one fires the webhook that rebuilds PRODUCTION, so new FHB
// cards could not wait on the dev preview for Kevin's review.
// An audience edition that already has its bookstore document (`fhb-edition-<slug>`, the join
// FHB/scripts/sync-amazon-links.mjs uses) keeps it and its Amazon links; it only gains the
// sub-collection. Everything else becomes a card linking to its FHB edition page, whose order
// form sells both bindings.
// COVER RULE (Kevin 2026-10-06): only the card cut from the edition's BUILT cover. Each card URL
// is fetched; one that does not answer 200 is left out and logged, never a placeholder.
// A build on Bethel rewrites src/data/fhb-editions.json; a build without the FHB repo (a
// Cloudflare build, e.g. the Sanity publish webhook) uses that committed snapshot.
async function deriveFhbEditions() {
	const FHB_DATA = '/srv/sites/FHB/src/data';
	if (!fs.existsSync(path.join(FHB_DATA, 'language-editions.ts'))) return fhbSnapshot;
	const load = (f: string) => import(/* @vite-ignore */ pathToFileURL(path.join(FHB_DATA, f)).href);
	const { cardUrl } = await load('card-art.ts');
	const { dvcEditions } = await load('dvc-editions.ts');
	const { languageEditions, langSlug, orderableLanguages, LANG_HB, LANG_PB } =
		await load('language-editions.ts');
	const page = (slug: string) => {
		const f = path.join(FHB_DATA, 'editions', `${slug}.json`);
		return fs.existsSync(f) ? JSON.parse(fs.readFileSync(f, 'utf8')) : null;
	};
	// 2xz: ISBN + price come from the FHB data the product page sells from (editions/<slug>.json
	// isbn, isbn-list.json to learn WHICH binding that ISBN is, and the SAME hb/pb prices
	// print-catalog.ts builds its rows from: dvc-editions.ts for audience editions, LANG_HB/LANG_PB
	// for orderable languages). print-catalog.ts itself is not importable from plain node (its
	// imports are extensionless). No price is emitted where there is no such price.
	const isbnPairs: any[] = (() => {
		try {
			const il = JSON.parse(fs.readFileSync(path.join(FHB_DATA, 'isbn-list.json'), 'utf8'));
			return ['general', 'audience', 'journaling', 'largePrint', 'languages'].flatMap((k) =>
				Array.isArray(il[k]) ? il[k] : il[k] ? [il[k]] : [],
			);
		} catch {
			return [];
		}
	})();
	const commerceOf = (ed: any, prices?: { hb: number; pb: number }) => {
		const isbn = typeof ed.isbn === 'string' && /^97[89]-[\d-]{10,}$/.test(ed.isbn) ? ed.isbn : '';
		if (!isbn) return {};
		const pair = isbnPairs.find((p) => p.hb === isbn || p.pb === isbn);
		const binding = pair ? (pair.hb === isbn ? 'hb' : 'pb') : '';
		const price = prices && binding ? (prices as any)[binding] : undefined;
		return {
			isbn,
			...(binding ? { binding } : {}),
			...(typeof price === 'number' && price > 0 ? { price } : {}),
		};
	};
	const { umbrella, audience, language } = fhbSnapshot.collections;
	const AUTHOR = 'Kevin White and Spirit Media Publishing'; // as the Sanity fhb-edition-* docs carry it
	const SITE = 'https://fathersheartbible.com';
	const rows: any[] = [];
	const left: string[] = [];
	for (const e of dvcEditions) {
		const ed = page(e.slug);
		if (!ed) {
			left.push(`${e.slug}: no /bibles page data`);
			continue;
		}
		const key = ed.coverImage ?? `dvc-${e.slug}`;
		// card-art.ts: every non-language card is 600x764, the 8x10 journaling card 600x725
		rows.push({
			group: 'audience',
			sanityId: `fhb-edition-${e.slug}`,
			title: ed.title,
			display_title: e.title,
			author: AUTHOR,
			img: cardUrl(key, 600),
			w: 600,
			h: key === 'dvc-journaling' ? 725 : 764,
			href: `${SITE}/bibles/${e.slug}-bible/`,
			date: ed.datePublished ?? null,
			collections: [umbrella, audience],
			...commerceOf(ed, { hb: e.hb, pb: e.pb }),
		});
	}
	for (const l of languageEditions) {
		const slug = langSlug(l);
		const ed = page(slug);
		if (!ed) {
			left.push(`${l.code}: no /bibles page data (${slug}.json)`);
			continue;
		}
		const english = l.english.replace(/\s*\(.*\)/, '');
		// language cards come at 360x458 (card-art.ts)
		rows.push({
			group: 'language',
			title: `${ed.title} — ${english} Edition`,
			display_title: `${l.name} — ${english} Edition`,
			author: AUTHOR,
			img: cardUrl(`lang-${l.code}`, 360),
			w: 360,
			h: 458,
			href: `${SITE}/bibles/${slug}-bible/`,
			date: ed.datePublished ?? null,
			collections: [umbrella, language],
			formats: l.amazon ?? {},
			...commerceOf(
				ed,
				orderableLanguages.some((o: any) => o.code === l.code)
					? { hb: LANG_HB, pb: LANG_PB }
					: undefined,
			),
		});
	}
	// A 5xx, a 429 or a timeout is the asset host failing, not a missing card: three tries, and a
	// card still unanswered stays only if the committed snapshot already carries that same card
	// (verified 200 when it was written). 2026-10-13: Cloudflare IAD trouble failed 11 of 57 HEADs
	// in one build and the snapshot lost 11 published editions. A 404 is left out on the first answer.
	const head = async (url: string) => {
		let res: any;
		for (let i = 0; i < 3; i++) {
			if (i) await new Promise((done) => setTimeout(done, 2000 * i));
			res = await fetch(url, { method: 'HEAD', signal: AbortSignal.timeout(15000) }).catch(
				(err) => ({ ok: false, status: String(err) }),
			);
			if (res.ok || (typeof res.status === 'number' && res.status < 500 && res.status !== 429))
				break;
		}
		return res;
	};
	const known = new Set((fhbSnapshot.editions as any[]).map((r) => `${r.href} ${r.img}`));
	const checked = await Promise.all(
		rows.map(async (r) => {
			const res = await head(r.img);
			if (res.ok) return r;
			const hostFailed = typeof res.status !== 'number' || res.status >= 500 || res.status === 429;
			if (hostFailed && known.has(`${r.href} ${r.img}`)) {
				console.log(
					`[bookstore] FHB kept from the snapshot — ${r.display_title}: card ${r.img} answered ${res.status} three times`,
				);
				return r;
			}
			left.push(`${r.display_title}: card ${r.img} answered ${res.status}`);
			return null;
		}),
	);
	const editions = checked.filter(Boolean);
	const out = {
		...fhbSnapshot,
		editions,
		audience: editions.filter((r) => r.group === 'audience').length,
		language: editions.filter((r) => r.group === 'language').length,
	};
	const json = `${JSON.stringify(out, null, '\t')}\n`;
	const target = path.resolve('src/data/fhb-editions.json');
	if (fs.existsSync(target) && fs.readFileSync(target, 'utf8') !== json)
		fs.writeFileSync(target, json);
	console.log(`[bookstore] FHB: ${out.audience} audience + ${out.language} language editions`);
	for (const l of left) console.log(`[bookstore] FHB left out — ${l}`);
	return out;
}
// Once per build, not once per page: index + every collection page render this component.
const g = globalThis as any;
if (!g.__fhbEditions) g.__fhbEditions = deriveFhbEditions();
const fhb = await g.__fhbEditions;

const byId = new Map(rawBooks.map((b: any) => [b._id, b]));
for (const e of fhb.editions as any[]) {
	const doc = e.sanityId && byId.get(e.sanityId);
	if (doc) {
		doc.collections = [...new Set([...(doc.collections || []), ...e.collections])];
		// FHB points buyers to itself (Kevin 2026-11-08; unit 2jd): fathersheartbible.com is the
		// seller of every FHB edition, so these cards link to the edition's own page, never Amazon.
		doc.amazon = e.href;
		// 2xz: the ISBN/binding/price the FHB edition data holds (absent when it holds none)
		if (e.isbn) {
			doc.isbn = e.isbn;
			if (e.binding) doc.binding = e.binding;
			if (e.price) doc.price = e.price;
		}
		doc.formats = Object.fromEntries(
			Object.entries(doc.formats || {}).map(([k, v]) => [k, v ? e.href : v]),
		);
		continue;
	}
	const listed = Object.values(e.formats || {}).some(Boolean);
	rawBooks.push({
		title: e.title,
		display_title: e.display_title,
		author: e.author,
		img: e.img,
		w: e.w,
		h: e.h,
		amazon: e.href,
		date: e.date,
		collections: e.collections,
		// FHB points buyers to itself (Kevin 2026-11-08; unit 2jd): every binding is ordered on the
		// edition's own page on fathersheartbible.com, listed on Amazon or not.
		formats: listed
			? Object.fromEntries(Object.entries(e.formats || {}).map(([k, v]) => [k, v ? e.href : v]))
			: { hardback: e.href, paperback: e.href },
		// 2xz: ISBN / binding / price from the FHB edition data (only where it holds them)
		...(e.isbn ? { isbn: e.isbn } : {}),
		...(e.isbn && e.binding ? { binding: e.binding } : {}),
		...(e.isbn && e.price ? { price: e.price } : {}),
	});
}

// The FHB documents that are not audience/language editions (General colours, Large Print, the
// English eBook) link to fathersheartbible.com too (Kevin 2026-11-10 L1707: "all the link to FHB
// should link to FHB for each edition and not to Amazon. This is only FHB and not our author's
// books"). Any other fhb-* document falls back to /print/, so no FHB card can reach Amazon.
const FHB_SITE = 'https://fathersheartbible.com';
const fhbOwnPage: Record<string, string> = {
	'fhb-general-charcoal': `${FHB_SITE}/print/#general-regular-charcoal`,
	'fhb-general-plum': `${FHB_SITE}/print/#general-regular-plum`,
	'fhb-general-white': `${FHB_SITE}/print/#general-regular-white`,
	'fhb-lp-set': `${FHB_SITE}/bibles/lp-set-bible/`,
	'fhb-lp-vol1': `${FHB_SITE}/bibles/lp-vol1-bible/`,
	'fhb-lp-vol2': `${FHB_SITE}/bibles/lp-vol2-bible/`,
	'fhb-lp-vol3': `${FHB_SITE}/bibles/lp-vol3-bible/`,
	// FHB does not sell the eBook itself; its Where to Find It page lists the eBook stores.
	'fhb-ebook-intimate-translation': `${FHB_SITE}/where-to-buy/`,
};
for (const doc of rawBooks as any[]) {
	if (!doc._id?.startsWith('fhb-')) continue;
	// A mapped document always takes its own edition page (the LP set's Sanity link was /print/).
	const href =
		fhbOwnPage[doc._id] ?? (doc.amazon?.startsWith(FHB_SITE) ? doc.amazon : `${FHB_SITE}/print/`);
	doc.amazon = href;
	doc.formats = Object.fromEntries(
		Object.entries(doc.formats || {}).map(([k, v]) => [k, v ? href : v]),
	);
}
// Kevin's own "Father's Heart - Beloved Identity" (Kevin 2026-11-10: "point Beloved Identity to FHB
// too"): the card and its paperback go to the FHB order page, fulfilled through Ingram. FHB sells
// only the paperback, so the eBook and audiobook keep their store links.
const BELOVED_ID = 'ybgI64RkWpWJOFkftSQjLA';
const BELOVED_PAGE = `${FHB_SITE}/books/beloved-identity/`;
for (const doc of rawBooks as any[]) {
	if (doc._id !== BELOVED_ID) continue;
	doc.amazon = BELOVED_PAGE;
	doc.formats = { ...(doc.formats || {}), paperback: BELOVED_PAGE };
}

const BOOKS_JSON = JSON.stringify(rawBooks);
// 3au (pmseoaeo 2026-11-13): the stats strip's numbers are computed HERE, at build, from the same rawBooks the
// browser script reads, and written into the served HTML; no-JS crawlers and AI readers used to see "0 Published
// Titles". The script animates up to these same values on scroll (one computation, not two).
// "Published Titles" counts EVERY FORMAT EDITION (Kevin 2026-08-28); Kingdom Messengers = PEOPLE (co-authors split,
// Spirit Media itself and name suffixes like "Jr." dropped); years counted from June 2022.
const STAT_PUBLISHER = /^spirit media(\s+publishing)?$/i;
const STAT_SUFFIX = /^(jr|sr|ii|iii|iv|v|md|phd|dds|esq)\.?$/i;
const STAT_TITLES = rawBooks.reduce(
	(sum: number, b: any) => sum + Object.values(b.formats || {}).filter((v) => v).length,
	0,
);
const STAT_AUTHORS = new Set(
	rawBooks.flatMap((b: any) =>
		String(b.author || '')
			.split(/,| and /i)
			.map((n: string) => n.trim())
			.filter((n: string) => n && !STAT_PUBLISHER.test(n) && !STAT_SUFFIX.test(n)),
	),
).size;
const statYearsNow = new Date();
const STAT_YEARS = statYearsNow.getFullYear() - 2022 - (statYearsNow.getMonth() < 5 ? 1 : 0);

const allCollections = [
	...new Set(rawBooks.flatMap((b: any) => b.collections || []).filter(Boolean)),
].sort() as string[];

// INDEXING (SMP indexing brief, Kevin 2026-10-19). The grid was drawn only by the script below,
// so every collection page's HTML was the same empty shell (91-98% identical) and the chips were
// <button>s, so nothing linked the collection pages. Now each chip is a real link to its page
// (same slug rule as bookstore/[collection].astro) and the page's first view is in the HTML.
// The script still filters in place and redraws the grid with its full cards on load.
const collectionHref = (c: string) =>
	c
		? `/bookstore/${c
				.toLowerCase()
				.replace(/\s+/g, '-')
				.replace(/[^a-z0-9-]/g, '')
				.replace(/-+/g, '-')}/`
		: '/bookstore/';
const initialBooks = rawBooks
	.filter((b: any) => !initialCollection || (b.collections || []).includes(initialCollection))
	.sort((x: any, y: any) => (y.date || '').localeCompare(x.date || ''));
const introRendered = introHtml.replaceAll('{n}', String(initialBooks.length));
// 2uv (CLS): the client script redraws the grid with date labels + format badges; the SSR cards
// lacked them, so every card grew on load (desktop CLS 0.73). These helpers MIRROR the script's
// renderFormats()/date label/coverBorder so the SSR card is byte-for-byte the same height. Keep in sync.
const FMT_LABELS: Record<string, string> = {
	paperback: 'Paperback',
	hardback: 'Hardback',
	ebook: 'eBook',
	audiobook: 'Audiobook',
	audio: 'Audiobook',
	pdf: 'PDF',
};
const FMT_STYLES: Record<string, string> = {
	paperback: 'background:#fde8e8;color:#c0392b;border:1px solid #f5c6c6;',
	hardback: 'background:#e8edf5;color:#2c3e6b;border:1px solid #c5cfe8;',
	ebook: 'background:#e6f4f1;color:#1a7a65;border:1px solid #b8dfd8;',
	audiobook: 'background:#fef3e2;color:#92640a;border:1px solid #f5d99e;',
	audio: 'background:#fef3e2;color:#92640a;border:1px solid #f5d99e;',
	pdf: 'background:#f0eeeb;color:#5a5248;border:1px solid #d8d2cb;',
};
const badgeStyle =
	'display:inline-block;font-size:0.6rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;padding:3px 7px;border-radius:4px;text-decoration:none;';
const formatsHtml = (b: any): string => {
	const fmts = b.formats || {};
	// 3aj: a format may be a URL or a bare flag (true) — a flag links to the book's own listing,
	// never to href="true" (was a 404 on SOAR To Success). No URL to give = no badge.
	const fmtHref = (k: string) =>
		typeof fmts[k] === 'string' ? fmts[k] : fmts[k] === true && b.amazon ? b.amazon : '';
	const keys = Object.keys(fmts).filter((k) => FMT_LABELS[k] && fmtHref(k));
	if (!keys.length) {
		if (!b.amazon) return '';
		const asin = (b.amazon.match(/\/dp\/([A-Z0-9]+)/) || [])[1] || '';
		const isEbook = asin.startsWith('B');
		const k = isEbook ? 'ebook' : 'paperback';
		return `<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;"><a href="${b.amazon}" target="_blank" rel="noopener noreferrer" style="${badgeStyle}${FMT_STYLES[k]}" onclick="event.stopPropagation()">${isEbook ? 'eBook' : 'Paperback'}</a></div>`;
	}
	const badges = keys
		.map(
			(k) =>
				`<a href="${fmtHref(k)}" target="_blank" rel="noopener noreferrer" style="${badgeStyle}${FMT_STYLES[k]}" onclick="event.stopPropagation()">${FMT_LABELS[k]}</a>`,
		)
		.join('');
	return `<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;">${badges}</div>`;
};
const dateLabelOf = (b: any) =>
	b.date
		? new Date(b.date + 'T12:00:00').toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			})
		: '';
const isLightCover = (b: any) =>
	/White Edition/i.test(b.title || '') || /White Edition/i.test(b.display_title || b.title || '');
// ItemList JSON-LD (unit 2qm): built from rawBooks, the SAME array that draws the cards, so
// numberOfItems == itemListElement length == books shown. Index page only (collection pages
// show a subset).
// 2vh: structured data only. Split combined author strings into separate entries; the publisher
// is an Organization, not a Person. A part with no surname ("Julie and Mark Boone") is ambiguous:
// the whole string is left exactly as-is rather than inventing a name.
// 2xz: every item is a Book (author Person/Organization, publisher = the site's Organization @id,
// image, datePublished, url). `isbn` and `offers` appear ONLY where the data holds them: Sanity
// book documents carry neither an ISBN nor a price, so the ~140 Sanity-only titles stay without
// them; the FHB editions (read from the FHB repo's edition data, see deriveFhbEditions) carry the
// ISBN of the binding they name and that binding's catalog price. Nothing is invented.
const authorLd = (raw: string) => {
	const one = (n: string) =>
		/^Spirit Media( Publishing)?$/.test(n)
			? { '@type': 'Organization', name: n }
			: { '@type': 'Person', name: n };
	const parts = raw
		.split(/\s+(?:and|&)\s+|,\s+(?!(?:Jr|Sr)\.?$|I{2,3}$|IV$)/)
		.map((x) => x.trim())
		.filter(Boolean);
	if (parts.length < 2 || parts.some((x) => !/\s/.test(x))) return one(raw);
	return parts.map(one);
};
const bookLd = (b: any) => ({
	'@type': 'Book',
	name: b.display_title || b.title,
	...(b.author ? { author: authorLd(b.author) } : {}),
	publisher: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
	},
	...(b.date && /^\d{4}-\d{2}-\d{2}$/.test(b.date) ? { datePublished: b.date } : {}),
	...(b.img ? { image: b.img } : {}),
	...(b.amazon ? { url: b.amazon } : {}),
	...(b.isbn ? { isbn: b.isbn } : {}),
	...(b.binding
		? {
				bookFormat:
					b.binding === 'hb' ? 'https://schema.org/Hardcover' : 'https://schema.org/Paperback',
			}
		: {}),
	...(b.price && b.amazon
		? {
				offers: {
					'@type': 'Offer',
					price: Number(b.price).toFixed(2),
					priceCurrency: 'USD',
					availability: 'https://schema.org/InStock',
					itemCondition: 'https://schema.org/NewCondition',
					url: b.amazon,
				},
			}
		: {}),
});
const itemListLd =
	initialCollection === ''
		? JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'ItemList',
				name: 'Spirit Media Christian Bookstore',
				url: 'https://spiritmediapublishing.com/bookstore/',
				numberOfItems: initialBooks.length,
				itemListElement: initialBooks.map((b: any, i: number) => ({
					'@type': 'ListItem',
					position: i + 1,
					item: bookLd(b),
				})),
			})
		: '';
---

{itemListLd && <script type="application/ld+json" set:html={itemListLd}></script>}

<!-- HERO -->
<section class="bg-stone-50 px-6 py-5 lg:py-7 lg:px-8">
  <div class="mx-auto max-w-7xl flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <p class="eyebrow eyebrow-red mb-2">{heroEyebrow}</p>
      <h1 class="font-serif text-3xl font-bold text-ink-soft"><Fragment set:html={heroTitleHtml} /></h1>
      <p class="mt-1 text-sm text-stone-500">{heroSubtitle}</p>
    </div>
    <a href="/contact/" class="shrink-0 rounded-md bg-red px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-red-deep">Publish Your Book →</a>
  </div>
</section>


{introRendered && (
<!-- COLLECTION INTRO (2wg): server-rendered, static, sits above the grid so nothing shifts on load -->
<section class="bg-white px-6 py-5 lg:px-8" data-collection-intro>
  <div class="mx-auto max-w-7xl">
    <p class="max-w-3xl text-sm leading-relaxed text-stone-600" set:html={introRendered}></p>
  </div>
</section>
)}

<!-- BOOKSTORE GRID -->
<section class="bg-stone-100 py-5 lg:py-8 px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">

    {allCollections.length > 0 && (
      <div class="flex items-center gap-2 flex-wrap mb-3">
        <span class="text-xs font-semibold text-stone-400 uppercase tracking-wider shrink-0">Collection:</span>
        <a href={collectionHref('')} data-collection="" class={`collection-chip px-3 py-1 rounded-full text-xs font-semibold border transition-colors ${initialCollection === '' ? 'active bg-red text-white border-red' : 'border-stone-300 text-stone-600 hover:border-red hover:text-red'}`}>All</a>
        {allCollections.map((c) => (
          <a href={collectionHref(c)} data-collection={c} class={`collection-chip px-3 py-1 rounded-full text-xs font-semibold border transition-colors ${initialCollection === c ? 'active bg-red text-white border-red' : 'border-stone-300 text-stone-600 hover:border-red hover:text-red'}`}>{c}</a>
        ))}
      </div>
    )}

    <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
      <input id="book-search" type="text" placeholder="Search by title or author…"
        class="flex-1 rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm text-ink-soft placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-red" />
      <select id="author-filter" class="rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm text-ink-soft focus:outline-none focus:ring-2 focus:ring-red">
        <option value="">All Authors</option>
        {[...new Set(rawBooks.map((b: any) => b.author).filter(Boolean))].sort().map((author) => (
          <option value={author}>{author}</option>
        ))}
      </select>
      <select id="sort-order" class="rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm text-ink-soft focus:outline-none focus:ring-2 focus:ring-red">
        <option value="newest">Newest First</option>
        <option value="oldest">Oldest First</option>
        <option value="title">Title A–Z</option>
        <option value="author">Author A–Z</option>
      </select>
      <p id="book-count" class="text-xs text-stone-500 sm:text-right sm:whitespace-nowrap sm:shrink-0"></p>
    </div>
    <div id="book-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-5">
      {initialBooks.map((b: any) => (
        <div class="group flex flex-col bg-white overflow-hidden border border-stone-200 hover:shadow-lg hover:-translate-y-1 transition-all duration-200">
          <a href={b.amazon || undefined} target={b.amazon ? '_blank' : undefined} rel={b.amazon ? 'noopener noreferrer' : undefined} class="block">
            <div class={`aspect-[2/3] overflow-hidden bg-stone-100${isLightCover(b) ? ' border-b border-[#adacab]' : ''}`}>
              {b.img && <img src={b.img} alt={b.display_title || b.title} loading="lazy" width={b.w} height={b.h} class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />}
            </div>
          </a>
          <div class="p-3 flex flex-col gap-1">
            <a href={b.amazon || undefined} target={b.amazon ? '_blank' : undefined} rel={b.amazon ? 'noopener noreferrer' : undefined} class="text-xs font-semibold text-ink-soft leading-tight line-clamp-2 hover:text-red transition-colors">{b.display_title || b.title}</a>
            <p class="text-xs text-stone-500">{b.author}</p>
            {dateLabelOf(b) && <p class="text-xs text-stone-400">{dateLabelOf(b)}</p>}
            <Fragment set:html={formatsHtml(b)} />
          </div>
        </div>
      ))}
    </div>
    <p id="no-results" class="hidden text-center text-stone-500 py-12 lg:py-20">No books found matching your search.</p>
  </div>
</section>


<!-- STATS STRIP -->
<section class="bg-stone-300 px-6 py-5">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="flex flex-col items-center text-center py-2">
        <span id="stat-titles" class="font-serif text-3xl font-bold text-ink-soft">{STAT_TITLES}</span>
        <span class="text-xs font-semibold uppercase tracking-widest text-stone-600 mt-1">Published Titles</span>
      </div>
      <div class="flex flex-col items-center text-center py-2">
        <span id="stat-authors" class="font-serif text-3xl font-bold text-ink-soft">{STAT_AUTHORS}</span>
        <span class="text-xs font-semibold uppercase tracking-widest text-stone-600 mt-1">Kingdom Messengers</span>
      </div>
      <div class="flex flex-col items-center text-center py-2">
        <span id="stat-years" class="font-serif text-3xl font-bold text-red">{STAT_YEARS}</span>
        <span class="text-xs font-semibold uppercase tracking-widest text-stone-600 mt-1">Years of Publishing</span>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-red px-6 py-12 lg:py-20 lg:px-8">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="font-serif text-3xl font-bold text-white sm:text-4xl mb-4">Ready to publish your book?</h2>
    <p class="text-stone-200 type-body-lg mb-8">Join the Kingdom Messengers who have trusted Spirit Media to publish and market their message.</p>
    <a href="/contact/" class="inline-block bg-stone-50 text-red font-semibold px-8 py-3.5 rounded-md hover:bg-red-wash transition-colors">Request a Free Consultation</a>
  </div>
</section>

<script define:vars={{ BOOKS_JSON, initialCollection, STAT_TITLES, STAT_AUTHORS }}>
  const BOOKS = JSON.parse(BOOKS_JSON);
  BOOKS.forEach(b => { if (!b.formats) b.formats = {}; });

  let activeCollection = initialCollection || '';

  // --- STATS COUNTERS (derived live from BOOKS data) ---
  (function() {
    // "Published Titles" counts EVERY FORMAT EDITION — a book released in
    // paperback, hardback and ebook is three titles on the shelf. Kevin
    // 2026-08-28. The unique-book count is still shown under the grid as
    // "Showing N of M titles".
    // 3au: same values the served HTML already shows (computed at build from these BOOKS).
    const totalTitles = STAT_TITLES;
    const uniqueAuthors = STAT_AUTHORS;

    // Years of publishing, counted from June 2022 — computed so it never goes
    // stale (it was hardcoded to 3 and sat wrong).
    const FOUNDED = new Date(2022, 5, 1); // June 2022
    const now = new Date();
    let years = now.getFullYear() - FOUNDED.getFullYear();
    if (now.getMonth() < FOUNDED.getMonth()) years -= 1;

    function animateCount(id, target, duration = 1400) {
      const el = document.getElementById(id);
      if (!el) return;
      const start = performance.now();
      function step(now) {
        const progress = Math.min((now - start) / duration, 1);
        const ease = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(ease * target);
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = target;
      }
      requestAnimationFrame(step);
    }

    const obs = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        animateCount('stat-titles', totalTitles);
        animateCount('stat-authors', uniqueAuthors, 1200);
        animateCount('stat-years', years, 1600);
        obs.disconnect();
      }
    }, { threshold: 0.3 });

    const strip = document.getElementById('stat-titles')?.closest('section');
    if (strip) obs.observe(strip);
  })();

  const FORMAT_LABELS = {
    paperback: 'Paperback',
    hardback:  'Hardback',
    ebook:     'eBook',
    audiobook: 'Audiobook',
    audio:     'Audiobook',
    pdf:       'PDF',
  };
  const FORMAT_STYLES = {
    paperback: 'background:#fde8e8;color:#c0392b;border:1px solid #f5c6c6;',
    hardback:  'background:#e8edf5;color:#2c3e6b;border:1px solid #c5cfe8;',
    ebook:     'background:#e6f4f1;color:#1a7a65;border:1px solid #b8dfd8;',
    audiobook: 'background:#fef3e2;color:#92640a;border:1px solid #f5d99e;',
    audio:     'background:#fef3e2;color:#92640a;border:1px solid #f5d99e;',
    pdf:       'background:#f0eeeb;color:#5a5248;border:1px solid #d8d2cb;',
  };

  function renderFormats(b) {
    const fmts = b.formats || {};
    // 3aj: a bare flag (true) links to the book's own listing; no URL = no badge (a bare flag is never used as the link).
    const fmtHref = k => (typeof fmts[k] === 'string' ? fmts[k] : (fmts[k] === true && b.amazon ? b.amazon : ''));
    let keys = Object.keys(fmts).filter(k => FORMAT_LABELS[k] && fmtHref(k));
    // If no formats defined, fall back to amazon link — detect type by ASIN
    if (!keys.length) {
      // No formats AND no listing: nothing to badge. Reading .match() off null threw here.
      if (!b.amazon) return '';
      const asinMatch = b.amazon.match(/\/dp\/([A-Z0-9]+)/);
      const asin = asinMatch ? asinMatch[1] : '';
      const isEbook = asin.startsWith('B');
      const fmtKey = isEbook ? 'ebook' : 'paperback';
      const fmtLabel = isEbook ? 'eBook' : 'Paperback';
      return `<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;">
        <a href="${b.amazon}" target="_blank" rel="noopener noreferrer"
          style="display:inline-block;font-size:0.6rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;padding:3px 7px;border-radius:4px;text-decoration:none;${FORMAT_STYLES[fmtKey]}"
          onclick="event.stopPropagation()">${fmtLabel}</a>
      </div>`;
    }
    const badges = keys.map(k =>
      `<a href="${fmtHref(k)}" target="_blank" rel="noopener noreferrer"
        style="display:inline-block;font-size:0.6rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;padding:3px 7px;border-radius:4px;text-decoration:none;${FORMAT_STYLES[k]}"
        onclick="event.stopPropagation()">
        ${FORMAT_LABELS[k]}
      </a>`
    ).join('');
    return `<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;">${badges}</div>`;
  }

  function render(filtered) {
    const grid = document.getElementById('book-grid');
    const count = document.getElementById('book-count');
    const none = document.getElementById('no-results');
    grid.innerHTML = filtered.map(b => {
      const dateLabel = b.date ? new Date(b.date + 'T12:00:00').toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'}) : '';
      const displayTitle = b.display_title || b.title;
      // Light/white covers (e.g. FHB White Edition) blend into the white card —
      // add a hairline between the cover and the card body so the edge reads.
      const lightCover = /White Edition/i.test(b.title || '') || /White Edition/i.test(displayTitle || '');
      const coverBorder = lightCover ? ' border-b border-[#adacab]' : '';
      // No listing at all -> an inert <a> rather than href="null" (a link that 404s on
      // our own domain is worse than no link). GROQ already falls back to the per-binding
      // URLs, so this only fires for a book with no purchase link recorded anywhere.
      const buyAttrs = b.amazon ? `href="${b.amazon}" target="_blank" rel="noopener noreferrer"` : '';
      return `<div class="group flex flex-col bg-white overflow-hidden border border-stone-200 hover:shadow-lg hover:-translate-y-1 transition-all duration-200">
        <a ${buyAttrs} class="block">
          <div class="aspect-[2/3] overflow-hidden bg-stone-100${coverBorder}">
            ${b.img ? `<img src="${b.img}" alt="${displayTitle}" loading="lazy"${b.w ? ` width="${b.w}" height="${b.h}"` : ''}
              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />` : ''}
          </div>
        </a>
        <div class="p-3 flex flex-col gap-1">
          <a ${buyAttrs} class="text-xs font-semibold text-ink-soft leading-tight line-clamp-2 hover:text-red transition-colors">${displayTitle}</a>
          <p class="text-xs text-stone-500">${b.author}</p>
          ${dateLabel ? `<p class="text-xs text-stone-400">${dateLabel}</p>` : ''}
          ${renderFormats(b)}
        </div>
      </div>`;
    }).join('');
    count.textContent = `Showing ${filtered.length} of ${BOOKS.length} titles`;
    none.classList.toggle('hidden', filtered.length > 0);
  }

  function filter() {
    const q = document.getElementById('book-search').value.toLowerCase();
    const a = document.getElementById('author-filter').value.toLowerCase();
    const sort = document.getElementById('sort-order').value;
    let filtered = BOOKS.filter(b => {
      const displayTitle = (b.display_title || b.title).toLowerCase();
      const matchQ = !q || displayTitle.includes(q) || b.author.toLowerCase().includes(q);
      const matchA = !a || b.author.toLowerCase() === a;
      const matchC = !activeCollection || (Array.isArray(b.collections) && b.collections.includes(activeCollection));
      return matchQ && matchA && matchC;
    });
    filtered.sort((x, y) => {
      if (sort === 'newest') return (y.date || '').localeCompare(x.date || '');
      if (sort === 'oldest') return (x.date || '').localeCompare(y.date || '');
      if (sort === 'title')  return (x.display_title || x.title).localeCompare(y.display_title || y.title);
      if (sort === 'author') return x.author.localeCompare(y.author);
      return 0;
    });
    render(filtered);
  }

  document.getElementById('book-search').addEventListener('input', filter);
  document.getElementById('author-filter').addEventListener('change', filter);
  document.getElementById('sort-order').addEventListener('change', filter);

  document.querySelectorAll('.collection-chip').forEach(btn => {
    // The chip is a real link (for crawlers and middle-click); a plain click still filters in place.
    btn.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      activeCollection = btn.getAttribute('data-collection') || '';
      document.querySelectorAll('.collection-chip').forEach(b => {
        b.classList.remove('active', 'bg-red', 'text-white', 'border-red');
        b.classList.add('border-stone-300', 'text-stone-600');
      });
      btn.classList.add('active', 'bg-red', 'text-white', 'border-red');
      btn.classList.remove('border-stone-300', 'text-stone-600');
      filter();
    });
  });

  // 2uv: the server already drew this exact grid (same sort, same card markup) — redrawing it on load
  // replaced every card and shifted layout. Only the count is filled in; filtering redraws as before.
  document.getElementById('book-count').textContent = `Showing ${document.querySelectorAll('#book-grid > div').length} of ${BOOKS.length} titles`;
</script>
