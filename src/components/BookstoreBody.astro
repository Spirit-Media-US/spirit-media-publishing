---
import fs from 'node:fs';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import cardAliases from '../data/books/card-page-aliases.json';
import coverSized from '../data/books/cover-sized.json';
import doNotPublish from '../data/books/do-not-publish.json';
import expressExtra from '../data/books/express-books.json';
import lightCovers from '../data/books/light-covers.json';
import pagesLive from '../data/books/pages-live.json';
import shipset from '../data/books/shipset-v2.json';
import fhbSnapshot from '../data/fhb-editions.json';
import { dnpMatcher } from '../lib/do-not-publish.mjs';
import { sanityClient } from '../lib/sanity.ts';
import engineBooks from '../store-engine/data/books.json';
import { BOOK_SKUS } from '../store-engine/lib/order-pricing.ts';
import { LIVE_COUNTRIES } from '../store-engine/lib/shipCountries.ts';
import BookCard from './BookCard.astro';
import ShipCountryMarquee from './ShipCountryMarquee.astro';

interface Props {
	initialCollection?: string;
	heroEyebrow?: string;
	heroTitleHtml?: string;
	heroSubtitle?: string;
	// 2wg: unique intro for a collection page. `{n}` is replaced with the number of books the
	// page lists (computed from the collection data at build, never typed). Index page: none.
	introHtml?: string;
	// Homepage "New from Spirit Media Authors" (Kevin 2026-11-16 "Make them show like cards on bookstore page"): render
	// ONLY the bookstore cards whose link is one of these /books/<slug>/ pages, in this order, as the same BookCard.
	cardsOnlyHrefs?: string[];
}

const {
	initialCollection = '',
	heroEyebrow = 'Bookstore',
	heroTitleHtml = `Spirit Media's <span class="text-red">Bookstore</span>`,
	heroSubtitle = 'Over 550 titles by Kingdom Messengers. New books added every week.',
	introHtml = '',
	cardsOnlyHrefs,
} = Astro.props;

const rawBooks = await sanityClient.fetch(`
  *[_type == "book"] | order(publishDate desc) {
    _id,
    title,
    "display_title": coalesce(displayTitle, title),
    author,
    "img": coalesce(coverImageUrl, coverImage.asset->url + "?w=400&auto=format"),
    // The primary listing, DERIVED. Some documents carry only per-binding links because
    // only one binding is listed (the three FHB General colours since 2026-09-17), and a
    // bare amazon field there is null -- which rendered href="null" on those cards.
    // Hardback leads, matching FHB/scripts/sync-amazon-links.mjs so the two agree.
    "amazon": coalesce(amazon, formats.hardback, formats.paperback, formats.ebook, formats.audio),
    "date": publishDate,
    collections,
    formats {
      "paperback": paperback,
      "hardback": hardback,
      "ebook": ebook,
      "audio": audio
    }
  }
`);
// DO NOT PUBLISH (Kevin 2026-11-16 "These should NOT show on SMP at all"): src/data/books/do-not-publish.json, by
// Sanity id or title. Dropped HERE, before anything reads rawBooks, so they get no card on /bookstore/ or any collection
// page, no ItemList entry, no author in the filter, and are not counted in Published Titles / Kingdom Messengers.
// The Sanity documents are left untouched. Test: scripts/do-not-publish.test.mjs.
const isDoNotPublish = dnpMatcher(doNotPublish);
for (let i = rawBooks.length - 1; i >= 0; i--)
	if (isDoNotPublish(rawBooks[i])) rawBooks.splice(i, 1);

// ── Every FHB AUDIENCE and LANGUAGE edition (Kevin 2026-10-07: "update SMP bookstore with all
// the audience editions and languages"). ONE MASTER PER FACT: titles, dates, cards and links
// are read from the FHB repo's own edition data, never typed here —
//   dvc-editions.ts (the audience editions sold) · language-editions.ts (the language editions
//   rendered, and their Amazon links) · editions/<slug>.json (the /bibles/<slug>-bible page)
//   · card-art.ts (where each card lives on R2).
// Not Sanity documents: publishing one fires the webhook that rebuilds PRODUCTION, so new FHB
// cards could not wait on the dev preview for Kevin's review.
// An audience edition that already has its bookstore document (`fhb-edition-<slug>`, the join
// FHB/scripts/sync-amazon-links.mjs uses) keeps it and its Amazon links; it only gains the
// sub-collection. Everything else becomes a card linking to its FHB edition page, whose order
// form sells both bindings.
// COVER RULE (Kevin 2026-10-06): only the card cut from the edition's BUILT cover. Each card URL
// is fetched; one that does not answer 200 is left out and logged, never a placeholder.
// A build on Bethel rewrites src/data/fhb-editions.json; a build without the FHB repo (a
// Cloudflare build, e.g. the Sanity publish webhook) uses that committed snapshot.
async function deriveFhbEditions() {
	const FHB_DATA = '/srv/sites/FHB/src/data';
	if (!fs.existsSync(path.join(FHB_DATA, 'language-editions.ts'))) return fhbSnapshot;
	const load = (f: string) => import(/* @vite-ignore */ pathToFileURL(path.join(FHB_DATA, f)).href);
	const { cardUrl } = await load('card-art.ts');
	const { dvcEditions } = await load('dvc-editions.ts');
	const { languageEditions, langSlug, orderableLanguages, LANG_HB, LANG_PB } =
		await load('language-editions.ts');
	const page = (slug: string) => {
		const f = path.join(FHB_DATA, 'editions', `${slug}.json`);
		return fs.existsSync(f) ? JSON.parse(fs.readFileSync(f, 'utf8')) : null;
	};
	// 2xz: ISBN + price come from the FHB data the product page sells from (editions/<slug>.json
	// isbn, isbn-list.json to learn WHICH binding that ISBN is, and the SAME hb/pb prices
	// print-catalog.ts builds its rows from: dvc-editions.ts for audience editions, LANG_HB/LANG_PB
	// for orderable languages). print-catalog.ts itself is not importable from plain node (its
	// imports are extensionless). No price is emitted where there is no such price.
	const isbnPairs: any[] = (() => {
		try {
			const il = JSON.parse(fs.readFileSync(path.join(FHB_DATA, 'isbn-list.json'), 'utf8'));
			return ['general', 'audience', 'journaling', 'largePrint', 'languages'].flatMap((k) =>
				Array.isArray(il[k]) ? il[k] : il[k] ? [il[k]] : [],
			);
		} catch {
			return [];
		}
	})();
	const commerceOf = (ed: any, prices?: { hb: number; pb: number }) => {
		const isbn = typeof ed.isbn === 'string' && /^97[89]-[\d-]{10,}$/.test(ed.isbn) ? ed.isbn : '';
		if (!isbn) return {};
		const pair = isbnPairs.find((p) => p.hb === isbn || p.pb === isbn);
		const binding = pair ? (pair.hb === isbn ? 'hb' : 'pb') : '';
		const price = prices && binding ? (prices as any)[binding] : undefined;
		return {
			isbn,
			...(binding ? { binding } : {}),
			...(typeof price === 'number' && price > 0 ? { price } : {}),
		};
	};
	const { umbrella, audience, language } = fhbSnapshot.collections;
	const AUTHOR = 'Kevin White and Spirit Media Publishing'; // as the Sanity fhb-edition-* docs carry it
	const SITE = 'https://fathersheartbible.com';
	const rows: any[] = [];
	const left: string[] = [];
	for (const e of dvcEditions) {
		const ed = page(e.slug);
		if (!ed) {
			left.push(`${e.slug}: no /bibles page data`);
			continue;
		}
		const key = ed.coverImage ?? `dvc-${e.slug}`;
		// card-art.ts: every non-language card is 600x764, the 8x10 journaling card 600x725
		rows.push({
			group: 'audience',
			sanityId: `fhb-edition-${e.slug}`,
			title: ed.title,
			display_title: e.title,
			author: AUTHOR,
			img: cardUrl(key, 600),
			w: 600,
			h: key === 'dvc-journaling' ? 725 : 764,
			href: `${SITE}/bibles/${e.slug}-bible/`,
			date: ed.datePublished ?? null,
			collections: [umbrella, audience],
			...commerceOf(ed, { hb: e.hb, pb: e.pb }),
		});
	}
	for (const l of languageEditions) {
		const slug = langSlug(l);
		const ed = page(slug);
		if (!ed) {
			left.push(`${l.code}: no /bibles page data (${slug}.json)`);
			continue;
		}
		const english = l.english.replace(/\s*\(.*\)/, '');
		// language cards come at 360x458 (card-art.ts)
		rows.push({
			group: 'language',
			title: `${ed.title} — ${english} Edition`,
			display_title: `${l.name} — ${english} Edition`,
			author: AUTHOR,
			img: cardUrl(`lang-${l.code}`, 360),
			w: 360,
			h: 458,
			href: `${SITE}/bibles/${slug}-bible/`,
			date: ed.datePublished ?? null,
			collections: [umbrella, language],
			// Kevin 2026-11-15 L2109 "make sure to count every paperback, hardback, ebook, and audiobook": the
			// registry lists an edition only once BOTH bindings are submitted to Ingram, so both are carded
			// (and counted) even where Amazon lists only one; every binding links to the FHB page below.
			formats: { hardback: l.amazon?.hardback ?? true, paperback: l.amazon?.paperback ?? true },
			...commerceOf(
				ed,
				orderableLanguages.some((o: any) => o.code === l.code)
					? { hb: LANG_HB, pb: LANG_PB }
					: undefined,
			),
		});
	}
	// ROSTER EDITIONS (Kevin 2026-11-15 "You are missing many. Please get this cleaned up."): a language
	// edition FHB already sells from its own /bibles page (language-roster.json: sellable, ISBNs, card cut
	// from the BUILT case) before the edition chain lists it in edition-registry.json. Shown only when its
	// full built cover exists in projects/fhb-lang-covers/<code>/out/ (COVER RULE, Kevin 2026-10-06) and its
	// /bibles page data exists; the card HEAD check below still applies. Roster `ak` (Twi) is filed under
	// `tw` there (fhb-chain.py ED_ROSTER_ALIAS).
	const { rosterLanguages } = await load('language-editions.ts');
	const COVERS = '/home/deploy/projects/fhb-lang-covers';
	const builtCover = (code: string) => {
		const dir = path.join(COVERS, code === 'ak' ? 'tw' : code, 'out');
		try {
			return fs.readdirSync(dir).some((f) => /-CASE-\d+pp\.pdf$/.test(f));
		} catch {
			return false;
		}
	};
	for (const l of rosterLanguages) {
		if (l.code === 'en' || l.listed || !l.sellable || !l.card || !l.isbn) continue;
		if (!builtCover(l.code)) {
			left.push(`${l.code}: roster edition, no built cover in ${COVERS}/${l.code}/out`);
			continue;
		}
		const slug = langSlug(l);
		const ed = page(slug);
		if (!ed) {
			left.push(`${l.code}: roster edition, no /bibles page data (${slug}.json)`);
			continue;
		}
		const english = l.english.replace(/\s*\(.*\)/, '');
		rows.push({
			group: 'language',
			title: `${ed.title} — ${english} Edition`,
			display_title: `${l.name} — ${english} Edition`,
			author: AUTHOR,
			img: cardUrl(`lang-${l.code}`, 360),
			w: 360,
			h: 458,
			href: `${SITE}/bibles/${slug}-bible/`,
			date: ed.datePublished ?? null,
			collections: [umbrella, language],
			formats: l.amazon ?? {},
			...commerceOf(ed, { hb: LANG_HB, pb: LANG_PB }),
		});
	}
	// A 5xx, a 429 or a timeout is the asset host failing, not a missing card: three tries, and a
	// card still unanswered stays only if the committed snapshot already carries that same card
	// (verified 200 when it was written). 2026-10-13: Cloudflare IAD trouble failed 11 of 57 HEADs
	// in one build and the snapshot lost 11 published editions. A 404 is left out on the first answer.
	const head = async (url: string) => {
		let res: any;
		for (let i = 0; i < 3; i++) {
			if (i) await new Promise((done) => setTimeout(done, 2000 * i));
			res = await fetch(url, { method: 'HEAD', signal: AbortSignal.timeout(15000) }).catch(
				(err) => ({ ok: false, status: String(err) }),
			);
			if (res.ok || (typeof res.status === 'number' && res.status < 500 && res.status !== 429))
				break;
		}
		return res;
	};
	const known = new Set((fhbSnapshot.editions as any[]).map((r) => `${r.href} ${r.img}`));
	const checked = await Promise.all(
		rows.map(async (r) => {
			const res = await head(r.img);
			if (res.ok) return r;
			const hostFailed = typeof res.status !== 'number' || res.status >= 500 || res.status === 429;
			if (hostFailed && known.has(`${r.href} ${r.img}`)) {
				console.log(
					`[bookstore] FHB kept from the snapshot — ${r.display_title}: card ${r.img} answered ${res.status} three times`,
				);
				return r;
			}
			left.push(`${r.display_title}: card ${r.img} answered ${res.status}`);
			return null;
		}),
	);
	const editions = checked.filter(Boolean);
	const out = {
		...fhbSnapshot,
		editions,
		audience: editions.filter((r) => r.group === 'audience').length,
		language: editions.filter((r) => r.group === 'language').length,
	};
	const json = `${JSON.stringify(out, null, '\t')}\n`;
	const target = path.resolve('src/data/fhb-editions.json');
	if (fs.existsSync(target) && fs.readFileSync(target, 'utf8') !== json)
		fs.writeFileSync(target, json);
	console.log(`[bookstore] FHB: ${out.audience} audience + ${out.language} language editions`);
	for (const l of left) console.log(`[bookstore] FHB left out — ${l}`);
	return out;
}
// Once per build, not once per page: index + every collection page render this component.
const g = globalThis as any;
if (!g.__fhbEditions) g.__fhbEditions = deriveFhbEditions();
const fhb = await g.__fhbEditions;

const byId = new Map(rawBooks.map((b: any) => [b._id, b]));
for (const e of fhb.editions as any[]) {
	const doc = e.sanityId && byId.get(e.sanityId);
	if (doc) {
		doc.collections = [...new Set([...(doc.collections || []), ...e.collections])];
		// FHB points buyers to itself (Kevin 2026-11-08; unit 2jd): fathersheartbible.com is the
		// seller of every FHB edition, so these cards link to the edition's own page, never Amazon.
		doc.amazon = e.href;
		// 2xz: the ISBN/binding/price the FHB edition data holds (absent when it holds none)
		if (e.isbn) {
			doc.isbn = e.isbn;
			if (e.binding) doc.binding = e.binding;
			if (e.price) doc.price = e.price;
		}
		doc.formats = Object.fromEntries(
			Object.entries(doc.formats || {}).map(([k, v]) => [k, v ? e.href : v]),
		);
		continue;
	}
	const listed = Object.values(e.formats || {}).some(Boolean);
	rawBooks.push({
		title: e.title,
		display_title: e.display_title,
		author: e.author,
		img: e.img,
		w: e.w,
		h: e.h,
		amazon: e.href,
		date: e.date,
		collections: e.collections,
		fhbGroup: e.group, // audience | language: decides FHB English vs FHB Languages below
		// FHB points buyers to itself (Kevin 2026-11-08; unit 2jd): every binding is ordered on the
		// edition's own page on fathersheartbible.com, listed on Amazon or not.
		formats: listed
			? Object.fromEntries(Object.entries(e.formats || {}).map(([k, v]) => [k, v ? e.href : v]))
			: { hardback: e.href, paperback: e.href },
		// 2xz: ISBN / binding / price from the FHB edition data (only where it holds them)
		...(e.isbn ? { isbn: e.isbn } : {}),
		...(e.isbn && e.binding ? { binding: e.binding } : {}),
		...(e.isbn && e.price ? { price: e.price } : {}),
	});
}

// The FHB documents that are not audience/language editions (General colours, Large Print, the
// English eBook) link to fathersheartbible.com too (Kevin 2026-11-10 L1707: "all the link to FHB
// should link to FHB for each edition and not to Amazon. This is only FHB and not our author's
// books"). Any other fhb-* document falls back to /print/, so no FHB card can reach Amazon.
const FHB_SITE = 'https://fathersheartbible.com';
const fhbOwnPage: Record<string, string> = {
	'fhb-general-charcoal': `${FHB_SITE}/print/#general-regular-charcoal`,
	'fhb-general-plum': `${FHB_SITE}/print/#general-regular-plum`,
	'fhb-general-white': `${FHB_SITE}/print/#general-regular-white`,
	'fhb-lp-set': `${FHB_SITE}/bibles/lp-set-bible/`,
	'fhb-lp-vol1': `${FHB_SITE}/bibles/lp-vol1-bible/`,
	'fhb-lp-vol2': `${FHB_SITE}/bibles/lp-vol2-bible/`,
	'fhb-lp-vol3': `${FHB_SITE}/bibles/lp-vol3-bible/`,
	// FHB does not sell the eBook itself; its Where to Find It page lists the eBook stores.
	'fhb-ebook-intimate-translation': `${FHB_SITE}/where-to-buy/`,
};
for (const doc of rawBooks as any[]) {
	if (!doc._id?.startsWith('fhb-')) continue;
	// A mapped document always takes its own edition page (the LP set's Sanity link was /print/).
	const href =
		fhbOwnPage[doc._id] ?? (doc.amazon?.startsWith(FHB_SITE) ? doc.amazon : `${FHB_SITE}/print/`);
	doc.amazon = href;
	doc.formats = Object.fromEntries(
		Object.entries(doc.formats || {}).map(([k, v]) => [k, v ? href : v]),
	);
}
// Kevin's own "Father's Heart - Beloved Identity" (Kevin 2026-11-10: "point Beloved Identity to FHB
// too"): the card and its paperback go to the FHB order page, fulfilled through Ingram. FHB sells
// only the paperback, so the eBook and audiobook keep their store links.
const BELOVED_ID = 'ybgI64RkWpWJOFkftSQjLA';
// OPTION C (Kevin 2026-11-16 "1 store SMP. 2 shop windows FHB and SMP"): FHB is the ONE window for every Father's Heart
// product. Every FH book the store engine sells (books.json: Beloved Identity, Who Am I?, any added later) has its card
// and its print bindings on its FHB page; SMP builds no page for them (their SMP URLs 301 to FHB). eBook/audiobook keep
// their store links (FHB sells print only).
const fhBookPage = (slug: string) => `${FHB_SITE}/books/${slug}/`;
const normT = (t: string) =>
	String(t || '')
		.toLowerCase()
		.normalize('NFKD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/[^a-z0-9]+/g, ' ')
		.trim();
const FH_BOOK_BY_TITLE = new Map<string, string>(
	(engineBooks as any).books.map((b: any) => [normT(b.title), b.slug]),
);
// the two Sanity documents by id (their Sanity titles carry subtitles); a later FH book matches by its engine title
const FH_BOOK_IDS: Record<string, string> = {
	[BELOVED_ID]: 'beloved-identity',
	'42467468-1171-4ec9-8f48-81f813da9070': 'who-am-i',
};
const fhBookSlugOf = (doc: any) =>
	FH_BOOK_IDS[doc._id] ??
	FH_BOOK_BY_TITLE.get(normT(doc.title)) ??
	FH_BOOK_BY_TITLE.get(normT(doc.display_title));
for (const doc of rawBooks as any[]) {
	const slug = fhBookSlugOf(doc);
	if (!slug) continue;
	const href = fhBookPage(slug);
	doc.amazon = href;
	doc.fhBook = true;
	doc.formats = Object.fromEntries(
		Object.entries(doc.formats || {}).map(([k, v]) => [
			k,
			v && /^(paperback|hardback|hardcover)$/.test(k) ? href : v,
		]),
	);
}

// LAMB PILOT (Kevin L1971; plan 3fb B): the card for Jesus Had a Little Lamb opens our own book page (one card, no
// duplicate). Its format links keep their store listings until our store sells the book (plan 3fb Phase 4: no
// dead ends before checkout is live).
// 3gh #3 (pmseoaeo 2026-11-14): the Lamb page is unlisted until its price is set, so its card keeps its listing.

// ENGINE #1 (Kevin 2026-11-13 L1973: our store is the #1 retailer of every SMP book; pmseoaeo 3gh #1 owner call): a
// card for a book our store sells opens ITS OWN /books/<slug>/ page (order form on it) and carries no store badges.
// Matched by normalised title against the ship set (the same data that builds those pages), so a page always exists.
const norm = (t: string) =>
	String(t || '')
		.toLowerCase()
		.replace(/\((spanish|english|large print|hardcover|paperback)[^)]*edition\)/gi, '')
		.normalize('NFKD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/[^a-z0-9]+/g, ' ')
		.trim();
// only the pages that BUILD (src/data/books/pages-live.json; all of them on a BOOKS_PREVIEW_ALL=1 preview)
const PAGE_BUILT = (slug: string) =>
	process.env.BOOKS_PREVIEW_ALL === '1' || (pagesLive.slugs as string[]).includes(slug);
const LIVE_TITLES = (shipset as any).titles.filter(
	(t: any) => PAGE_BUILT(t.slug) && !isDoNotPublish({ slug: t.slug, title: t.book?.title }),
);
const OWN_PAGE = new Map<string, string>(
	LIVE_TITLES.map((t: any) => [norm(t.book.title), `/books/${t.slug}/`]),
);
// A card whose title differs from the ship set: its slug read as words ("your time first responders") is a key too,
// and the bookstore's own spellings of the Home editions and the plain "Your Time" cards (Sanity points every Your
// Time card at the Work Staff listing) are named here, so no other edition's card is pulled in (pmseoaeo 3gm #1).
for (const t of LIVE_TITLES) OWN_PAGE.set(norm(t.slug.replace(/-/g, ' ')), `/books/${t.slug}/`);
// The FH books (store-engine books.json) are carded to their FHB page above (Option C), never to an SMP page.
// Kevin 2026-11-16 "Why does the cards only show paperback now?": an own-page card keeps its REAL formats.
// Print formats (paperback/hardback) open our own page (we sell them); eBook/audio keep their store link.
const kindOf = (k: string) =>
	['paperback', 'hardback', 'ebook', 'audiobook', 'audio', 'pdf'].includes(k)
		? k
		: /-pb$/.test(k)
			? 'paperback'
			: /-hb$/.test(k)
				? 'hardback'
				: /-(eb|ebook)$/.test(k)
					? 'ebook'
					: /-(audio|ab)$/.test(k)
						? 'audiobook'
						: '';
const ownFormats = (own: string, all: Record<string, unknown> | undefined) => {
	const out: Record<string, string> = {};
	for (const [k, v] of Object.entries(all || {})) {
		const kind = kindOf(k);
		if (!kind) continue;
		if (kind === 'paperback' || kind === 'hardback') out[kind] = own;
		else if (typeof v === 'string' && /^https?:/.test(v)) out[kind] = v;
	}
	if (!Object.keys(out).length) out.paperback = own;
	return out;
};
// Cards whose title differs from the ship set: src/data/books/card-page-aliases.json (Kevin 2026-11-16 16:5xZ "card images
// must open the SMP book page"), one lookup, the first BUILT candidate page wins; no built candidate = the store link stays.
const OWN_ALIAS: Record<string, string> = Object.fromEntries(
	Object.entries((cardAliases as any).aliases as Record<string, string[]>)
		.map(([k, slugs]) => [k, slugs.find((slug) => PAGE_BUILT(slug))])
		.filter(([, slug]) => slug)
		.map(([k, slug]) => [k, `/books/${slug}/`]),
);
for (const doc of rawBooks as any[]) {
	if (doc._id?.startsWith('fhb-') || doc.fhBook) continue; // FHB cards keep their FHB pages
	const own =
		OWN_PAGE.get(norm(doc.title)) ??
		OWN_PAGE.get(norm(doc.display_title)) ??
		OWN_ALIAS[norm(doc.title)] ??
		OWN_ALIAS[norm(doc.display_title)];
	if (!own) continue;
	doc.amazon = own;
	doc.formatsAll = doc.formats; // still counted in Published Titles (L2109)
	doc.formats = ownFormats(own, doc.formatsAll);
	doc.ownPage = true;
}
// A book our store sells with no bookstore document yet (new titles: publishing a Sanity document rebuilds
// PRODUCTION) gets its card from the same ship-set data that builds its page.
{
	const carded = new Set((rawBooks as any[]).filter((d) => d.ownPage).map((d) => d.amazon));
	for (const t of LIVE_TITLES) {
		const href = `/books/${t.slug}/`;
		if (carded.has(href)) continue;
		const sized = (coverSized as any).covers[t.slug];
		rawBooks.push({
			_id: `smp-store-${t.slug}`,
			title: t.book.title,
			display_title: t.book.title,
			author: t.book.author?.name ?? '',
			img: sized?.w300 ?? t.book.cover?.jpg,
			amazon: href,
			date: null,
			collections: null,
			formats: ownFormats(
				href,
				Object.fromEntries((t.book.formats || []).map((f: string) => [f, true])),
			),
			// the ship set's own format list (pb/hb/ebook/audio SKUs) counts in Published Titles (L2109)
			formatsAll: Object.fromEntries((t.book.formats || []).map((f: string) => [f, true])),
			ownPage: true,
		});
	}
}

// ── COLLECTIONS (Kevin 2026-11-16, kevin-decisions.md: "Make it: All, SMP only (all without FHB), FHB English (which
// shows ALL english editions), FHB Languages (showing all the foreign lanuage editions), FHB Books" + "Sorry add Express
// Books back after SMP only" + "after 2 add a new 3: SMP worldwide (showing those available for shipping until we get all
// \"SMP only\" showing)"). Each card's collection is DERIVED from the data above, never typed per card:
//   fhb-books     — doc.fhBook (an FH book the store engine sells, books.json; Option C d416648)
//   fhb-languages — an FHB language edition (fhb-editions.json group "language")
//   fhb-english   — every other FHB edition (Sanity fhb-* documents: General, Large Print, eBook, audience editions;
//                   fhb-editions.json group "audience")
//   smp           — everything else.
//   express-books — CROSS-CUTTING: Sanity "Express Books" members + src/data/books/express-books.json, any partition.
//   smp-worldwide — the SMP-only cards ORDERABLE here: a built SMP /books/ page with an order form (a ship-set book with
//                   a store-registry SKU that has an ISBN and a price, the rule books/[slug] sells by; any language). A subset of SMP only; it grows as pages go live.
//                   RETIRES ITSELF: the build that finds it equal to SMP only drops its chip and page, and the
//                   smp-worldwide-retire integration (astro.config.mjs) writes /bookstore/smp-worldwide/ -> /bookstore/smp/ 301.
// Every card sits in exactly one of smp / fhb-english / fhb-languages / fhb-books (scripts/store-checkout.test.mjs).
// bookstore/[collection].astro builds one page per non-All key with the same slugs; the 3 retired FHB collection
// URLs 301 in public/_redirects. In SMP only, cards with a live SMP book page (src/data/books/pages-live.json, the
// books orderable here) sort first.
const COLLECTIONS = [
	{ key: '', name: 'All' },
	{ key: 'smp', name: 'SMP only' },
	{ key: 'smp-worldwide', name: 'SMP worldwide' },
	{ key: 'express-books', name: 'Express Books' },
	{ key: 'fhb-english', name: 'FHB English' },
	{ key: 'fhb-languages', name: 'FHB Languages' },
	{ key: 'fhb-books', name: 'FHB Books' },
];
const partitionOf = (b: any) =>
	b.fhBook
		? 'fhb-books'
		: b.fhbGroup === 'language'
			? 'fhb-languages'
			: b.fhbGroup === 'audience' || String(b._id || '').startsWith('fhb-')
				? 'fhb-english'
				: 'smp';
// Express Books = the Sanity "Express Books" collection + src/data/books/express-books.json (titles proven Express by
// another record: cover manifest, Express pipeline project; each entry names its source). Cross-cutting (Kevin
// 2026-11-16 "You are missing express books"): a subset of All, so an FH book can be in FHB Books AND Express Books.
const EXPRESS_TITLES = new Set<string>(
	(expressExtra as any).titles.map((t: any) => normT(t.title)),
);
const SHIP_TITLE = new Map<string, any>((shipset as any).titles.map((t: any) => [t.slug, t]));
// "live" = the page BUILDS on this build (PAGE_BUILT: pages-live.json, or every page on a BOOKS_PREVIEW_ALL=1 preview),
// the same switch books/[slug] uses, so a card is in SMP worldwide exactly when its built page shows the order box.
const hasOrderBox = (slug: string) => {
	const t = SHIP_TITLE.get(slug);
	if (!t || !PAGE_BUILT(slug)) return false;
	return (t.book.formats as string[]).some(
		(sku) => (BOOK_SKUS as any)[sku]?.isbn && Number.isInteger(t.skus?.[sku]?.list_cents),
	);
};
for (const b of rawBooks as any[]) {
	const part = partitionOf(b);
	const own = /^\/books\/([^/]+)\/$/.exec(b.amazon || '');
	b.live = !!(own && PAGE_BUILT(own[1]));
	b.colls = [part];
	if (part === 'smp' && own && hasOrderBox(own[1])) b.colls.push('smp-worldwide');
	const titleKeys = [b.display_title, b.title, String(b.title || '').split(':')[0]].map(normT);
	if (
		(b.collections || []).includes('Express Books') ||
		titleKeys.some((k) => EXPRESS_TITLES.has(k))
	)
		b.colls.push('express-books');
	b.cardId = b._id || `${b.display_title || b.title}|${b.amazon}`;
}
// the retirement check (see above): every SMP-only card orderable = SMP worldwide has done its job
const WORLDWIDE_RETIRED = (rawBooks as any[]).every(
	(b) => !b.colls.includes('smp') || b.colls.includes('smp-worldwide'),
);
(globalThis as any).__smpWorldwideRetired = WORLDWIDE_RETIRED;
const CHIPS = COLLECTIONS.filter((c) => !(WORLDWIDE_RETIRED && c.key === 'smp-worldwide'));
// newest first; in SMP only the live-page cards lead
const byDate = (x: any, y: any) => (y.date || '').localeCompare(x.date || '');
const liveFirst = (x: any, y: any) => Number(!!y.live) - Number(!!x.live);

// /bookstore/ (Kevin 2026-11-16 ~15:3xZ "SMP bookstore needs this shipping and country marquee added under Over 300
// titles by Kingdom Messengers..."): the offer line + country marquee under the tagline, the shared FHB component and
// wording as on the SMP homepage. Count + names = the LIVE ship list from the store engine, never retyped; A-Z.
const shipOfferLine = `15% off first order + free standard shipping to ${LIVE_COUNTRIES.length} countries`;
const shipNames = LIVE_COUNTRIES.map((c) => c.name).sort((a, b) => a.localeCompare(b, 'en'));

// pale covers that blend into the white card: src/data/books/light-covers.json (title patterns + exact titles), each
// with its style: 'underline' (default, the line under the cover) or 'full' (1px frame on all four sides of the image)
const LIGHT_PATTERNS = (lightCovers as any).patterns.map((x: any) => ({
	re: new RegExp(x.pattern, 'i'),
	frame: x.frame || 'underline',
}));
const LIGHT_TITLES = new Map<string, string>(
	(lightCovers as any).titles.map((t: any) => [norm(t.title), t.frame || 'underline']),
);
const coverFrameOf = (b: any): string | undefined => {
	for (const t of [b.title, b.display_title].filter(Boolean)) {
		const exact = LIGHT_TITLES.get(norm(t));
		if (exact) return exact;
		const pat = LIGHT_PATTERNS.find((x: any) => x.re.test(t));
		if (pat) return pat.frame;
	}
	return undefined;
};
for (const b of rawBooks as any[]) {
	const f = coverFrameOf(b);
	if (f) b.coverFrame = f;
}
// the SSR card and the script's redraw use the same classes (keep in sync with render() below)
const COVER_BOX_UNDERLINE = ' border-b border-[#adacab]';
const IMG_CLASS =
	'w-full h-full object-contain group-hover:scale-105 transition-transform duration-300';
const IMG_CLASS_FRAMED =
	'block h-full w-auto max-w-full mx-auto border border-[#adacab] object-contain group-hover:scale-105 transition-transform duration-300';
const BOOKS_JSON = JSON.stringify(rawBooks);
// 3au (pmseoaeo 2026-11-13): the stats strip's numbers are computed HERE, at build, from the same rawBooks the
// browser script reads, and written into the served HTML; no-JS crawlers and AI readers used to see "0 Published
// Titles". The script animates up to these same values on scroll (one computation, not two).
// "Published Titles" counts EVERY FORMAT EDITION (Kevin 2026-08-28); Kingdom Messengers = PEOPLE (co-authors split,
// Spirit Media itself and name suffixes like "Jr." dropped); years counted from June 2022.
const STAT_PUBLISHER = /^spirit media(\s+publishing)?$/i;
const STAT_SUFFIX = /^(jr|sr|ii|iii|iv|v|md|phd|dds|esq)\.?$/i;
const STAT_TITLES = rawBooks.reduce(
	(sum: number, b: any) =>
		sum + Object.values(b.formatsAll || b.formats || {}).filter((v) => v).length,
	0,
);
const STAT_AUTHORS = new Set(
	rawBooks.flatMap((b: any) =>
		String(b.author || '')
			.split(/,| and /i)
			.map((n: string) => n.trim())
			.filter((n: string) => n && !STAT_PUBLISHER.test(n) && !STAT_SUFFIX.test(n)),
	),
).size;
const statYearsNow = new Date();
const STAT_YEARS = statYearsNow.getFullYear() - 2022 - (statYearsNow.getMonth() < 5 ? 1 : 0);

// INDEXING (SMP indexing brief, Kevin 2026-10-19). The grid was drawn only by the script below,
// so every collection page's HTML was the same empty shell (91-98% identical) and the chips were
// <button>s, so nothing linked the collection pages. Now each chip is a real link to its page
// (the collection key is its slug, as bookstore/[collection].astro builds it) and the page's first view is in the HTML.
// The script still filters in place and redraws the grid with its full cards on load.
const collectionHref = (c: string) => (c ? `/bookstore/${c}/` : '/bookstore/');
const initialBooks = rawBooks
	.filter((b: any) => !initialCollection || b.colls.includes(initialCollection))
	.sort((x: any, y: any) =>
		initialCollection === 'smp' ? liveFirst(x, y) || byDate(x, y) : byDate(x, y),
	);
const introRendered = introHtml.replaceAll('{n}', String(initialBooks.length));
// 2uv (CLS): the client script redraws the grid with date labels + format badges; the SSR cards
// lacked them, so every card grew on load (desktop CLS 0.73). These helpers MIRROR the script's
// renderFormats()/date label/coverBorder so the SSR card is byte-for-byte the same height. Keep in sync.
const FMT_LABELS: Record<string, string> = {
	paperback: 'Paperback',
	hardback: 'Hardback',
	ebook: 'eBook',
	audiobook: 'Audiobook',
	audio: 'Audiobook',
	pdf: 'PDF',
};
const FMT_STYLES: Record<string, string> = {
	paperback: 'background:#fde8e8;color:#c0392b;border:1px solid #f5c6c6;',
	hardback: 'background:#e8edf5;color:#2c3e6b;border:1px solid #c5cfe8;',
	ebook: 'background:#e6f4f1;color:#1a7a65;border:1px solid #b8dfd8;',
	audiobook: 'background:#fef3e2;color:#92640a;border:1px solid #f5d99e;',
	audio: 'background:#fef3e2;color:#92640a;border:1px solid #f5d99e;',
	pdf: 'background:#f0eeeb;color:#5a5248;border:1px solid #d8d2cb;',
};
const badgeStyle =
	'display:inline-block;font-size:0.6rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;padding:3px 7px;border-radius:4px;text-decoration:none;';
const formatsHtml = (b: any): string => {
	const fmts = b.formats || {};
	// 3aj: a format may be a URL or a bare flag (true) — a flag links to the book's own listing,
	// never to href="true" (was a 404 on SOAR To Success). No URL to give = no badge.
	const fmtHref = (k: string) =>
		typeof fmts[k] === 'string' ? fmts[k] : fmts[k] === true && b.amazon ? b.amazon : '';
	const keys = Object.keys(fmts).filter((k) => FMT_LABELS[k] && fmtHref(k));
	if (!keys.length) {
		if (!b.amazon) return '';
		const asin = (b.amazon.match(/\/dp\/([A-Z0-9]+)/) || [])[1] || '';
		const isEbook = asin.startsWith('B');
		const k = isEbook ? 'ebook' : 'paperback';
		return `<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;"><a href="${b.amazon}" target="_blank" rel="noopener noreferrer" style="${badgeStyle}${FMT_STYLES[k]}" onclick="event.stopPropagation()">${isEbook ? 'eBook' : 'Paperback'}</a></div>`;
	}
	const badges = keys
		.map(
			(k) =>
				`<a href="${fmtHref(k)}"${fmtHref(k).startsWith('/') ? '' : ' target="_blank" rel="noopener noreferrer"'} style="${badgeStyle}${FMT_STYLES[k]}" onclick="event.stopPropagation()">${FMT_LABELS[k]}</a>`,
		)
		.join('');
	return `<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;">${badges}</div>`;
};
const dateLabelOf = (b: any) =>
	b.date
		? new Date(b.date + 'T12:00:00').toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			})
		: '';
// ItemList JSON-LD (unit 2qm): built from rawBooks, the SAME array that draws the cards, so
// numberOfItems == itemListElement length == books shown. Index page only (collection pages
// show a subset).
// 2vh: structured data only. Split combined author strings into separate entries; the publisher
// is an Organization, not a Person. A part with no surname ("Julie and Mark Boone") is ambiguous:
// the whole string is left exactly as-is rather than inventing a name.
// 2xz: every item is a Book (author Person/Organization, publisher = the site's Organization @id,
// image, datePublished, url). `isbn` and `offers` appear ONLY where the data holds them: Sanity
// book documents carry neither an ISBN nor a price, so the ~140 Sanity-only titles stay without
// them; the FHB editions (read from the FHB repo's edition data, see deriveFhbEditions) carry the
// ISBN of the binding they name and that binding's catalog price. Nothing is invented.
const authorLd = (raw: string) => {
	const one = (n: string) =>
		/^Spirit Media( Publishing)?$/.test(n)
			? { '@type': 'Organization', name: n }
			: { '@type': 'Person', name: n };
	const parts = raw
		.split(/\s+(?:and|&)\s+|,\s+(?!(?:Jr|Sr)\.?$|I{2,3}$|IV$)/)
		.map((x) => x.trim())
		.filter(Boolean);
	if (parts.length < 2 || parts.some((x) => !/\s/.test(x))) return one(raw);
	return parts.map(one);
};
const bookLd = (b: any) => ({
	'@type': 'Book',
	name: b.display_title || b.title,
	...(b.author ? { author: authorLd(b.author) } : {}),
	publisher: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
	},
	...(b.date && /^\d{4}-\d{2}-\d{2}$/.test(b.date) ? { datePublished: b.date } : {}),
	...(b.img ? { image: b.img } : {}),
	...(b.amazon ? { url: b.amazon } : {}),
	...(b.isbn ? { isbn: b.isbn } : {}),
	...(b.binding
		? {
				bookFormat:
					b.binding === 'hb' ? 'https://schema.org/Hardcover' : 'https://schema.org/Paperback',
			}
		: {}),
	...(b.price && b.amazon
		? {
				offers: {
					'@type': 'Offer',
					price: Number(b.price).toFixed(2),
					priceCurrency: 'USD',
					availability: 'https://schema.org/InStock',
					itemCondition: 'https://schema.org/NewCondition',
					url: b.amazon,
				},
			}
		: {}),
});
const itemListLd =
	initialCollection === ''
		? JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'ItemList',
				name: 'Spirit Media Christian Bookstore',
				url: 'https://spiritmediapublishing.com/bookstore/',
				numberOfItems: initialBooks.length,
				itemListElement: initialBooks.map((b: any, i: number) => ({
					'@type': 'ListItem',
					position: i + 1,
					item: bookLd(b),
				})),
			})
		: '';
// the BookCard props for one card (the /bookstore/ grid and the homepage section share them)
const cardProps = (b: any) => ({
	b,
	dataKey: norm(b.title),
	coverBoxClass: `aspect-[2/3] overflow-hidden bg-stone-100${b.coverFrame === 'underline' ? COVER_BOX_UNDERLINE : ''}`,
	imgClass: b.coverFrame === 'full' ? IMG_CLASS_FRAMED : IMG_CLASS,
	dateLabel: dateLabelOf(b),
	formatsHtml: formatsHtml(b),
});
const cardsOnly = cardsOnlyHrefs
	? cardsOnlyHrefs.map((href) => (rawBooks as any[]).find((b) => b.amazon === href)).filter(Boolean)
	: null;
---

{cardsOnly ? (
<ul class="grid grid-cols-2 gap-5 sm:grid-cols-4" data-home-cards>
